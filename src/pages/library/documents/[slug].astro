---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DocumentReader from "../../../components/DocumentReader.astro";
import { publicDocumentItems } from "../../../data/documents";
import VolumeOneSourceMap from "../../../components/VolumeOneSourceMap.astro";

export function getStaticPaths() {
  return publicDocumentItems.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const searchTitles: Record<string, string> = {
  "who-deported-more": "Who Deported More? Comparing Immigration Enforcement",
  "latino-irony": "The Latino Irony: Hispanic Support for Trump",
  "wardhan-tax-doctrine": "The Wardhan Tax Doctrine: Time and Tax Relief",
  "disconnected-hearts": "Disconnected Hearts: Technology and Intimacy",
  "double-tax-on-time": "The Double Tax on Time",
};
const currentPath = `/library/documents/${entry.id}/`;
const documentIndex = publicDocumentItems.findIndex((candidate) => candidate.id === entry.id);
---

<BaseLayout
  title={searchTitles[entry.id] ?? entry.title}
  description={entry.description}
  currentPath={currentPath}
  articleMetadata={{
    author: entry.author ?? "Independent Observer",
    publicationDate: entry.publicationDate,
    status: entry.status,
    sameAs: entry.researchGateUrl,
    fingerprintSha256: entry.sourceFingerprintSha256,
    rightsNotice: entry.rightsNotice,
  }}
>
  <DocumentReader
    entry={entry}
    relatedEntries={publicDocumentItems}
    previous={documentIndex > 0 ? publicDocumentItems[documentIndex - 1] : undefined}
    next={documentIndex < publicDocumentItems.length - 1
      ? publicDocumentItems[documentIndex + 1]
      : undefined}
  />
  {entry.id === "independent-observer-volume-one" && <VolumeOneSourceMap compact />}
</BaseLayout>
