---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FollowUpdates from "../../../components/FollowUpdates.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { manuscripts, manuscriptPath } from "../../../../plugins/library-content/manuscripts";
import { isManuscriptAuthorizedForRelease } from "../../../data/manuscript-release-registry";
import { relatedRecords } from "../../../lib/related";
import { sitePath } from "../../../lib/paths";
export function getStaticPaths() {
  return manuscripts.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const contents = entry.blocks
  .map((block, index) => ({ ...block, index }))
  .filter((block) => block.kind === "heading");
const released = isManuscriptAuthorizedForRelease(entry.slug);
const related = relatedRecords(
  {
    id: entry.slug,
    title: entry.title,
    description: entry.summary,
    category: "Full working paper",
    href: sitePath(manuscriptPath(entry)),
    status: entry.status,
    topics: entry.topics,
    familyId: entry.familyId,
    volume: entry.volume,
  },
  manuscripts.map((candidate) => ({
    id: candidate.slug,
    title: candidate.title,
    description: candidate.summary,
    category: "Full working paper",
    href: sitePath(manuscriptPath(candidate)),
    status: candidate.status,
    topics: candidate.topics,
    familyId: candidate.familyId,
    volume: candidate.volume,
  })),
  3,
).map((item) => ({
  ...item,
  connection: (item.topics ?? []).some((topic) => entry.topics.includes(topic))
    ? `Shares a topic with ${entry.title}; read on its own sources before drawing a connection.`
    : `Another full-text Independent Observer manuscript in ${item.volume}.`,
}));
---

<BaseLayout
  title={entry.title}
  description={entry.summary}
  currentPath={manuscriptPath(entry)}
  noindex={!released}
  articleMetadata={{
    title: entry.title,
    author: entry.author,
    publicationDate: entry.sourceDate,
    status: entry.status,
    keywords: [entry.volume, `Version ${entry.version}`, ...entry.topics],
    fingerprintSha256: entry.sourceTextSha256,
  }}
>
  <article
    class="shell manuscript"
    data-manuscript-reader
    data-reader-id={entry.slug}
    data-reader-title={entry.title}
  >
    <p>
      <a href={sitePath("/library/taxonomy/#" + entry.taxonomyId)}
        >Back to the four-volume research map</a
      >
    </p>
    <header>
      <p>{entry.volume} · {entry.status}</p>
      <h1>{entry.title}</h1><p class="subtitle">{entry.subtitle}</p>
      <p>By {entry.author} · Version {entry.version} · {entry.sourceDate}</p>
      {entry.frontMatter.map((line) => <p>{line}</p>)}
      <p class="edition">{entry.editionNote}</p>
    </header>
    <nav aria-label="Manuscript contents">
      <h2>Contents</h2><ol>
        {
          contents.map((section) => (
            <li>
              <a href={"#section-" + section.index}>{section.text}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="manuscript-text">
      {
        entry.blocks.map((block, index) =>
          block.kind === "heading" ? (
            <h2 id={"section-" + index}>{block.text}</h2>
          ) : (
            <p>{block.text}</p>
          ),
        )
      }
    </div>
    <footer>
      <p>
        <a href={sitePath("/library/taxonomy/#" + entry.taxonomyId)}>Return to the research map</a>
      </p>
    </footer>
  </article>
  <RelatedContent records={related} title="Continue this inquiry" />
  <div class="shell"><FollowUpdates id="manuscript-follow-updates" /></div>
</BaseLayout>
<script>
  import { initArticleTracking } from "../../../lib/analytics";
  import { recordLastArticle } from "../../../lib/reading-history";

  document.querySelectorAll<HTMLElement>("[data-manuscript-reader]").forEach((reader) => {
    const id = reader.dataset.readerId ?? "manuscript";
    initArticleTracking(id, "manuscript");
    recordLastArticle(id, reader.dataset.readerTitle ?? id, window.location.pathname);
  });
</script>
<style>
  .manuscript {
    max-width: 78ch;
    padding-block: 2rem 5rem;
    overflow-wrap: anywhere;
  }
  h1 {
    line-height: 1.15;
    font-size: clamp(2rem, 5vw, 3.4rem);
  }
  .subtitle {
    font-size: 1.3rem;
  }
  .edition {
    padding: 1rem;
    border-left: 3px solid currentColor;
  }
  nav {
    margin-block: 2rem;
    padding: 1rem;
    background: var(--surface-soft, #eeeae1);
  }
  .manuscript-text {
    font-size: 1.1rem;
    line-height: 1.8;
  }
  .manuscript-text h2 {
    margin-top: 2.5rem;
    scroll-margin-top: 16rem;
  }
  footer {
    margin-top: 3rem;
  }
  @media print {
    nav {
      display: none;
    }
    .manuscript {
      max-width: none;
      padding: 0;
    }
    .manuscript-text {
      font-size: 11pt;
    }
  }
</style>
