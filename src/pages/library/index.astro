---
import ReadingToolsInvitation from "../../components/ReadingToolsInvitation.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LibraryContentBlocks from "../../components/LibraryContentBlocks.astro";
import LibraryResearchShelf from "../../components/LibraryResearchShelf.astro";
import PageHero from "../../components/PageHero.astro";
import { publicDocumentItems } from "../../data/documents";
import { publicLibrarySnapshot } from "../../data/public-library";
import { sitePath } from "../../lib/paths";
import GreenPublicationShelf from "../../components/GreenPublicationShelf.astro";

const { areas, note, stats } = publicLibrarySnapshot;
---

<BaseLayout
  title="Public Research Library"
  description="Find working-paper summaries on power, work, evidence and technology. Browse by question or volume, then follow the sources and limitations."
  currentPath="/library/"
>
  <PageHero
    className="discovery-hero"
    eyebrow="Public archive"
    title="Find your next useful read."
    description="The complete public catalogue of papers and records. Search paper summaries on power, work, evidence and technology. Each record identifies its sources, limitations and publication status."
  />

  <section class="shell" aria-labelledby="taxonomy-invitation">
    <h2 id="taxonomy-invitation">Explore the complete research map</h2><p>
      Browse the four volumes by subject and manuscript, with summaries and links to available
      reading records.
    </p><p>
      <a class="button button-secondary" href={sitePath("/library/taxonomy/")}
        >Open the four volume taxonomy</a
      >
    </p>
  </section>
  <LibraryResearchShelf />
  <ReadingToolsInvitation />
  <section class="library-background" aria-labelledby="library-background-title">
    <div class="shell">
      <div class="library-background-heading">
        <p class="eyebrow">Catalogue context</p>
        <h2 id="library-background-title">Previews, volume guides and publication boundaries.</h2>
        <p>
          These reader-facing records are public. Their status labels, limitations, and release
          boundaries remain visible alongside the catalogue.
        </p>
      </div>
    </div>
    <GreenPublicationShelf title="Research previews" />
    <section class="section section-rule" aria-labelledby="library-review-boundaries-title">
      <div class="shell page-grid">
        <aside class="page-aside">Editorial status</aside><div class="prose">
          <h2 id="library-review-boundaries-title">Historical records remain distinguishable.</h2>
          <p>
            Some older public records remain available for historical continuity but are not current
            Green publications. Empire of Distraction and When the Storm Decides remain methodology
            holds; From Vietnam to Terry v. Ohio requires source-audit rebuilding; Wardhan Tax
            Doctrine has competing full-text versions; and Who Deported More? A Guide to Comparing
            Deportation Statistics is a public paper record whose newer manuscript remains in
            editorial development.
          </p>
          <p>
            These labels preserve links without silently substituting newer working-archive
            material. The six research previews above are the principal preview layer.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-rule" aria-labelledby="library-scope-title">
      <div class="shell page-grid">
        <aside class="page-aside">Editorial scope</aside>
        <div class="prose">
          <h2 id="library-scope-title">Volume II: make power legible.</h2>
          <p>
            Volume II, <em>The Empire Beneath Democracy</em>, is the power inquiry in this library.
            It studies how authority works beneath formal democratic language: who sets an agenda,
            whose membership is recognized, who is exposed to enforcement, and how capital,
            technology, security, labor, markets, and alliances shape practical sovereignty.
          </p>
          <div class="library-method-callout">
            <p class="library-block-label">Volume II research method</p>
            <ol class="library-method-steps">
              <li>
                Define the population, legal category, period, and outcome before comparing claims.
              </li>
              <li>
                Follow the mechanism through rules, records, incentives, enforcement, and capacity.
              </li>
              <li>
                Compare public indicators without turning a correlation or headline into a cause.
              </li>
              <li>Keep interpretation, policy options, uncertainty, and release status visible.</li>
            </ol>
          </div>
          <p>
            The public archive links matched author paper pages and, where a matching public record
            exists, ResearchGate. These are author-paper catalogue entries with selected synopses;
            they are not a claim of peer review, a complete manuscript, or a mirror of private
            working files. The Volume II shelf below describes what each paper contributes and why
            it belongs in the power inquiry.
          </p>
          <p>
            The other volumes remain connected: Volume I develops observation and method; Volume III
            follows work, welfare, taxation, and social citizenship; and Volume IV examines science,
            technology, AI, and human capability. This site is for academic discussion grounded in
            references and identifiable sources, and it excludes unsupported factual claims,
            conspiracy framing, and material that promotes or sensationalizes violence or harm.
          </p>
          <p>
            <a class="button button-secondary button-on-light" href="#research-volume-ii">
              Explore Volume II’s research shelf →
            </a>
          </p>
        </div>
      </div>
    </section>

    <section class="section section-white">
      <div class="shell page-grid">
        <aside class="page-aside">{publicLibrarySnapshot.label}</aside>
        <div class="prose">
          <h2>Visibility with a boundary.</h2>
          <p>{note}</p>
          <p>
            This page is a public index, not a document repository. It helps readers understand what
            the project is building and where future research may fit.
          </p>
          <div class="topics-grid">
            {
              stats.map((stat, index) => (
                <article class="topic">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <h3>{stat.value}</h3>
                  <p>
                    <strong>{stat.label}</strong>
                  </p>
                  <p>{stat.detail}</p>
                  {stat.label === "Public volume summaries" && (
                    <a class="library-stat-link" href="#public-volume-content">
                      Explore the four-volume map →
                    </a>
                  )}
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <LibraryContentBlocks />

    <section class="section section-white">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Public documents</p>
            <h2>Read the reviewed material.</h2>
          </div>
          <p>
            These reading copies make approved public-safe material easy to find without opening the
            private working archive to the web.
          </p>
        </div>
        <div class="card-grid">
          {
            publicDocumentItems.map((entry, index) => (
              <article class="editorial-card">
                <div class="card-meta">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span>{entry.category}</span>
                </div>
                <h3>
                  <a class="card-title-link" href={sitePath(`/library/documents/${entry.id}/`)}>
                    {entry.title}
                  </a>
                </h3>
                <p>{entry.description}</p>
                <div class="card-footer">
                  <span class="status-pill">{entry.status ?? "Reviewed public copy"}</span>
                  {entry.metrics && (
                    <span>
                      Archived snapshot: {entry.metrics.downloads ?? "—"} downloads ·{" "}
                      {entry.metrics.abstractViews ?? "—"} views · checked {entry.metrics.checkedAt}
                    </span>
                  )}
                  <a class="card-open-link" href={sitePath(`/library/documents/${entry.id}/`)}>
                    Read {entry.title} →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-rule">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Catalogue map</p>
            <h2>Research areas, organized for readers.</h2>
          </div>
          <p>
            These broad categories show how the public catalogue is organized and where to begin a
            reading path.
          </p>
        </div>
        <div class="topics-grid">
          {
            areas.map((area, index) => (
              <article class="topic">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{area.title}</h3>
                <p>{area.summary}</p>
                <p>
                  <strong>{area.privateCount}</strong>
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-white">
      <div class="shell page-grid">
        <aside class="page-aside">Publication boundary</aside>
        <div class="prose">
          <h2>What remains private.</h2>
          <p>
            Raw DOCX, PDF, presentation, video, private notes, local file paths, personal records,
            draft evidence, and unpublished claims do not appear in this public catalogue. Records
            published here identify their current status and reader-facing limits.
          </p>
          <div class="principles">
            <div class="principle">
              <span>01</span><div>
                <h3>The working archive stays private</h3><p>
                  The website provides selected public reference versions; it does not mirror
                  private source material.
                </p>
              </div>
            </div>
            <div class="principle">
              <span>02</span><div>
                <h3>Clear publication status</h3><p>
                  Each public record distinguishes a working paper, concept preview, or book in
                  editorial development.
                </p>
              </div>
            </div>
            <div class="principle">
              <span>03</span><div>
                <h3>Sources and limitations</h3><p>
                  Read each record alongside its evidence and limitations. A public preview does not
                  establish peer-reviewed publication status.
                </p>
              </div>
            </div>
          </div>
          <p>
            <a href={sitePath("/about/")}>Read the editorial principles</a> or
            <a href={sitePath("/research/")}>explore the author’s research</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-navy">
      <div class="shell newsletter">
        <div>
          <p class="eyebrow">Public catalogue</p>
          <h2>Find a record or suggest a correction.</h2>
          <p>
            The catalogue brings together public reference versions, author-paper summaries, and
            research maps. It is not a live mirror of private research material.
          </p>
        </div>
        <div class="contact-panel">
          <h2>Help keep the record clear</h2>
          <p>
            Use the contact page to flag a correction, ask about a public record, or share a source
            that may be relevant. A listing appears when a reader-facing reference version is
            available.
          </p>
          <a class="button" href={sitePath("/contact/")}>Contact the project</a>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .library-background {
    margin-block: 24px;
  }
  .library-background-heading {
    padding: 1.25rem 0;
  }
  .library-background-heading > :last-child {
    max-width: 68ch;
  }
</style>
