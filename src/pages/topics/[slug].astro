---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { topicHubs } from "../../data/topics";
import { sitePath } from "../../lib/paths";

export function getStaticPaths() {
  return topicHubs.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
---

<BaseLayout
  title={`${topic.name} topic hub`}
  description={topic.description}
  currentPath={`/topics/${topic.slug}/`}
>
  <PageHero eyebrow="Topic hub" title={topic.name} description={topic.description} />
  <section class="section section-white">
    <div class="shell">
      <div class="topic-hub-status">
        <span class="status-pill">Public discovery map</span>
        <h2>No released article is currently available in this field.</h2>
        <p>
          These links are clearly labeled previews or roadmap notes. The site does not manufacture a
          finished article to fill a category.
        </p>
      </div>
      <div class="card-grid topic-hub-grid">
        {
          topic.related.map((item, index) => (
            <article class="editorial-card">
              <div class="card-meta">
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span>{item.type}</span>
                </>
              </div>
              <h3>
                <a class="card-title-link" href={item.href}>
                  {item.title}
                </a>
              </h3>
              <p class="card-category">{item.category}</p>
              <p>{item.description}</p>
              <div class="card-footer">
                <>
                  <span class="status-pill">{item.status}</span>
                  <a class="card-open-link" href={item.href}>
                    Open preview →
                  </a>
                </>
              </div>
            </article>
          ))
        }
      </div>
      <div class="detail-actions">
        <a class="button" href={sitePath("/start/")}>Start with a guided path →</a><a
          class="button button-secondary button-on-light"
          href={sitePath("/topics/")}>All topic hubs</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
