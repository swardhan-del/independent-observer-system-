---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FollowUpdates from "../../components/FollowUpdates.astro";
import PageHero from "../../components/PageHero.astro";
import TopicReviewQueue from "../../components/TopicReviewQueue.astro";
import {
  reviewQueueForTopic,
  topicPluginFor,
  topicVolumeConnectionFor,
} from "../../../plugins/topic-discovery/catalog";
import { taxonomyEntries } from "../../../plugins/library-content/taxonomy";
import { topicHubs } from "../../data/topics";
import { sitePath } from "../../lib/paths";
import GreenPublicationShelf from "../../components/GreenPublicationShelf.astro";

export function getStaticPaths() {
  return topicHubs.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const plugin = topicPluginFor(topic.slug);
const reviewSignals = reviewQueueForTopic(topic.slug);
const researchVolumes = ["Volume I", "Volume II", "Volume III", "Volume IV"];
const scienceEntries = taxonomyEntries.filter(
  (entry) =>
    entry.volume === "Volume IV" ||
    (entry.volume === "Volume III" && entry.branch === "Labor education health and human capital"),
);
const scienceBranches = [...new Set(scienceEntries.map((entry) => entry.branch))];
const publicOutputItems = topic.related.filter(
  (item) => item.type === "Author paper" || item.type.includes("preview"),
);
const mappedVolumes = researchVolumes.filter(
  (volume) => topicVolumeConnectionFor(volume, topic.slug).connected,
);
const mappedVolumeSummary =
  mappedVolumes.length > 1
    ? `${mappedVolumes.slice(0, -1).join(", ")}, and ${mappedVolumes[mappedVolumes.length - 1]}`
    : (mappedVolumes[0] ?? "");
---

<BaseLayout
  title={topic.name + " topic hub"}
  description={topic.description}
  currentPath={"/topics/" + topic.slug + "/"}
>
  <PageHero eyebrow="Topic hub" title={topic.name} description={topic.description} />
  {
    ["technology", "economics", "science"].includes(topic.slug) && (
      <section class="section section-white">
        <div class="shell prose">
          <>
            <h2>AI, work and infrastructure</h2>
            <p>
              Read three connected analyses of computing’s physical demands and changing work, with
              sources and clear limits.
            </p>
            <a class="button" href={sitePath("/collections/ai-work-and-infrastructure/")}>
              Open the reading collection →
            </a>
          </>
        </div>
      </section>
    )
  }
  <section class="section section-white" aria-labelledby={`${topic.slug}-catalogue`}>
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{topic.name} across the research spine</p>
          <h2 id={`${topic.slug}-catalogue`}>{topic.name} research catalogue</h2>
        </div>
        <p>
          Browse the four-volume connections and mapped research directions. A catalogue entry is
          not a release; only the linked public reading records and previews are available.
        </p>
      </div>
      <div
        class="topic-matrix-wrap"
        tabindex="0"
        aria-label={`Scrollable ${topic.name.toLowerCase()} volume table`}
      >
        <table class="topic-matrix">
          <caption>{topic.name} connections across all four volumes</caption>
          <thead>
            <tr>
              <th scope="col">Volume</th>
              <th scope="col">Research lens</th>
              <th scope="col">Public entry points</th>
            </tr>
          </thead>
          <tbody>
            {
              researchVolumes.map((volume) => {
                const cell = topicVolumeConnectionFor(volume, topic.slug);
                return (
                  <tr>
                    <th scope="row">{volume}</th>
                    <td>{cell.lens}</td>
                    <td>
                      <ul>
                        {cell.contentLinks.map((link) => (
                          <li>
                            <a href={sitePath(link.path)}>{link.label}</a> ({link.kind})
                          </li>
                        ))}
                      </ul>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      {
        topic.slug === "science" && (
          <>
            <h3>Research directions by subject</h3>
            {scienceBranches.map((branch) => (
              <section>
                <h4>{branch}</h4>
                <ul>
                  {scienceEntries
                    .filter((entry) => entry.branch === branch)
                    .map((entry) => (
                      <li>
                        <a href={sitePath(entry.href ?? "/library/taxonomy/#" + entry.id)}>
                          {entry.title}
                        </a>{" "}
                        · {entry.volume} · {entry.status}
                      </li>
                    ))}
                </ul>
              </section>
            ))}
          </>
        )
      }
      <p>
        <a href={sitePath("/library/taxonomy/")}>Explore the full public research map →</a>
      </p>
      <p>
        <a href={sitePath("/reading-tools/")}>Explore interactive evidence and measurement tools →</a>
      </p>
      <p>
        <a href={sitePath("/topics/")}>Return to the six-field relationship matrix →</a>
      </p>
    </div>
  </section>
  <section class="section section-white">
    <div class="shell">
      <div class="topic-hub-status">
        <span class="status-pill">Public discovery map</span>
        <h2>{plugin.question}</h2>
        <p>{plugin.method}</p>
        {topic.reviewIntro && <p>{topic.reviewIntro}</p>}
        <p>
          Start with a working-paper summary or a project preview. Each link explains what is
          available and what remains in development.
        </p>
        {
          publicOutputItems.length > 0 && (
            <div class="topic-hub-outputs">
              <div class="topic-hub-outputs-heading">
                <div>
                  <p class="topic-hub-output-label">Public outputs in this map</p>
                  <h3>Open the work that is available now.</h3>
                </div>
                <p class="topic-hub-output-context">
                  {mappedVolumes.length > 0
                    ? `Mapped to ${mappedVolumeSummary} in the four-volume spine.`
                    : "Connected to the four-volume research spine."}
                </p>
              </div>
              <ul class="topic-hub-output-list" aria-label={topic.name + " public outputs"}>
                {publicOutputItems.map((item) => (
                  <li>
                    <a href={item.href}>
                      <span>
                        {item.type}
                        {item.volume ? ` · ${item.volume}` : ""}
                      </span>
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
              <a class="topic-hub-output-catalogue" href={sitePath("/research/")}>
                Browse the full research catalogue →
              </a>
            </div>
          )
        }
      </div>
      <div class="card-grid topic-hub-grid">
        {
          topic.related.map((item, index) => (
            <article class="editorial-card topic-related-card">
              <div class="card-meta">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span>{item.type}</span>
              </div>
              <h3>
                <a class="card-title-link" href={item.href}>
                  {item.title}
                </a>
              </h3>
              <p class="card-category">{item.category}</p>
              <p>{item.description}</p>
              <div class="card-footer">
                <>
                  <span class="status-pill">{item.status}</span>
                  <a class="card-open-link" href={item.href}>
                    {item.type === "Author paper" ? "Open reading copy →" : "Open preview →"}
                  </a>
                </>
              </div>
            </article>
          ))
        }
      </div>
      <div class="detail-actions">
        <a class="button" href={sitePath("/start/")}>Choose another path →</a>
        <a class="button button-secondary button-on-light" href={sitePath("/topics/")}>
          All topic hubs
        </a>
      </div>
    </div>
  </section>
  <GreenPublicationShelf topic={topic.name} title={`${topic.name}: research previews`} />
  <TopicReviewQueue signals={reviewSignals} title={"In development: " + topic.name} />
  <div class="shell"><FollowUpdates id={`topic-follow-updates-${topic.slug}`} /></div>
</BaseLayout>
