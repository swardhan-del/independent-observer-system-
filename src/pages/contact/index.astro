---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";

const contactAddress = "swardhan1@icloud.com";
---

<BaseLayout
  title="Contact"
  description="Send a respectful inquiry about Independent Observer volumes, research, and public publications."
  currentPath="/contact/"
>
  <PageHero
    eyebrow="Contact"
    title="Questions, evidence and constructive objections."
    description="Use the inquiry form for questions about the four volumes, research, public reading copies, or publications. It opens a draft in your mail app; sending is your choice, and an inquiry does not guarantee a reply."
  />
  <section class="section section-white" aria-labelledby="contact-inquiry-title">
    <div class="shell page-grid">
      <div class="prose">
        <h2 id="contact-inquiry-title">Send an inquiry</h2>
        <p>
          The author can receive questions at <a href={`mailto:${contactAddress}`}
            >{contactAddress}</a
          >. Please keep messages relevant to Independent Observer volumes, research, public
          records, corrections, rights, or publication questions.
        </p>
        <p>
          The form does not send through this website. It prepares a message in your own mail
          application so you can review it before sending. The site does not collect, store, or
          forward the form contents.
        </p>
        <h3>What can be discussed</h3>
        <ul>
          <li>
            Which claim needs stronger evidence? Include the page, passage and a source we can
            check.
          </li>
          <li>
            What alternative explanation, counterexample or missing distinction should be
            considered?
          </li>
          <li>Questions about a public reading copy, source link, status label, or correction.</li>
          <li>Publication, documentary, rights, and research-method questions.</li>
        </ul>
        <p>
          Please do not include sensitive personal information. Evidence-based disagreement is
          welcome. Keep criticism focused on claims and sources; threats, harassment and defamatory
          allegations are not accepted.
        </p>
      </div>
      <aside class="contact-panel contact-panel-open" aria-labelledby="contact-form-title">
        <p class="contact-panel-kicker">Inquiry channel</p>
        <h2 id="contact-form-title">Write to the research desk.</h2>
        <p>
          Recipient: <a href={`mailto:${contactAddress}`}>{contactAddress}</a>. Review the draft in
          your mail app before sending.
        </p>
        <form
          class="contact-inquiry-form"
          action={`mailto:${contactAddress}`}
          method="post"
          enctype="text/plain"
          data-contact-inquiry-form
        >
          <label for="contact-name">
            Name <span>(optional)</span>
            <input id="contact-name" name="name" type="text" autocomplete="name" />
          </label>
          <label for="contact-email">
            Reply email <span>(optional; your mail app supplies a sender)</span>
            <input id="contact-email" name="email" type="email" autocomplete="email" />
          </label>
          <label for="contact-topic">
            Inquiry about
            <select id="contact-topic" name="topic" required>
              <option value="">Select a topic</option>
              <option>Volume I · observation and method</option>
              <option>Volume II · institutions and power</option>
              <option>Volume III · work and social citizenship</option>
              <option>Volume IV · science and capability</option>
              <option>Public reading copy or correction</option>
              <option>Publication, documentary, or rights question</option>
              <option>Other Independent Observer question</option>
            </select>
          </label>
          <label for="contact-message">
            Message
            <textarea
              id="contact-message"
              name="message"
              minlength="10"
              required
              placeholder="What would you like to ask?"></textarea>
          </label>
          <label class="contact-disclosure" for="contact-disclosure">
            <input id="contact-disclosure" name="disclosure" type="checkbox" required />
            <span>
              I confirm that this inquiry is respectful and relevant. It contains no threats,
              harassment, profanity, defamatory, libelous, or slanderous content, and no sensitive
              personal data.
            </span>
          </label>
          <div class="contact-actions">
            <button class="button button-on-light" type="submit">Prepare email draft →</button>
            <button class="button button-secondary button-on-light" type="button" data-copy-message
              >Copy message</button
            >
            <button class="button button-secondary button-on-light" type="button" data-copy-address
              >Copy email address</button
            >
          </div>
          <p class="form-note">
            No mail app? Copy the message and address into your webmail. Nothing is sent by these
            buttons.
          </p>
          <label hidden data-copy-fallback-label for="contact-copy-fallback"
            >Select and copy this text
            <textarea id="contact-copy-fallback" readonly></textarea>
          </label>
          <p class="contact-inquiry-status" data-contact-inquiry-status aria-live="polite"></p>
          <p class="contact-privacy-note">
            Nothing is stored by this site. Your mail provider handles any message after you choose
            to send it. An inquiry does not guarantee a response.
          </p>
        </form>
      </aside>
    </div>
  </section>
  <section class="section section-rule" aria-labelledby="contact-discussion-title">
    <div class="shell page-grid">
      <aside class="page-aside">Questions and discussion</aside>
      <div class="prose">
        <h2 id="contact-discussion-title">A small public Q&amp;A.</h2>
        <p>
          This page provides a private, user-initiated mail draft rather than a public comment
          forum. A moderated question-and-answer or discussion space may be considered later after
          its privacy, moderation, and response rules are ready.
        </p>
        <div class="contact-faq">
          <details open>
            <summary>What kinds of questions are useful?</summary>
            <p>
              Questions about a volume, research direction, public reading copy, source boundary,
              correction, documentary concept, or publication status are the best fit.
            </p>
          </details>
          <details>
            <summary>Will every message receive a reply?</summary>
            <p>
              No. The form makes an inquiry possible, but it does not promise a response, timeline,
              publication decision, or private research access.
            </p>
          </details>
          <details>
            <summary>How are abusive or defamatory messages handled?</summary>
            <p>
              Threats, harassment, profanity, and defamatory, libelous, or slanderous allegations
              are outside the inquiry channel and will not be accepted as discussion.
            </p>
          </details>
          <details>
            <summary>Is this a public discussion board?</summary>
            <p>
              Not currently. The current route is one-to-one correspondence initiated through your
              mail application. No public comments or community discussion are published here.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { correctionContext } from "../../lib/corrections";
  const context = correctionContext(window.location.search);
  if (context) {
    document.querySelector<HTMLSelectElement>("#contact-topic")!.value =
      "Public reading copy or correction";
    document.querySelector<HTMLTextAreaElement>("#contact-message")!.value = context;
  }
  const form = document.querySelector("[data-contact-inquiry-form]");
  const status = document.querySelector("[data-contact-inquiry-status]");

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    const draft = () => {
      const values = new FormData(form);
      const name = String(values.get("name") ?? "").trim() || "Not provided";
      const email = String(values.get("email") ?? "").trim() || "Use the sender address";
      const topic = String(values.get("topic") ?? "").trim();
      const message = String(values.get("message") ?? "").trim();
      const subject = `Independent Observer inquiry: ${topic}`;
      const body = [
        `Name: ${name}`,
        `Email: ${email}`,
        `Inquiry about: ${topic}`,
        "",
        message,
        "",
        "I confirm that this inquiry follows the contact disclosure.",
      ].join("\n");

      return { subject, body };
    };
    const copy = async (text: string, confirmation: string) => {
      const fallbackLabel = form.querySelector<HTMLElement>("[data-copy-fallback-label]")!;
      const fallback = form.querySelector<HTMLTextAreaElement>("#contact-copy-fallback")!;
      fallbackLabel.hidden = true;
      fallback.value = "";
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = confirmation + " Nothing has been sent.";
      } catch {
        fallback.value = text;
        fallbackLabel.hidden = false;
        fallback.focus();
        fallback.select();
        status.textContent =
          "Automatic copying is unavailable. Select and copy the text below. Nothing has been sent.";
      }
    };
    form.querySelector("[data-copy-address]")?.addEventListener("click", () => {
      void copy("swardhan1@icloud.com", "Email address copied.");
    });
    form.querySelector("[data-copy-message]")?.addEventListener("click", () => {
      if (!form.reportValidity()) return;
      const { subject, body } = draft();
      void copy(
        `Subject: ${subject}\n\n${body}`,
        "Message copied. Paste it into your mail service and review before sending.",
      );
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const { subject, body } = draft();
      window.location.href = `mailto:swardhan1@icloud.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.textContent =
        "Your mail app should open with a draft. If it does not, use Copy message and Copy email address. Nothing has been sent or stored by this site.";
    });
  }
</script>
