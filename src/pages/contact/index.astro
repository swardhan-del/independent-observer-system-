---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout
  title="Contact"
  description="Contact page preview for The Independent Observer."
  currentPath="/contact/"
>
  <PageHero
    eyebrow="Contact"
    title="Begin with the substance."
    description="A future contact channel for corrections, research leads, documentary inquiries, and professional correspondence."
  />
  <section class="section section-white">
    <div class="shell page-grid">
      <div class="prose">
        <h2>Contact system not yet activated</h2>
        <p>
          No public email address or form-processing service has been configured. This prevents the
          preview from inventing contact details or collecting information without a privacy policy.
        </p>
        <h3>Planned inquiry categories</h3>
        <ul>
          <li>Corrections and source challenges</li>
          <li>Research leads and public records</li>
          <li>Documentary and media inquiries</li>
          <li>Rights, licensing, and professional correspondence</li>
        </ul>
      </div>
      <form class="contact-panel" aria-label="Contact form preview" onsubmit="return false">
        <div class="placeholder-notice">
          Preview only—this form does not transmit or store data.
        </div>
        <h2>Send an inquiry</h2>
        <label for="contact-name">Name</label>
        <input id="contact-name" type="text" disabled />
        <label for="contact-email">Email</label>
        <input id="contact-email" type="email" disabled />
        <label for="contact-message">Message</label>
        <textarea id="contact-message" disabled></textarea>
        <button class="button" type="button" disabled>Coming later</button>
      </form>
    </div>
  </section>
</BaseLayout>
