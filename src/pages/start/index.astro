---
import FollowUpdates from "../../components/FollowUpdates.astro";
import ReadingJourneys from "../../components/ReadingJourneys.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import TopicVolumeMap from "../../components/TopicVolumeMap.astro";
import VolumeVisualStrip from "../../components/VolumeVisualStrip.astro";
import { sitePath } from "../../lib/paths";
import GreenPublicationShelf from "../../components/GreenPublicationShelf.astro";
---

<BaseLayout
  title="Start here"
  description="A guided introduction to Siddhartha Harsh Wardhan's four-volume, source-led research project and its questions about evidence, power, work, and human capability."
  currentPath="/start/"
>
  <PageHero
    className="discovery-hero"
    eyebrow="Independent Observer volumes"
    title="Start with a question."
    description="Choose a question about evidence, power or work. Start with a short summary, then follow the sources at your own pace."
  />
  <section class="section section-white" aria-labelledby="first-read-title">
    <div class="shell prose">
      <p class="eyebrow">Recommended first read · About 3 minutes</p>
      <h2 id="first-read-title">Why two deportation totals can tell different stories</h2>
      <p>
        Learn to spot a misleading comparison: check what is counted, match the time periods, and
        separate the evidence from the conclusion. A short worked example makes the problem
        concrete.
      </p>
      <a class="button" href={sitePath("/library/documents/who-deported-more/")}
        >Read the three-minute explanation →</a
      >
      <p class="form-note">Read freely here. No account or background knowledge required.</p>
    </div>
  </section>
  <ReadingJourneys />
  <details class="shell start-background">
    <summary>Read the project introduction and explore all four volumes</summary>
    <section class="section section-white" aria-labelledby="start-about-title">
      <div class="shell page-grid">
        <div class="page-aside">
          <span>About the project</span>
          <span>Research in progress</span>
        </div>
        <div class="prose">
          <h2 id="start-about-title">Research for independent judgment.</h2>
          <p>
            Siddhartha Harsh Wardhan is the author and researcher developing Independent Observer as
            a connected study of how people know, how institutions exercise power, and how material
            conditions shape what becomes possible. The work brings history, politics, economics,
            law, science, technology, and public reasoning into conversation without reducing every
            question to a single explanation.
          </p>
          <p>
            The purpose is practical: slow down the rush from headline to conclusion, look for the
            record beneath the story, follow the incentives and definitions that organize it, and
            keep uncertainty visible. The essays, maps, documentaries, and volume guides are part of
            an ongoing research process grounded in sources and references, open to correction as
            the evidence and the questions develop.
          </p>
        </div>
      </div>
    </section>
    <section
      class="section section-white start-visual-section"
      aria-labelledby="start-visual-title"
    >
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">A visual way in</p>
            <h2 id="start-visual-title">See how the four volumes connect.</h2>
          </div>
          <p>
            Begin with the same question at four scales: how a record becomes visible, how power
            organizes it, who carries the cost, and what human capability can govern next.
          </p>
        </div>
        <VolumeVisualStrip compact />
      </div>
    </section>

    <TopicVolumeMap />
    <section class="section section-white">
      <div class="shell start-grid">
        <a class="start-card" href={sitePath("/topics/#topic-pathway-method")}
          ><span>01</span><h2>Understand Volume I’s method</h2><p>
            Study observation as a practice: how time, resources, distance, and economic position
            can create room to watch before reacting—and how those advantages shape what gets seen.
          </p><strong>Open the Volume I method reading path →</strong></a
        >
        <a class="start-card" href={sitePath("/topics/#topic-pathway-ai-labor")}
          ><span>02</span><h2>Explore Volume IV: AI and labor</h2><p>
            Follow The Autonomous Illusion, Disconnected Hearts, and public preprints on automation,
            labor, intimacy, infrastructure, and human capability.
          </p><strong>Open the Volume IV reading path →</strong></a
        >
        <a class="start-card" href={sitePath("/topics/#topic-pathway-democracy")}
          ><span>03</span><h2>Connect democracy to Volume IV capacity</h2><p>
            Read institutions through Volumes I–II, then ask how scientific, technical, and AI
            capacity changes what democratic institutions can do.
          </p><strong>Open the institution map →</strong></a
        >
        <a class="start-card" href={sitePath("/topics/#topic-pathway-human-capability")}
          ><span>04</span><h2>Explore Volume IV: science and capability</h2><p>
            Connect The Autonomous Illusion, Disconnected Hearts, The Double Tax on Time, and The
            Martian Illusion across science, technology, energy, medicine, and human limits.
          </p><strong>Open the Volume IV science reading path →</strong></a
        >
        <a class="start-card" href={sitePath("/topics/#topic-pathway-migration")}
          ><span>05</span><h2>Explore Volumes II–III: migration and political economy</h2><p>
            Begin with Volume II papers on removals, voting, historical power, and sovereignty, then
            connect them to Volume III work on labor, taxation, welfare, and distribution.
          </p><strong>Open the Volumes II–III reading path →</strong></a
        >
        <a class="start-card start-card-dark" href={sitePath("/library/")}
          ><span>06</span><h2>See the reviewed library</h2><p>
            Read the public-safe archive map and structured document reader. Raw private files
            remain private.
          </p><strong>Open the library →</strong></a
        >
      </div>
    </section>
    <GreenPublicationShelf title="Six connected starting points" />
  </details>
  <div class="shell"><FollowUpdates /></div>
</BaseLayout>

<style>
  .start-background {
    margin-block: 24px;
  }
  .start-background > summary {
    padding: 20px;
    cursor: pointer;
    border: 1px solid var(--line);
    font-weight: 700;
  }
</style>
