---
import ReadingToolsInvitation from "../../components/ReadingToolsInvitation.astro";
import FollowUpdates from "../../components/FollowUpdates.astro";
import ReadingJourneys from "../../components/ReadingJourneys.astro";
import JusticeCapacityPath from "../../components/JusticeCapacityPath.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { editorialThemes } from "../../data/editorial-discovery";
import { sitePath } from "../../lib/paths";
---

<BaseLayout
  title="Start here"
  description="A guided introduction to Siddhartha Harsh Wardhan's four-volume, source-led research project and its questions about evidence, power, work, and human capability."
  currentPath="/start/"
>
  <PageHero
    className="discovery-hero"
    eyebrow="New to The Independent Observer?"
    title="Start with a question."
    description="Choose a subject or begin with a four-minute example. Follow a claim back to its sources, then explore the four-volume research archive at your own pace."
  />
  <section class="section section-white" aria-labelledby="first-read-title">
    <div class="shell prose">
      <p class="eyebrow">Recommended first read · About 4 minutes</p>
      <h2 id="first-read-title">Why two deportation totals can tell different stories</h2>
      <p>
        Learn to spot a misleading comparison: check what is counted, match the time periods, and
        separate the evidence from the conclusion. A short worked example makes the problem
        concrete.
      </p>
      <a class="button" href={sitePath("/library/documents/who-deported-more/")}
        >Read the four-minute explanation →</a
      >
      <p class="form-note">Read freely here. No account or background knowledge required.</p>
    </div>
  </section>
  <section class="section section-white" aria-labelledby="ai-reading-title">
    <div class="shell prose">
      <p class="eyebrow">A connected reading path · Published analyses</p>
      <h2 id="ai-reading-title">What does AI change beyond the screen?</h2>
      <p>
        Explore the infrastructure that powers AI, then the tasks it changes at work. Each article
        makes its evidence and policy proposals visible.
      </p>
      <a class="button" href={sitePath("/collections/ai-work-and-infrastructure/")}
        >Explore AI, work and infrastructure →</a
      >
    </div>
  </section>
  <section class="section section-white" aria-labelledby="start-topics-title">
    <div class="shell prose">
      <h2 id="start-topics-title">Find a subject you want to understand</h2>
      <ul class="start-themes">
        {
          editorialThemes.map((theme) => (
            <li>
              <>
                <a href={sitePath(theme.href)}>{theme.label}</a>
                <span>{theme.description}</span>
              </>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <ReadingJourneys />
  <JusticeCapacityPath />
  <ReadingToolsInvitation />
  <section class="section section-white">
    <div class="shell prose">
      <h2>Explore the project.</h2>
      <p>
        Independent Observer connects four questions: how we know, where power resides, who carries
        the cost of change, and what people can govern as technology changes.
      </p>
      <p>
        <a href={sitePath("/about/")}>Meet the author →</a> · <a href={sitePath("/series/")}
          >Explore the four-volume research roadmap →</a
        > · <a href={sitePath("/library/")}>Browse available reading →</a>
      </p>
    </div>
  </section>
  <div class="shell"><FollowUpdates /></div>
</BaseLayout>

<style>
  .start-themes {
    padding-inline-start: 1.25em;
  }
  .start-themes li + li {
    margin-top: 12px;
  }
  .start-themes span {
    display: block;
  }
  .start-themes a {
    font-weight: 700;
  }
</style>
