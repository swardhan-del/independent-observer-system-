---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { substackSubscribeUrl } from "../../data/social";
import { sitePath } from "../../lib/paths";

import { recentArticles } from "../../data/reader-catalogue";
const sampleArticles = recentArticles.filter((item) =>
  [
    "the-last-human-workforce",
    "the-server-as-a-furnace",
    "factories-return-but-do-the-jobs",
  ].includes(item.slug),
);
---

<BaseLayout
  title="Join"
  description="Subscribe free to The Observer Brief for new Independent Observer research, source notes, and selected reading."
  currentPath="/join/"
>
  <PageHero
    className="discovery-hero"
    eyebrow="The Independent Observer newsletter"
    title="The Observer Brief"
    description="Join the free reader list for research notes and publication updates. Explore a sample reading brief below."
  >
    <a
      class="button"
      href={substackSubscribeUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-email-signup-start="join-page"
    >
      Subscribe free on Substack ↗
    </a>
    <p class="form-note">
      Substack handles your subscription and email address under its own privacy policy.
    </p>
  </PageHero>

  <section class="section section-white" aria-labelledby="join-options-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Reader relationship</p>
          <h2 id="join-options-title">Get research updates.</h2>
        </div>
        <p>Public research remains free to read and cite. Subscribe for updates on new work.</p>
      </div>

      <div class="join-reader-grid">
        <article class="editorial-card">
          <p class="eyebrow">Free reader · $0</p>
          <h3>What you’ll receive</h3>
          <p>
            Receive research notes, new-paper alerts, publication updates, and selected reading
            paths.
          </p>

          <ul>
            <li>Public essays and working-paper summaries</li>
            <li>New research notifications</li>
            <li>Podcast and documentary updates</li>
            <li>Corrections and publication-status updates</li>
          </ul>
        </article>

        <article class="editorial-card" aria-labelledby="sample-brief-title">
          <p class="eyebrow">Sample reading brief</p>
          <h3 id="sample-brief-title">AI, work and the infrastructure behind it.</h3>
          <p class="form-note">
            An illustrative reading selection from released articles, not a previously sent
            newsletter. No fixed email schedule is promised.
          </p>
          <ol class="sample-brief-list">
            {
              sampleArticles.map((item) => (
                <li>
                  <>
                    <a href={sitePath(`/research/${item.slug}/`)}>{item.shortTitle}</a>
                    <p>{item.standfirst}</p>
                  </>
                </li>
              ))
            }
          </ol>
          <a href={sitePath("/collections/ai-work-and-infrastructure/")}
            >Explore the full collection →</a
          >
        </article>
      </div>
    </div>
  </section>

  <section class="section section-navy" aria-labelledby="join-principle-title">
    <div class="shell">
      <div class="prose">
        <p class="eyebrow">Publishing principle</p>
        <h2 id="join-principle-title">The research stays discoverable.</h2>
        <p>
          The library, article sources, and correction notes are open to everyone. The Observer
          Brief is an optional way to hear about new work.
        </p>
      </div>
      <p><a class="button" href={sitePath("/library/")}>Read the public library →</a></p>
    </div>
  </section>
</BaseLayout>
<script>
  import { track } from "../../lib/analytics";
  track("join_page_view");
</script>

<style>
  .section {
    padding-block: 32px;
  }
  .join-reader-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 28px;
    align-items: start;
    overflow-wrap: anywhere;
  }
  .sample-brief-list {
    padding-left: 24px;
  }
  .sample-brief-list li + li {
    margin-top: 24px;
  }
  .sample-brief-list a {
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .join-reader-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
