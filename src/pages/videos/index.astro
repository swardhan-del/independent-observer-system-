---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentFilter from "../../components/ContentFilter.astro";
import PageHero from "../../components/PageHero.astro";
import EditorialCard from "../../components/EditorialCard.astro";
import { videoItems } from "../../data/content";
import { sitePath } from "../../lib/paths";
import { slugify } from "../../lib/slugs";
---

<BaseLayout
  title="Videos"
  description="Video concepts and future releases from The Independent Observer."
  currentPath="/videos/"
>
  <PageHero
    eyebrow="Video desk"
    title="Videos"
    description="Short-form arguments, visual explainers, and documentary releases organized by subject and editorial status."
  />
  <section class="section section-white">
    <div class="shell">
      <h2 class="sr-only">Video previews</h2>
      <div class="placeholder-notice">
        This is a preview catalogue. Embedded players, release dates,
        transcripts, and platform links will appear after videos are published.
      </div>
      <ContentFilter
        targetId="video-preview-grid"
        itemCount={videoItems.length}
      />
      <div class="card-grid" id="video-preview-grid">
        {
          videoItems.map((item, index) => (
            <EditorialCard
              item={item}
              index={index + 1}
              href={sitePath(`/videos/${slugify(item.title)}/`)}
            />
          ))
        }
      </div>
    </div>
  </section>
  <section class="section section-rule">
    <div class="shell page-grid">
      <aside class="page-aside">Format architecture</aside>
      <div class="prose">
        <h2>One research base, several viewing depths</h2>
        <p>
          The intended video system connects concise shorts, mid-length
          explainers, and long-form documentaries. Each format should lead
          interested viewers toward the fuller evidence rather than repeating
          the same generic summary.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
