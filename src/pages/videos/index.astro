---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentFilter from "../../components/ContentFilter.astro";
import PageHero from "../../components/PageHero.astro";
import EditorialCard from "../../components/EditorialCard.astro";
import VolumeReelShelf from "../../components/VolumeReelShelf.astro";
import ReelTreatmentShelf from "../../components/ReelTreatmentShelf.astro";
import { videoItems } from "../../data/content";
import { volumeReels } from "../../data/video-reels";
import { sitePath } from "../../lib/paths";
import { slugify } from "../../lib/slugs";
---

<BaseLayout
  title="Videos"
  description="Video concepts and future releases from Independent Observer."
  currentPath="/videos/"
>
  <PageHero
    eyebrow="Video desk"
    title="Videos"
    description="Short-form arguments, visual explainers, and documentary releases organized by subject and editorial status."
  />
  <section class="section section-white">
    <div class="shell">
      <div class="section-heading volume-reel-heading">
        <div>
          <p class="eyebrow">Four-volume reel desk</p>
          <h2 id="volume-reel-previews-title">One reel for each volume.</h2>
        </div>
        <p>
          These selected media previews give each volume a visual entry point: method, power, work,
          and human capability. They are hosted copies of organized source exports, with their
          review boundary kept visible.
        </p>
      </div>
      <div class="placeholder-notice">
        The four players below are public preview assets. A player is not a publication approval:
        transcripts, rights checks, citations, and final release dates remain separate editorial
        gates.
      </div>
      <VolumeReelShelf items={volumeReels} />
      <ReelTreatmentShelf />
      <div class="section-heading video-preview-heading">
        <div>
          <p class="eyebrow">Additional concept previews</p>
          <h2 id="video-concepts-title">Follow the questions between volumes.</h2>
        </div>
        <p>
          The reel desk above gives Volumes I–IV a direct visual entry point. These additional
          concepts follow questions that travel between the volumes and remain clearly marked as
          previews.
        </p>
      </div>
      <ContentFilter targetId="video-preview-grid" itemCount={videoItems.length} />
      <div
        class="card-grid video-preview-grid"
        id="video-preview-grid"
        aria-labelledby="video-concepts-title"
      >
        {
          videoItems.map((item, index) => (
            <EditorialCard
              item={item}
              index={index + 1}
              href={sitePath(`/videos/${slugify(item.title)}/`)}
            />
          ))
        }
      </div>
    </div>
  </section>
  <section class="section section-navy" aria-labelledby="public-format-path-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">From the research desk</p>
          <h2 id="public-format-path-title">One record. Three viewing depths.</h2>
        </div>
        <p>
          Shorts, reels, and a future Independent Observer Survey can help readers enter the work;
          each remains connected to the documented source and the longer argument.
        </p>
      </div>
      <div class="card-grid video-format-grid">
        <article class="editorial-card">
          <div class="card-meta"><span>01</span><span>Shorts &amp; reels</span></div>
          <h3>Start with one visible claim.</h3>
          <p>
            Short-form pieces will isolate one documented claim, one mechanism, and one source
            trail. They are entry points into the research—not replacements for the record.
          </p>
          <div class="card-footer">
            <span class="status-pill">Concept preview</span>
            <a class="card-open-link" href={sitePath("/about/#about-program-title")}
              >See the project →</a
            >
          </div>
        </article>
        <article class="editorial-card" id="independent-observer-survey">
          <div class="card-meta"><span>02</span><span>Independent Observer Survey</span></div>
          <h3>Ask before asserting.</h3>
          <p>
            A planned survey format will make the project’s questions visible and testable. It is
            not open yet: no responses, findings, or audience data are published here.
          </p>
          <div class="card-footer">
            <span class="status-pill">Concept preview</span>
            <a class="card-open-link" href={sitePath("/topics/")}>Explore the questions →</a>
          </div>
        </article>
        <article class="editorial-card">
          <div class="card-meta"><span>03</span><span>Documentary &amp; explainers</span></div>
          <h3>Follow the evidence further.</h3>
          <p>
            Longer video can hold chronology, competing explanations, and source notes in view. A
            release belongs on the site only after its media, rights, transcript, and evidence are
            cleared.
          </p>
          <div class="card-footer">
            <span class="status-pill">Preview catalogue</span>
            <a class="card-open-link" href={sitePath("/documentaries/")}>Open documentary desk →</a>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="section section-rule">
    <div class="shell page-grid">
      <aside class="page-aside">Format architecture</aside>
      <div class="prose">
        <h2>One research base, several viewing depths</h2>
        <p>
          The intended video system connects concise shorts, mid-length explainers, and long-form
          documentaries. Each format should lead interested viewers toward the fuller evidence
          rather than repeating the same generic summary.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
