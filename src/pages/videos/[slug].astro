---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialDetail from "../../components/EditorialDetail.astro";
import { videoItems } from "../../data/content";
import { slugify } from "../../lib/slugs";
import { sitePath } from "../../lib/paths";

export function getStaticPaths() {
  return videoItems.map((item) => ({
    params: { slug: slugify(item.title) },
    props: { item },
  }));
}

const { item } = Astro.props;
const currentPath = `/videos/${slugify(item.title)}/`;
---

<BaseLayout title={item.title} description={item.description} currentPath={currentPath}>
  <EditorialDetail
    item={item}
    eyebrow="Video preview"
    backLabel="Back to videos"
    backHref={sitePath("/videos/")}
    statusNote={`Publication status: ${item.status}. This is a preview entry. A future release may include a player, transcript, citations, and platform links after publication review.`}
  />
</BaseLayout>
