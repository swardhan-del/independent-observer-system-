---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/paths";

const destination = sitePath("/governance/");
---

<BaseLayout
  title="Editorial standards"
  description="The former publication guide now points readers to Independent Observer editorial standards and privacy information."
  currentPath="/publication-operating-system/"
  canonicalPath="/governance/"
  noindex
>
  <meta http-equiv="refresh" content={`0;url=${destination}`} />
  <section class="section section-white redirect-page" aria-labelledby="redirect-title">
    <div class="shell narrow-shell">
      <p class="eyebrow">Editorial standards</p>
      <h1 id="redirect-title">Continue to editorial standards and privacy.</h1>
      <p>
        This legacy address now points to the reader-facing standards, corrections, privacy, reuse,
        and disclosures guide.
      </p>
      <a class="button button-primary" href={destination}>Open editorial standards →</a>
    </div>
  </section>
</BaseLayout>
