---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentFilter from "../../components/ContentFilter.astro";
import PageHero from "../../components/PageHero.astro";
import EditorialCard from "../../components/EditorialCard.astro";
import { dropboxFeedItems } from "../../data/dropbox-content.generated";
import { seriesItems } from "../../data/series";
import { sitePath } from "../../lib/paths";

const automatedSeriesItems = dropboxFeedItems.filter(
  (item) => item.kind === "series",
);
---

<BaseLayout
  title="Series Roadmap"
  description="A preview roadmap for the four-volume Independent Observer nonfiction series."
  currentPath="/series/"
>
  <PageHero
    eyebrow="Publication roadmap"
    title="One series. Four mechanisms."
    description="A public-safe view of the Independent Observer series as it develops across democratic capacity, sovereignty, social citizenship, and human capability."
  />
  <section class="section section-white">
    <div class="shell">
      <h2 class="sr-only">Independent Observer volume previews</h2>
      <div class="placeholder-notice">
        This is a review roadmap, not a publication catalogue. Candidate titles
        and descriptions may change; no volume is represented as published, peer
        reviewed, or commercially released.
      </div>
      <ContentFilter
        targetId="series-preview-grid"
        itemCount={seriesItems.length}
      />
      <div class="card-grid" id="series-preview-grid">
        {
          seriesItems.map((item, index) => (
            <article
              class="editorial-card"
              data-filter-card
              data-search-text={[
                item.title,
                item.volume,
                item.category,
                item.description,
                item.status,
              ]
                .join(" ")
                .toLocaleLowerCase()}
              data-status={item.status.toLocaleLowerCase()}
            >
              <div class="card-meta">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span>{item.volume}</span>
              </div>
              <h3>{item.title}</h3>
              <p class="card-category">{item.category}</p>
              <p>{item.description}</p>
              <div class="card-footer">
                <span class="status-pill">{item.status}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  {
    automatedSeriesItems.length > 0 && (
      <section class="section section-navy">
        <div class="shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Approved archive feed</p>
              <h2>New roadmap notes</h2>
            </div>
            <p>
              Structured updates arrive from Dropbox only after explicit website
              approval.
            </p>
          </div>
          <div class="card-grid">
            {automatedSeriesItems.map((item, index) => (
              <EditorialCard item={item} index={index + 1} />
            ))}
          </div>
        </div>
      </section>
    )
  }
  <section class="section section-rule">
    <div class="shell page-grid">
      <aside class="page-aside">Release standard</aside>
      <div class="prose">
        <h2>Public promise before publication</h2>
        <p>
          A finished volume must pass claim-level evidence review, rights and
          provenance checks, fairness review, rendered visual QA, cloud-state
          verification, and dated author approval. The roadmap keeps those gates
          visible rather than converting a working archive into an implied
          release.
        </p>
        <p>
          <a href={sitePath("/research/")}>Explore the research desk</a> while the
          series develops.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
