---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import EditorialCard from "../../components/EditorialCard.astro";
import PublicationCatalogue from "../../components/PublicationCatalogue.astro";
import { dropboxFeedItems } from "../../data/dropbox-content.generated";
import { sitePath } from "../../lib/paths";

const automatedSeriesItems = dropboxFeedItems.filter((item) => item.kind === "series");
---

<BaseLayout
  title="Publication Catalogue"
  description="The official public-safe catalogue of the four-volume Independent Observer research program."
  currentPath="/series/"
>
  <PageHero
    eyebrow="Publication catalogue"
    title="One series. Four lines of inquiry."
    description="An official public-safe index of the Independent Observer program: its four volumes, public reading copies, investigative files, and visible release boundaries."
  />
  <PublicationCatalogue />
  {
    automatedSeriesItems.length > 0 && (
      <section class="section section-navy">
        <div class="shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Approved archive feed</p>
              <h2>New catalogue records</h2>
            </div>
            <p>Structured updates arrive from Dropbox only after explicit website approval.</p>
          </div>
          <div class="card-grid">
            {automatedSeriesItems.map((item, index) => (
              <EditorialCard item={item} index={index + 1} />
            ))}
          </div>
        </div>
      </section>
    )
  }
  <section class="section section-rule">
    <div class="shell page-grid">
      <aside class="page-aside">Release standard</aside>
      <div class="prose">
        <h2>Public promise before publication</h2>
        <p>
          A catalogue record does not make a volume a finished publication. A released volume must
          pass claim-level evidence review, rights and provenance checks, fairness review, rendered
          visual QA, cloud-state verification, and dated author approval. The catalogue keeps those
          gates visible while making the work easier to investigate.
        </p>
        <p>
          <a href={sitePath("/research/")}>Explore the research desk</a> while the series develops.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
