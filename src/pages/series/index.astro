---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PublicationCatalogue from "../../components/PublicationCatalogue.astro";
import VolumeVisualStrip from "../../components/VolumeVisualStrip.astro";
import { sitePath } from "../../lib/paths";
---

<BaseLayout
  title="Publication Catalogue"
  description="The official public-safe catalogue of the four-volume Independent Observer research program."
  currentPath="/series/"
>
  <PageHero
    eyebrow="Publication catalogue"
    title="One series. Four volumes."
    description="Volumes is the publication catalogue: four connected book roadmaps in editorial development. Four lines of inquiry, one for each Independent Observer volume. Volume I is the method foundation: it represents observation, evidence, public memory, and democratic capacity, and is meant to show how a conclusion is formed before it is accepted. Volume II is the power inquiry: it represents sovereignty, institutions, history, migration, markets, and enforcement, and is meant to trace how authority is distributed and exercised. Volume III is the social-citizenship inquiry: it represents work, time, taxation, welfare, licensing, health, and economic security, and is meant to ask who carries the cost of change and who can access public capacity. Volume IV is the capability inquiry: it represents AI, infrastructure, science, labor, intimacy, and adaptation, and is meant to test how technological change can become human capability. Together, they form the official public-safe catalogue, with linked reading copies, research maps, and visible release boundaries."
    className="catalogue-hero"
  >
    <figure class="catalogue-hero-visual">
      <img
        src={sitePath("/independent-observer-four-volume-map-v2.png")}
        alt="Four-volume Independent Observer map connecting observation, power, distribution, and capability around one observing lens."
        width="1536"
        height="1024"
        loading="eager"
        decoding="async"
      />
      <div
        class="catalogue-hero-map-links"
        role="group"
        aria-label="Open a volume from the four-volume map"
      >
        <a href={sitePath("/series/independent-observer/")}>
          <span>01</span>
          <strong>Observation</strong>
        </a>
        <a href={sitePath("/series/the-empire-beneath-democracy/")}>
          <span>02</span>
          <strong>Power</strong>
        </a>
        <a href={sitePath("/series/managed-decline/")}>
          <span>03</span>
          <strong>Distribution</strong>
        </a>
        <a href={sitePath("/series/the-last-human-workforce/")}>
          <span>04</span>
          <strong>Capability</strong>
        </a>
      </div>
      <figcaption>
        <span>Interactive volume map</span>
        <strong>Choose a node to open its catalogue file.</strong>
      </figcaption>
    </figure>
  </PageHero>
  <section class="section section-rule volume-visual-section" aria-labelledby="volume-visual-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Visual map</p>
          <h2 id="volume-visual-title">Four questions. One connected program.</h2>
        </div>
        <p>
          These visual companions make the movement through the catalogue visible: observation
          becomes a way to locate power, follow distribution, and ask whether capability can be
          governed.
        </p>
      </div>
      <VolumeVisualStrip />
    </div>
  </section>
  <PublicationCatalogue />
  <section class="section section-rule">
    <div class="shell page-grid">
      <aside class="page-aside">Publication status</aside>
      <div class="prose">
        <h2>Public promise before publication</h2>
        <p>
          A catalogue record does not make a volume a finished publication. The volumes are in
          editorial development, and each entry uses a clear status label—such as public reference
          version, concept preview, or publication pending—to show what readers can use today.
        </p>
        <p>
          <a href={sitePath("/research/")}>Explore the research desk</a> while the series develops.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
