---
import FollowUpdates from "../components/FollowUpdates.astro";
import ContinueReading from "../components/ContinueReading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicPaperCatalogue } from "../data/reader-catalogue";
import FeaturedInvestigations from "../components/FeaturedInvestigations.astro";
import EditorialEntryPoints from "../components/EditorialEntryPoints.astro";
import { editorialMission } from "../data/editorial-discovery";
import { seriesItems } from "../data/series";
import { sitePath } from "../lib/paths";
import { slugify } from "../lib/slugs";
import { historyPodcast } from "../data/podcast";
const volumeQuestions: Record<string, string> = {
  "Volume I": "How do we know what to believe?",
  "Volume II": "Where does public power reside?",
  "Volume III": "Who carries the cost of change?",
  "Volume IV": "What can people govern as technology changes?",
};
const questionFor = (volume: string) => {
  const question = volumeQuestions[volume];
  if (!question) throw new Error(`Homepage volume question is missing: ${volume}`);
  return question;
};
---

<BaseLayout
  title="Independent Research on Institutions, Work and Technology"
  description={editorialMission}
  currentPath="/"
>
  <section class="hero focused-home-hero">
    <div class="shell hero-inner">
      <div>
        <h1>Follow the evidence.</h1>
        <p class="hero-summary">{editorialMission}</p>
        <p class="hero-purpose">
          Follow sources you can check, compare explanations, and see where the evidence ends.
        </p>
        <p class="hero-author">
          Written by <a href={sitePath("/about/")}>Siddhartha Harsh Wardhan</a>.
        </p>
        <div class="hero-actions">
          <a class="button" href={sitePath("/library/")}>Browse the research library →</a>
          <a class="button button-secondary" href={sitePath("/start/")}>Start here</a>
        </div>
        <p class="form-note">
          <a href="#follow-updates">Follow new publications with The Observer Brief →</a>
        </p>
      </div>
      <aside class="hero-note" aria-labelledby="hero-note-title">
        <p class="eyebrow">Start with your interests</p>
        <h2 id="hero-note-title">Choose your first investigation</h2>
        <EditorialEntryPoints />
        <p class="form-note">
          <a href={sitePath("/start/#reading-journeys")}>Choose a question →</a>
        </p>
      </aside>
    </div>
  </section>
  <div class="shell">
    <ContinueReading />
    <p class="form-note">
      <a href="#saved-reading-list">Find your saved reading →</a> · Saved on this device, without an account.
    </p>
  </div>
  <FeaturedInvestigations />
  <section class="section section-white more-reading" aria-label="More reading">
    <div class="shell">
      <a class="text-link" href={sitePath("/topics/")}>All topic guides →</a>
      <p>
        <a class="text-link" href={sitePath("/library/")}
          >Explore all {publicPaperCatalogue.length} author paper pages and the full library →</a
        >
      </p>
    </div>
  </section>
  <div class="shell"><FollowUpdates id="follow-updates" compact /></div>
  <section class="section section-navy" aria-labelledby="homepage-podcast-title">
    <div class="shell focused-podcast">
      <div>
        <p class="eyebrow">Listen &amp; watch</p><h2 id="homepage-podcast-title">
          {historyPodcast.title}
        </h2><p>{historyPodcast.subtitle}</p>
      </div><div class="hero-actions">
        <a class="button" href={sitePath("/podcast/")}>Listen to an episode →</a><a
          class="button button-secondary"
          href={sitePath("/videos/#volume-reel-previews-title")}>Watch preview reels</a
        >
      </div>
    </div>
  </section>
  <section class="section section-white" aria-labelledby="homepage-volume-guide-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The four-volume project</p><h2 id="homepage-volume-guide-title">
            One method. Four connected questions.
          </h2>
        </div><p>Choose a volume to enter the research. The volumes remain in development.</p>
      </div>
      <nav class="focused-volume-grid" aria-label="Explore the four volumes">
        {
          seriesItems.map((item) => (
            <a
              id={`homepage-${slugify(item.volume)}`}
              class="hero-volume-link"
              href={sitePath(`/series/${slugify(item.title)}/`)}
            >
              <>
                <span>{item.volume}</span>
                <strong>{item.title}</strong>
                <span>{questionFor(item.volume)}</span>
              </>
            </a>
          ))
        }
      </nav>
      <p>
        <a class="text-link" href={sitePath("/about/")}
          >About the author and the observing method →</a
        >
      </p>
    </div>
  </section>
  <section class="section section-white home-author" aria-labelledby="homepage-author-title">
    <div class="shell prose">
      <p class="eyebrow">The author</p>
      <h2 id="homepage-author-title">Siddhartha Harsh Wardhan</h2>
      <p>
        The Independent Observer is written by Siddhartha Harsh Wardhan. Read the method to see how
        an argument is tested, what counts as evidence, and how to flag an error.
      </p>
      <ul>
        <li><a href={sitePath("/about/")}>About the author</a></li>
        <li>
          <a href={sitePath("/research/the-independent-observer-method/")}
            >The Independent Observer Method</a
          >
        </li>
        <li>
          <a href={sitePath("/governance/#editorial-standards")}>Sourcing and editorial standards</a
          >
        </li>
        <li><a href={sitePath("/governance/#corrections")}>Corrections policy</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
<script>
  import { track } from "../lib/analytics";
  track("homepage_view");
</script>

<style>
  .section {
    padding-block: 48px;
  }
  .focused-home-hero .hero-inner {
    min-height: 0;
    padding-block: 36px;
    gap: 32px;
  }
  .focused-home-hero .hero-inner > div:first-child {
    padding-top: 0;
  }
  .focused-home-hero h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 1.05;
  }
  .focused-home-hero .hero-summary {
    margin-top: 16px;
  }
  .hero-purpose {
    max-width: 48ch;
    color: var(--white);
  }
  .hero-author a,
  .focused-home-hero .form-note a {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }
  .home-author {
    padding-block: 32px;
  }
  .more-reading {
    padding-block: 0 8px;
  }
  @media (max-width: 900px) {
    .section {
      padding-block: 32px;
    }
    .focused-home-hero .hero-inner {
      padding-block: 24px;
      gap: 20px;
    }
    .focused-home-hero .hero-summary {
      font-size: 1.05rem;
      line-height: 1.45;
    }
    .focused-home-hero .hero-note {
      padding: 20px;
    }
    .focused-home-hero .hero-note h2 {
      font-size: 1.5rem;
    }
    .focused-home-hero .hero-note .eyebrow {
      margin-bottom: 12px;
    }
  }
</style>
