---
import { displayTitle, summaryDescription, readingMinutes } from "../data/reader-presentation";
import FollowUpdates from "../components/FollowUpdates.astro";
import ContinueReading from "../components/ContinueReading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicPaperCatalogue } from "../data/reader-catalogue";
import { startingQuestions } from "../data/scholarly-clarity";
import ReaderCardContent from "../components/ReaderCardContent.astro";
import RecentArticles from "../components/RecentArticles.astro";
import { seriesItems } from "../data/series";
import { sitePath } from "../lib/paths";
import { slugify } from "../lib/slugs";
import { historyPodcast } from "../data/podcast";
const selectedIds = ["entanglement-primer", "disconnected-hearts", "wardhan-tax-doctrine"];
const readings = selectedIds.map((id) => {
  const paper = publicPaperCatalogue.find((paper) => paper.id === id);
  if (!paper) throw new Error(`Homepage selection is missing its public paper record: ${id}`);
  return paper;
});
const volumeQuestions: Record<string, string> = {
  "Volume I": "How do we know what to believe?",
  "Volume II": "Where does public power reside?",
  "Volume III": "Who carries the cost of change?",
  "Volume IV": "What can people govern as technology changes?",
};
const questionFor = (volume: string) => {
  const question = volumeQuestions[volume];
  if (!question) throw new Error(`Homepage volume question is missing: ${volume}`);
  return question;
};
---

<BaseLayout
  title="Independent Research on Institutions, Work and Technology"
  description="Independent research tests public claims about institutions, technology, work, and political power across four volumes, with sources and stated limits."
  currentPath="/"
>
  <section class="hero focused-home-hero">
    <div class="shell hero-inner">
      <div>
        <h1>Observe the system.<br /><em>Question the frame.</em></h1>
        <p class="hero-summary">
          Research on power, work and technology—with sources you can check and limits clearly
          stated.
        </p>
        <p class="form-note hero-entry-links">
          <a href={sitePath("/start/#reading-journeys")}>Choose a question →</a>
          <a href={sitePath("/governance/")}>Sources and editorial standards →</a>
        </p>
      </div>
      <aside class="hero-note" aria-labelledby="hero-note-title">
        <p class="eyebrow">Featured explanation · 4 min read</p>
        <h2 id="hero-note-title">What does a deportation number actually count?</h2>
        <p>
          Learn why two deportation totals can tell different stories. Try a worked example, then
          follow the official sources.
        </p>
        <a class="button" href={sitePath("/library/documents/who-deported-more/")}
          >Start reading · 4 min →</a
        >
        <p class="form-note">Free explanation · no account needed</p>
      </aside>
    </div>
  </section>
  <div class="shell"><ContinueReading /></div>
  <RecentArticles />
  <section class="section section-white" aria-labelledby="homepage-literature-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected reading</p><h2 id="homepage-literature-title">
            Three places to begin.
          </h2>
        </div><p>
          These are summaries of working papers. Each page explains its sources and limitations.
        </p>
      </div>
      <div class="focused-reading-grid">
        {
          readings.map((paper) => (
            <article class="editorial-card reader-card" data-home-reading={paper.id}>
              <ReaderCardContent
                title={displayTitle(paper)}
                question={startingQuestions[paper.id]}
                description={summaryDescription(paper)}
                href={`/library/documents/${paper.id}/`}
                volume={paper.volume}
                status="Working-paper summary"
                minutes={readingMinutes(paper)}
                action="Read the summary"
              />
            </article>
          ))
        }
      </div>
      <p>
        <a class="text-link" href={sitePath("/library/")}
          >Explore all {publicPaperCatalogue.length} author paper pages and the full library →</a
        >
      </p>
    </div>
  </section>
  <section class="section section-navy" aria-labelledby="homepage-podcast-title">
    <div class="shell focused-podcast">
      <div>
        <p class="eyebrow">Listen &amp; watch</p><h2 id="homepage-podcast-title">
          {historyPodcast.title}
        </h2><p>{historyPodcast.subtitle}</p>
      </div><div class="hero-actions">
        <a class="button" href={sitePath("/podcast/")}>Listen to an episode →</a><a
          class="button button-secondary"
          href={sitePath("/videos/#volume-reel-previews-title")}>Watch preview reels</a
        >
      </div>
    </div>
  </section>
  <section class="section section-white" aria-labelledby="homepage-volume-guide-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The four-volume project</p><h2 id="homepage-volume-guide-title">
            One method. Four connected questions.
          </h2>
        </div><p>Choose a volume to enter the research. The volumes remain in development.</p>
      </div>
      <nav class="focused-volume-grid" aria-label="Explore the four volumes">
        {
          seriesItems.map((item) => (
            <a
              id={`homepage-${slugify(item.volume)}`}
              class="hero-volume-link"
              href={sitePath(`/series/${slugify(item.title)}/`)}
            >
              <>
                <span>{item.volume}</span>
                <strong>{item.title}</strong>
                <span>{questionFor(item.volume)}</span>
              </>
            </a>
          ))
        }
      </nav>
      <p>
        <a class="text-link" href={sitePath("/about/")}
          >About the author and the observing method →</a
        >
      </p>
    </div>
  </section>
  <section class="section section-white home-author" aria-labelledby="homepage-author-title">
    <div class="shell prose">
      <p class="eyebrow">The author</p>
      <h2 id="homepage-author-title">Siddhartha Harsh Wardhan</h2>
      <p>
        A single-author research and essay project examining how institutions, work and technology
        shape everyday life. Each reading page identifies its sources and limitations.
      </p>
      <p><a href={sitePath("/about/")}>Meet the author and explore the method →</a></p>
      <p><a href={sitePath("/latest/")}>See new and recently revised research →</a></p>
    </div>
  </section>
  <div class="shell"><FollowUpdates id="follow-updates" /></div>
</BaseLayout>
<script>
  import { track } from "../lib/analytics";
  track("homepage_view");
</script>

<style>
  .section {
    padding-block: 48px;
  }
  .focused-home-hero .hero-inner {
    min-height: 0;
    padding-block: 36px;
    gap: 32px;
  }
  .focused-home-hero .hero-inner > div:first-child {
    padding-top: 0;
  }
  .focused-home-hero h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 1.05;
  }
  .focused-home-hero .hero-summary {
    margin-top: 16px;
  }
  .hero-entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .home-author {
    padding-block: 32px;
  }
  @media (max-width: 900px) {
    .section {
      padding-block: 32px;
    }
    .focused-home-hero .hero-inner {
      padding-block: 24px;
      gap: 20px;
    }
    .focused-home-hero .hero-summary {
      font-size: 1.05rem;
      line-height: 1.45;
    }
    .focused-home-hero .hero-note {
      padding: 20px;
    }
    .focused-home-hero .hero-note h2 {
      font-size: 1.5rem;
    }
    .focused-home-hero .hero-note .eyebrow {
      margin-bottom: 12px;
    }
  }
</style>
