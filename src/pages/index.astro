---
import BaseLayout from "../layouts/BaseLayout.astro";
import { paperDocuments } from "../data/papers";
import { seriesItems } from "../data/series";
import { sitePath } from "../lib/paths";
import { slugify } from "../lib/slugs";
import { historyPodcast } from "../data/podcast";
const selectedIds = ["disconnected-hearts", "double-tax-on-time", "wardhan-tax-doctrine"];
const readings = selectedIds.map((id) => {
  const paper = paperDocuments.find((paper) => paper.id === id);
  if (!paper) throw new Error(`Homepage selection is missing its public paper record: ${id}`);
  return paper;
});
const volumeQuestions = [
  "How do we know what to believe?",
  "Where does public power reside?",
  "Who carries the cost of change?",
  "What can people govern as technology changes?",
];
---

<BaseLayout
  title="Home"
  description="Independent research on power, work, history, and technology. Start with a question, read a paper summary, or listen to the podcast."
  currentPath="/"
>
  <section class="hero focused-home-hero">
    <div class="shell hero-inner">
      <div>
        <p class="eyebrow">Independent media &amp; research</p>
        <h1>Observe the system.<br /><em>Question the frame.</em></h1>
        <p class="hero-summary">
          Explore how power, work, history, and technology shape our lives. Follow the evidence
          behind the arguments.
        </p>
        <div class="hero-actions">
          <a class="button" href={sitePath("/start/#reading-journeys")}>Start with a question</a>
          <a class="button button-secondary" href={sitePath("/library/")}>Browse the library</a>
        </div>
      </div>
      <aside class="hero-note" aria-labelledby="hero-note-title">
        <p class="eyebrow">Featured question</p>
        <h2 id="hero-note-title">What does a deportation number actually count?</h2>
        <p>
          Different definitions and time periods can change a comparison. Start with the evidence
          and limitations in <em>Who Deported More?</em>
        </p>
        <a class="button" href={sitePath("/library/documents/who-deported-more/")}
          >Read the paper summary →</a
        >
        <p class="form-note">Working-paper summary · links to the source record</p>
      </aside>
    </div>
  </section>
  <section class="section section-white" aria-labelledby="homepage-literature-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected reading</p><h2 id="homepage-literature-title">
            Three places to begin.
          </h2>
        </div><p>
          These are summaries of working papers. Each page explains its sources and limitations.
        </p>
      </div>
      <div class="focused-reading-grid">
        {
          readings.map((paper) => (
            <article class="editorial-card" data-home-reading={paper.id}>
              <>
                <p class="eyebrow">{paper.volume}</p>
                <h3>
                  <a href={sitePath(`/library/documents/${paper.id}/`)}>{paper.title}</a>
                </h3>
                <p>{paper.homepageDescription ?? paper.description}</p>
                <a class="text-link" href={sitePath(`/library/documents/${paper.id}/`)}>
                  Read the summary →
                </a>
              </>
            </article>
          ))
        }
      </div>
      <p>
        <a class="text-link" href={sitePath("/library/")}
          >Explore all {paperDocuments.length} paper summaries and the full library →</a
        >
      </p>
    </div>
  </section>
  <section class="section section-navy" aria-labelledby="homepage-podcast-title">
    <div class="shell focused-podcast">
      <div>
        <p class="eyebrow">Listen &amp; watch</p><h2 id="homepage-podcast-title">
          {historyPodcast.title}
        </h2><p>{historyPodcast.subtitle}</p>
      </div><div class="hero-actions">
        <a class="button" href={sitePath("/podcast/")}>Listen to an episode →</a><a
          class="button button-secondary"
          href={sitePath("/videos/")}>Watch the video previews</a
        >
      </div>
    </div>
  </section>
  <section class="section section-white" aria-labelledby="homepage-volume-guide-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The four-volume project</p><h2 id="homepage-volume-guide-title">
            One method. Four connected questions.
          </h2>
        </div><p>Choose a volume to enter the research. The volumes remain in development.</p>
      </div>
      <nav class="focused-volume-grid" aria-label="Explore the four volumes">
        {
          seriesItems.map((item, index) => (
            <a
              id={`homepage-${slugify(item.volume)}`}
              class="hero-volume-link"
              href={sitePath(`/series/${slugify(item.title)}/`)}
            >
              <>
                <span>{item.volume}</span>
                <strong>{item.title}</strong>
                <span>{volumeQuestions[index]}</span>
              </>
            </a>
          ))
        }
      </nav>
      <p>
        <a class="text-link" href={sitePath("/about/")}
          >About the author and the observing method →</a
        >
      </p>
    </div>
  </section>
</BaseLayout>
