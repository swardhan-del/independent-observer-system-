---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialCard from "../components/EditorialCard.astro";
import { documentaryItems, researchItems, topics, videoItems } from "../data/content";
import { sitePath } from "../lib/paths";
---

<BaseLayout
  title="Home"
  description="The Independent Observer is a developing independent media and research project examining power, institutions, history, political economy, science, and technology."
  currentPath="/"
>
  <section class="hero">
    <div class="shell hero-inner">
      <div>
        <p class="eyebrow">Independent analysis for a complex age</p>
        <h1>Observe the system.<br /><em>Question the frame.</em></h1>
        <p class="hero-summary">
          The Independent Observer is a developing editorial project examining how history,
          institutions, political economy, science, and technology shape public life.
        </p>
        <div class="hero-actions">
          <a class="button" href={sitePath("/research/")}>Explore the research</a>
          <a class="button button-secondary" href={sitePath("/about/")}>Read the mission</a>
        </div>
      </div>
      <aside class="hero-note" aria-label="Editorial status">
        <span>Editorial status</span>
        <p>
          First working preview. Entries marked “Concept preview” or “In editorial development” are
          not presented as published work.
        </p>
      </aside>
    </div>
    <div class="hero-watermark" aria-hidden="true">IO</div>
  </section>

  <!-- Social proof / platform bar -->
  <section class="platform-bar" aria-label="Publishing platforms">
    <div class="shell platform-bar-inner">
      <span class="platform-bar-label">Coming to</span>
      <ul class="platform-list" role="list">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor"
            ><path
              d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
            ></path></svg
          >
          YouTube
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor"
            ><path
              d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46L0 5.406h24L22.54 0z"
            ></path></svg
          >
          Substack
        </li>
        <li>
          <svg viewBox="0 0 168 168" aria-hidden="true" width="18" height="18" fill="currentColor"
            ><path
              d="M83.996 0C37.747 0 0 37.746 0 84c0 46.251 37.747 84 83.996 84C130.249 168 168 130.251 168 84c0-46.254-37.751-84-84.004-84zm38.008 120.878c-1.497 2.452-4.703 3.215-7.149 1.717L80.986 99.59l-21.048 22.185a5.048 5.048 0 0 1-3.597 1.502 5.036 5.036 0 0 1-1.9-.374l2.8-24.889-43.023-37.197a5.047 5.047 0 0 1-1.536-5.445 5.043 5.043 0 0 1 4.461-3.391l56.301-5.152 22.368-51.898a5.044 5.044 0 0 1 4.638-3.088 5.044 5.044 0 0 1 4.638 3.088l22.368 51.898 56.301 5.152a5.043 5.043 0 0 1 4.462 3.391 5.044 5.044 0 0 1-1.537 5.445l-43.023 37.197 2.8 24.889a5.048 5.048 0 0 1-1.9.374 5.05 5.05 0 0 1-3.597-1.502l-21.048-22.185-33.869 23.005c-2.448 1.498-5.653.735-7.15-1.717z"
            ></path></svg
          >
          Spotify Podcasts
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor"
            ><path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path></svg
          >
          LinkedIn
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell mission-grid">
      <div class="index" aria-hidden="true">01</div>
      <div class="mission-copy">
        <p>
          Serious inquiry begins before certainty: with the discipline to separate evidence,
          interpretation, institutional narrative, and unresolved questions.
        </p>
        <p>
          This publication is being designed as a durable home for long-form essays, documentary
          research, and concise public explainers. Its purpose is not to reproduce party messaging,
          but to examine systems across ideological boundaries and make the reasoning visible.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Featured desk</p>
          <h2>Research & Essays</h2>
        </div>
        <p>
          Developing work on institutional power, political economy, technology, and public
          accountability.
        </p>
      </div>
      <div class="card-grid">
        {
          researchItems.map((item, index) => (
            <EditorialCard item={item} index={index + 1} sectionHref={sitePath("/research/")} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Long-form visual inquiry</p>
          <h2>Documentary Projects</h2>
        </div>
        <p>
          Proposed films and narrative investigations designed to connect evidence, historical
          context, and future consequences.
        </p>
      </div>
      <div class="card-grid">
        {
          documentaryItems.map((item, index) => (
            <EditorialCard
              item={item}
              index={index + 1}
              sectionHref={sitePath("/documentaries/")}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why This Matters CTA strip -->
  <section class="section cta-strip">
    <div class="shell cta-strip-inner">
      <div class="cta-strip-copy">
        <p class="eyebrow">The mission</p>
        <h2>Why this work matters.</h2>
        <p>
          Public institutions shape every dimension of life — but most coverage flattens the
          analysis. The Independent Observer is being built to make the full picture visible.
        </p>
      </div>
      <a class="button cta-strip-button" href={sitePath("/about/")}>Read the mission →</a>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Current formats</p>
          <h2>Latest Videos</h2>
        </div>
        <p>
          A preview catalogue for future shorts, explainers, and documentary releases. Publication
          links will replace these status labels when available.
        </p>
      </div>
      <div class="card-grid">
        {
          videoItems.map((item, index) => (
            <EditorialCard item={item} index={index + 1} sectionHref={sitePath("/videos/")} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Coverage</p>
          <h2>Six connected fields</h2>
        </div>
        <p>
          The editorial structure treats these subjects as interacting systems rather than isolated
          verticals.
        </p>
      </div>
      <div class="topics-grid">
        {
          topics.map((topic, index) => (
            <article class="topic">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{topic.name}</h3>
              <p>{topic.description}</p>
              <span class="topic-explore">Explore {topic.name} →</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="shell newsletter">
      <div>
        <p class="eyebrow">Field notes newsletter</p>
        <h2>Follow the work as it develops.</h2>
        <p>Occasional research notes, production updates, and new releases.</p>
      </div>
      <div class="newsletter-actions">
        <a
          class="button newsletter-mailto"
          href="mailto:hello@independentobserver.com?subject=Newsletter%20interest&body=Please%20add%20me%20to%20your%20field%20notes%20list."
        >
          Notify me when live →
        </a>
        <p class="form-note">
          Opens your email client — no form, no tracking. A proper newsletter list is coming.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

