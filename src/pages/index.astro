---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialCard from "../components/EditorialCard.astro";
import { documentaryItems, researchItems, topics, videoItems } from "../data/content";
import { ssrnPreprintDocuments } from "../data/ssrn";
import { seriesItems } from "../data/series";
import { sitePath } from "../lib/paths";
import { slugify } from "../lib/slugs";
import { socialLinks } from "../data/social";
import EvidenceLayer from "../components/EvidenceLayer.astro";
import HomepageVolumeGuide from "../components/HomepageVolumeGuide.astro";
import HomepageLiteratureShelf from "../components/HomepageLiteratureShelf.astro";
import { volumeTopicConnections } from "../../plugins/topic-discovery/catalog";

const volumeOneMethod = ssrnPreprintDocuments.find(
  (entry) => entry.id === "independent-observer-volume-one-ssrn",
);
const volumeOneMethodHref = volumeOneMethod
  ? sitePath(`/library/documents/${volumeOneMethod.id}/`)
  : sitePath("/library/");
const volumeOneSource = {
  label: "Read the Volume I public record",
  href: volumeOneMethodHref,
};
// The public Volume I SSRN record reports a dated usage signal; current access stays review-pending.
const highestDownloadDocument = [...ssrnPreprintDocuments]
  .filter((entry) => typeof entry.metrics?.downloads === "number")
  .sort((a, b) => (b.metrics?.downloads ?? 0) - (a.metrics?.downloads ?? 0))[0];
const heroVolumeLinks = seriesItems.map((item, index) => ({
  ...item,
  number: String(index + 1).padStart(2, "0"),
  href: sitePath(`/series/${slugify(item.title)}/`),
  lens: volumeTopicConnections[item.volume].lens,
}));
---

<BaseLayout
  title="Home"
  description="Independent Observer is an independent public home for reports, research, and documentary work examining power, institutions, history, political economy, science, and technology."
  currentPath="/"
>
  <section class="hero">
    <div class="shell hero-inner">
      <div>
        <p class="eyebrow">Independent analysis for a complex age</p>
        <h1>Observe the system.<br /><em>Question the frame.</em></h1>
        <p class="hero-summary">
          Independent Observer is a public research home for a four-volume inquiry into how people
          observe, inherit, contest, and reshape public systems. Volume I develops the
          method—source, record, context, contradiction, and limit—before a conclusion is accepted.
          Volume II follows sovereignty, migration, institutions, and power; Volume III follows
          work, taxation, welfare, and social citizenship; and Volume IV follows AI, infrastructure,
          intimacy, science, and human capability. Its public library connects these questions to
          reviewed SSRN reading copies and research maps drawn from a bounded public-safe archive.
        </p>
        <p class="hero-summary hero-summary-secondary">
          Its purpose is to keep the record, the interpretation, and the limits visible—so readers
          can follow how a public argument is made and revise it when the evidence changes.
        </p>
        <div class="hero-actions">
          <a class="button" href={sitePath("/research/")}>Explore the research</a>
          <a class="button button-secondary" href={sitePath("/about/")}>Read the mission</a>
        </div>
      </div>
      <aside class="hero-note" aria-labelledby="hero-note-title">
        <div class="hero-note-heading">
          <span>Public research index</span>
          <span class="hero-note-status">Open · 2026</span>
        </div>
        <h2 id="hero-note-title">Four volumes. One observing method.</h2>
        <p>
          Public previews and matched SSRN records make the developing work legible. Research
          published through SSRN, ResearchGate, and Zenodo enters this index only as reviewed,
          public-safe material. New research, revisions, and evidence continue to develop here;
          private drafts remain in the Dropbox working archive until human release review.
        </p>
        <dl class="hero-note-stats">
          <div>
            <dt>{seriesItems.length}</dt>
            <dd>volumes</dd>
          </div>
          <div>
            <dt>{topics.length}</dt>
            <dd>fields</dd>
          </div>
          <div>
            <dt>{ssrnPreprintDocuments.length}</dt>
            <dd>SSRN records</dd>
          </div>
        </dl>
        <nav class="hero-volume-nav" aria-label="Explore the four volumes">
          {
            heroVolumeLinks.map((volume) => (
              <a class="hero-volume-link" href={volume.href}>
                <span class="hero-volume-number">{volume.number}</span>
                <span class="hero-volume-copy">
                  <strong>{volume.title}</strong>
                  <span>{volume.lens}</span>
                </span>
                <span class="hero-volume-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          }
        </nav>
        {
          highestDownloadDocument && (
            <a
              class="hero-note-signal"
              href={sitePath(`/library/documents/${highestDownloadDocument.id}/`)}
            >
              <span>Highest retrieved SSRN usage signal</span>
              <strong>{highestDownloadDocument.title}</strong>
              <small>
                {highestDownloadDocument.metrics?.downloads ?? "—"} downloads · usage signal—not a
                quality rating
              </small>
            </a>
          )
        }
      </aside>
    </div>
    <div class="hero-watermark" aria-hidden="true">IO</div>
  </section>

  <!-- Social proof / platform bar -->
  <section class="platform-bar" aria-label="Publishing platforms">
    <div class="shell platform-bar-inner">
      <span class="platform-bar-label">Follow the work</span>
      <ul class="platform-list" role="list">
        {
          socialLinks.map((link) => (
            <li>
              <a href={link.href} rel="me noopener noreferrer" target="_blank">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell mission-grid">
      <div class="index" aria-hidden="true">01</div>
      <div class="mission-copy">
        <p>
          Volume I begins with a practical philosophy: observation comes before reaction. Before a
          public event becomes a claim, the record must be named—what happened, who recorded it,
          which terms define it, what the source cannot establish, and what remains unknown.
        </p>
        <p>
          Observation is not passive distance. The capacity to watch is shaped by time, money,
          safety, institutional access, and economic room. Independent Observer treats those
          conditions as part of the evidence: the observer, the record, the institution, and the
          limits of the account all remain visible.
        </p>
        <p>
          That discipline becomes the foundation for the rest of the series. Volume II follows power
          through sovereignty and institutions; Volume III follows work, welfare, taxation, and
          social citizenship; Volume IV follows automation, science, infrastructure, and human
          capability. The site is their public home, while the private working archive remains in
          Dropbox.
        </p>
      </div>
    </div>
  </section>

  <HomepageLiteratureShelf />

  <section class="section section-navy">
    <div class="shell newsletter">
      <div>
        <p class="eyebrow">Your independent archive</p>
        <h2>Reports remain under your control.</h2>
        <p>
          Dropbox is the working archive. This public site receives only reviewed, public-safe
          summaries, so your private files and unfinished evidence stay private.
        </p>
      </div>
      <div>
        <a class="button" href={sitePath("/library/")}>Open the public library →</a>
        <p class="form-note">
          The approved release queue is deliberately empty. Public previews and the reviewed library
          remain available while human release decisions are pending.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-white" aria-label="Find the public work">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Find your way in</p>
          <h2>Search the public work.</h2>
        </div>
        <p>
          Search the site from the masthead, or start with a desk, the public library, or one of the
          six coverage fields. Each topic is a lens on one of the four volumes, not a separate
          publication competing with the series.
        </p>
      </div>
      <div class="discovery-grid">
        <a class="discovery-card" href={sitePath("/library/")}>
          <span>01</span>
          <strong>Public Library</strong>
          <p>See the reviewed map of the research archive.</p>
        </a>
        <a class="discovery-card" href={sitePath("/research/")}>
          <span>02</span>
          <strong>Research &amp; Essays</strong>
          <p>Find concepts about law, institutions, labor, and power.</p>
        </a>
        <a class="discovery-card" href={sitePath("/documentaries/")}>
          <span>03</span>
          <strong>Documentary Projects</strong>
          <p>Browse visual investigations in development.</p>
        </a>
        <a class="discovery-card" href={sitePath("/videos/")}>
          <span>04</span>
          <strong>Videos</strong>
          <p>Explore explainers and future releases by subject.</p>
        </a>
        <a class="discovery-card discovery-card-accent" href={sitePath("/start/")}>
          <span>05</span>
          <strong>Start here</strong>
          <p>Choose a guided route by method, subject, or archive.</p>
        </a>
      </div>
      <div class="topic-links" aria-label="Browse coverage fields">
        {
          topics.map((topic) => (
            <a class="topic-link" href={sitePath("/topics/" + topic.name.toLowerCase() + "/")}>
              {topic.name}
            </a>
          ))
        }
      </div>
      <HomepageVolumeGuide />
      <p class="form-note">
        Tip: press <kbd>⌘</kbd><span aria-hidden="true">/</span><kbd>K</kbd> on Mac or
        <kbd>Ctrl</kbd><span aria-hidden="true">/</span><kbd>K</kbd> on Windows to open search.
      </p>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="homepage-evidence-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Read with the layers visible</p>
          <h2 id="homepage-evidence-title">A publication should show how it knows.</h2>
        </div>
        <p>
          Use the evidence-layer control to see the distinction the future article reader will
          preserve. Nothing is scored and no category replaces the full text.
        </p>
      </div>
      <EvidenceLayer
        blocks={[
          {
            category: "Documented fact",
            text: `The public Volume I SSRN record last directly reported ${volumeOneMethod?.metrics?.downloads ?? "—"} downloads and ${volumeOneMethod?.metrics?.abstractViews ?? "—"} abstract views on ${volumeOneMethod?.metrics?.checkedAt ?? "an earlier audit"}. These figures are usage signals, not a quality rating; current availability is review-pending.`,
            source: volumeOneSource,
          },
          {
            category: "Interpretation",
            text: "The foundation paper interprets information asymmetry and institutional design as part of political economy; it asks readers to inspect the record before accepting a conclusion.",
            source: volumeOneSource,
          },
          {
            category: "Hypothesis",
            text: "If the basis and limits of an argument are visible, public disagreement may become more correctable.",
            source: volumeOneSource,
          },
          {
            category: "Limitation",
            text: "This is a working paper, not peer review; the usage figures do not establish the method or prove a claim about any person or institution.",
            source: volumeOneSource,
          },
        ]}
      />
    </div>
  </section>

  <section class="section section-navy" aria-label="Distribution channels">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Help the work travel</p>
          <h2>Discover it where you already are.</h2>
        </div>
        <p>
          This site keeps the reports and public archive under its own control. Social channels help
          new readers find the work and lead them back to the fuller record.
        </p>
      </div>
      <div class="distribution-grid">
        {
          socialLinks.map((link) => (
            <a
              class="distribution-card"
              href={link.href}
              target="_blank"
              rel="me noopener noreferrer"
            >
              <strong>{link.label}</strong>
              <span>{link.description}</span>
              <span class="distribution-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Featured desk</p>
          <h2>Research &amp; Essays</h2>
        </div>
        <p>
          Developing work on institutional power, political economy, technology, and public
          accountability.
        </p>
      </div>
      <div class="card-grid">
        {
          researchItems.map((item, index) => (
            <EditorialCard item={item} index={index + 1} sectionHref={sitePath("/research/")} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Long-form visual inquiry</p>
          <h2>Documentary Projects</h2>
        </div>
        <p>
          Proposed films and narrative investigations designed to connect evidence, historical
          context, and future consequences.
        </p>
      </div>
      <div class="card-grid">
        {
          documentaryItems.map((item, index) => (
            <EditorialCard
              item={item}
              index={index + 1}
              sectionHref={sitePath("/documentaries/")}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why This Matters CTA strip -->
  <section class="section cta-strip">
    <div class="shell cta-strip-inner">
      <div class="cta-strip-copy">
        <p class="eyebrow">The mission</p>
        <h2>Why this work matters.</h2>
        <p>
          Public institutions shape every dimension of life — but most coverage flattens the
          analysis. Independent Observer is being built to make the full picture visible.
        </p>
      </div>
      <a class="button cta-strip-button" href={sitePath("/about/")}>Read the mission →</a>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Current formats</p>
          <h2>Latest Videos</h2>
        </div>
        <p>
          A preview catalogue for future shorts, explainers, and documentary releases. Publication
          links will replace these status labels when available.
        </p>
      </div>
      <div class="card-grid">
        {
          videoItems.map((item, index) => (
            <EditorialCard item={item} index={index + 1} sectionHref={sitePath("/videos/")} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Coverage</p>
          <h2>Six connected fields</h2>
        </div>
        <p>
          The editorial structure treats these subjects as interacting systems rather than isolated
          verticals.
        </p>
      </div>
      <div class="topics-grid">
        {
          topics.map((topic, index) => (
            <article class="topic" id={"topic-" + topic.name.toLowerCase()}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{topic.name}</h3>
              <p>{topic.description}</p>
              <span class="topic-explore" aria-hidden="true">
                Coverage area
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-navy" aria-label="Newsletter preview">
    <div class="shell newsletter">
      <div>
        <p class="eyebrow">Independent publishing</p>
        <h2>No algorithm required.</h2>
        <p>
          Read the reports and public summaries directly from this site. No social account,
          subscription, or tracking service is required to access the work.
        </p>
      </div>
      <div>
        <a class="button" href={sitePath("/library/")}>Read reports &amp; summaries →</a>
        <p class="form-note">
          A quiet public home for the work, with a clear boundary around the private archive.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
