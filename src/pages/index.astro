---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialCard from "../components/EditorialCard.astro";
import { documentaryItems, researchItems, topics, videoItems } from "../data/content";
import { dropboxFeedItems } from "../data/dropbox-content.generated";
import { sitePath } from "../lib/paths";
import { socialLinks } from "../data/social";

const feedCount = dropboxFeedItems.length;
---

<BaseLayout
  title="Home"
  description="Independent Observer is an independent public home for reports, research, and documentary work examining power, institutions, history, political economy, science, and technology."
  currentPath="/"
>
  <section class="hero">
    <div class="shell hero-inner">
      <div>
        <p class="eyebrow">Independent analysis for a complex age</p>
        <h1>Observe the system.<br /><em>Question the frame.</em></h1>
        <p class="hero-summary">
          Independent Observer is an independent public home for reports, research, and documentary
          work that examines how history, institutions, political economy, science, and technology
          shape public life.
        </p>
        <div class="hero-actions">
          <a class="button" href={sitePath("/research/")}>Explore the research</a>
          <a class="button button-secondary" href={sitePath("/about/")}>Read the mission</a>
        </div>
      </div>
      <aside class="hero-note" aria-label="Editorial status">
        <span>Editorial status</span>
        <p>
          Public archive in progress. Reports appear only after they are explicitly reviewed for
          public release; working material remains in Dropbox.
        </p>
      </aside>
    </div>
    <div class="hero-watermark" aria-hidden="true">IO</div>
  </section>

  <!-- Social proof / platform bar -->
  <section class="platform-bar" aria-label="Publishing platforms">
    <div class="shell platform-bar-inner">
      <span class="platform-bar-label">Follow the work</span>
      <ul class="platform-list" role="list">
        {
          socialLinks.map((link) => (
            <li>
              <a href={link.href} rel="me noopener noreferrer" target="_blank">{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell mission-grid">
      <div class="index" aria-hidden="true">01</div>
      <div class="mission-copy">
        <p>
          Serious inquiry begins before certainty: with the discipline to separate evidence,
          interpretation, institutional narrative, and unresolved questions.
        </p>
        <p>
          This site is a durable public home for long-form essays, documentary research, and concise
          public explainers. It is independent of social-platform feeds, while its private working
          archive remains in Dropbox.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="shell newsletter">
      <div>
        <p class="eyebrow">Your independent archive</p>
        <h2>Reports remain under your control.</h2>
        <p>
          Dropbox is the working archive. This public site receives only reviewed, public-safe
          summaries, so your private files and unfinished evidence stay private.
        </p>
      </div>
      <div>
        <a class="button" href={sitePath("/library/")}>Open the public library →</a>
        <p class="form-note">
          {feedCount} approved report {feedCount === 1 ? "card is" : "cards are"} currently in the public
          feed.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-white" aria-label="Find the public work">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Find your way in</p>
          <h2>Search the public work.</h2>
        </div>
        <p>
          Search the site from the masthead, or start with a desk, the public library, or one of the
          six coverage fields below.
        </p>
      </div>
      <div class="discovery-grid">
        <a class="discovery-card" href={sitePath("/library/")}>
          <span>01</span>
          <strong>Public Library</strong>
          <p>See the reviewed map of the research archive.</p>
        </a>
        <a class="discovery-card" href={sitePath("/research/")}>
          <span>02</span>
          <strong>Research &amp; Essays</strong>
          <p>Find concepts about law, institutions, labor, and power.</p>
        </a>
        <a class="discovery-card" href={sitePath("/documentaries/")}>
          <span>03</span>
          <strong>Documentary Projects</strong>
          <p>Browse visual investigations in development.</p>
        </a>
        <a class="discovery-card" href={sitePath("/videos/")}>
          <span>04</span>
          <strong>Videos</strong>
          <p>Explore explainers and future releases by subject.</p>
        </a>
      </div>
      <div class="topic-links" aria-label="Browse coverage fields">
        {
          topics.map((topic) => (
            <a class="topic-link" href={sitePath("/#topic-" + topic.name.toLowerCase())}>
              {topic.name}
            </a>
          ))
        }
      </div>
      <p class="form-note">
        Tip: press <kbd>⌘</kbd><span aria-hidden="true">/</span><kbd>K</kbd> on Mac or
        <kbd>Ctrl</kbd><span aria-hidden="true">/</span><kbd>K</kbd> on Windows to open search.
      </p>
    </div>
  </section>

  <section class="section section-navy" aria-label="Distribution channels">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Help the work travel</p>
          <h2>Discover it where you already are.</h2>
        </div>
        <p>
          This site keeps the reports and public archive under its own control. Social channels help
          new readers find the work and lead them back to the fuller record.
        </p>
      </div>
      <div class="distribution-grid">
        {
          socialLinks.map((link) => (
            <a
              class="distribution-card"
              href={link.href}
              target="_blank"
              rel="me noopener noreferrer"
            >
              <strong>{link.label}</strong>
              <span>{link.description}</span>
              <span class="distribution-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Featured desk</p>
          <h2>Research &amp; Essays</h2>
        </div>
        <p>
          Developing work on institutional power, political economy, technology, and public
          accountability.
        </p>
      </div>
      <div class="card-grid">
        {
          researchItems.map((item, index) => (
            <EditorialCard item={item} index={index + 1} sectionHref={sitePath("/research/")} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Long-form visual inquiry</p>
          <h2>Documentary Projects</h2>
        </div>
        <p>
          Proposed films and narrative investigations designed to connect evidence, historical
          context, and future consequences.
        </p>
      </div>
      <div class="card-grid">
        {
          documentaryItems.map((item, index) => (
            <EditorialCard
              item={item}
              index={index + 1}
              sectionHref={sitePath("/documentaries/")}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why This Matters CTA strip -->
  <section class="section cta-strip">
    <div class="shell cta-strip-inner">
      <div class="cta-strip-copy">
        <p class="eyebrow">The mission</p>
        <h2>Why this work matters.</h2>
        <p>
          Public institutions shape every dimension of life — but most coverage flattens the
          analysis. Independent Observer is being built to make the full picture visible.
        </p>
      </div>
      <a class="button cta-strip-button" href={sitePath("/about/")}>Read the mission →</a>
    </div>
  </section>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Current formats</p>
          <h2>Latest Videos</h2>
        </div>
        <p>
          A preview catalogue for future shorts, explainers, and documentary releases. Publication
          links will replace these status labels when available.
        </p>
      </div>
      <div class="card-grid">
        {
          videoItems.map((item, index) => (
            <EditorialCard item={item} index={index + 1} sectionHref={sitePath("/videos/")} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Coverage</p>
          <h2>Six connected fields</h2>
        </div>
        <p>
          The editorial structure treats these subjects as interacting systems rather than isolated
          verticals.
        </p>
      </div>
      <div class="topics-grid">
        {
          topics.map((topic, index) => (
            <article class="topic" id={"topic-" + topic.name.toLowerCase()}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{topic.name}</h3>
              <p>{topic.description}</p>
              <span class="topic-explore" aria-hidden="true">Coverage area</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-navy" aria-label="Newsletter preview">
    <div class="shell newsletter">
      <div>
        <p class="eyebrow">Independent publishing</p>
        <h2>No algorithm required.</h2>
        <p>
          Read the reports and public summaries directly from this site. No social account,
          subscription, or tracking service is required to access the work.
        </p>
      </div>
      <div>
        <a class="button" href={sitePath("/library/")}>Read reports &amp; summaries →</a>
        <p class="form-note">
          A quiet public home for the work, with a clear boundary around the private archive.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

