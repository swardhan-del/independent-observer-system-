---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ResearchCatalogue from "../../components/ResearchCatalogue.astro";
import { sitePath } from "../../lib/paths";
---

<BaseLayout
  title="Research & Essays"
  description="Explore research questions across the four volumes. Find working-paper summaries, source records and clearly labeled projects in development."
  currentPath="/research/"
>
  <PageHero
    eyebrow="Research desk"
    title="Research & Essays"
    description="Essays, concepts, and current work: explore the research behind the four volumes. Browse working-paper summaries and concepts in development; each entry explains what you can read now."
  />

  <section class="section section-rule" aria-labelledby="anonymized-case-studies-title">
    <div class="shell page-grid">
      <aside class="page-aside">Anonymized case studies</aside>
      <div class="prose">
        <h2 id="anonymized-case-studies-title">Institutional process without identifying the university</h2>
        <p>
          These public adaptations preserve the analytical questions while withholding the institution
          name, individual identities, case numbers, private contact details, direct quotations, and
          other case-specific identifiers. The complete evidentiary record is not hosted on these pages.
        </p>
        <div class="principles">
          <div class="principle">
            <span>01</span><div>
              <h3>
                <a href={sitePath("/research/administrative-obstruction-medical-education/")}>
                  Administrative Obstruction in European Medical Education
                </a>
              </h3>
              <p>
                Registration status, practical access, written rules, and effective student-remedy pathways.
              </p>
            </div>
          </div>
          <div class="principle">
            <span>02</span><div>
              <h3>
                <a href={sitePath("/research/cross-border-academic-obstruction-monitoring/")}>
                  Cross-Border Acknowledgment of Academic Obstruction
                </a>
              </h3>
              <p>
                A process study separating submission, receipt, referral, and substantive findings across oversight bodies.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ResearchCatalogue />
  <section class="section section-rule">
    <div class="shell page-grid">
      <aside class="page-aside">Editorial method</aside>
      <div class="prose">
        <h2>What a finished research entry should contain</h2>
        <p>
          Each publication is intended to include a clear thesis, sourced factual foundation,
          counterarguments, limitations, and a distinction between documented findings and the
          author’s interpretation.
        </p>
        <div class="principles">
          <div class="principle">
            <span>01</span><div>
              <h3>Traceable evidence</h3><p>
                Readers should be able to identify the basis of every material factual claim.
              </p>
            </div>
          </div>
          <div class="principle">
            <span>02</span><div>
              <h3>Fair counterarguments</h3><p>
                Strong opposing explanations should be represented accurately before they are
                evaluated.
              </p>
            </div>
          </div>
          <div class="principle">
            <span>03</span><div>
              <h3>Visible uncertainty</h3><p>
                Gaps, inference, and unresolved questions should be labeled rather than hidden.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
