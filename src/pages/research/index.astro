---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentFilter from "../../components/ContentFilter.astro";
import PageHero from "../../components/PageHero.astro";
import EditorialCard from "../../components/EditorialCard.astro";
import { researchItems } from "../../data/content";
import { sitePath } from "../../lib/paths";
import { slugify } from "../../lib/slugs";
import { ssrnPreprintDocuments } from "../../data/ssrn";
---

<BaseLayout
  title="Research & Essays"
  description="Developing research and long-form essays from Independent Observer."
  currentPath="/research/"
>
  <PageHero
    eyebrow="Research desk"
    title="Research & Essays"
    description="Long-form analysis designed to show its evidence, distinguish argument from fact, and identify what remains uncertain."
  />
  <section class="section section-white">
    <div class="shell">
      <h2 class="sr-only">Research and essay previews</h2>
      <div class="placeholder-notice">
        These entries are editorial previews. Full articles, citations, dates, and publication links
        will be added only after verification and review.
      </div>
      <ContentFilter targetId="research-preview-grid" itemCount={researchItems.length} />
      <div class="card-grid" id="research-preview-grid">
        {
          researchItems.map((item, index) => (
            <EditorialCard
              item={item}
              index={index + 1}
              href={sitePath(`/research/${slugify(item.title)}/`)}
            />
          ))
        }
      </div>
    </div>
  </section>
  <section class="section section-navy" aria-labelledby="ssrn-preprints-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Preprint shelf</p>
          <h2 id="ssrn-preprints-title">Public SSRN-linked articles.</h2>
        </div>
        <p>
          These entries are curated from matching Dropbox preprint controllers and public SSRN
          records. They are labeled preprints, not peer-reviewed Independent Observer publications.
        </p>
      </div>
      <div class="card-grid">
        {
          ssrnPreprintDocuments.map((entry, index) => (
            <article class="editorial-card ssrn-feature-card">
              <div class="card-meta">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span>{entry.category}</span>
              </div>
              <h3>
                <a class="card-title-link" href={sitePath(`/library/documents/${entry.id}/`)}>
                  {entry.title}
                </a>
              </h3>
              <p>{entry.description}</p>
              <div class="card-footer">
                <span class="status-pill">{entry.status}</span>
                <span>{entry.metrics?.downloads ?? "—"} downloads</span>
                <a class="card-open-link" href={sitePath(`/library/documents/${entry.id}/`)}>
                  Open reading copy →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section section-rule">
    <div class="shell page-grid">
      <aside class="page-aside">Editorial method</aside>
      <div class="prose">
        <h2>What a finished research entry should contain</h2>
        <p>
          Each publication is intended to include a clear thesis, sourced factual foundation,
          counterarguments, limitations, and a distinction between documented findings and the
          author’s interpretation.
        </p>
        <div class="principles">
          <div class="principle">
            <span>01</span><div>
              <h3>Traceable evidence</h3><p>
                Readers should be able to identify the basis of every material factual claim.
              </p>
            </div>
          </div>
          <div class="principle">
            <span>02</span><div>
              <h3>Fair counterarguments</h3><p>
                Strong opposing explanations should be represented accurately before they are
                evaluated.
              </p>
            </div>
          </div>
          <div class="principle">
            <span>03</span><div>
              <h3>Visible uncertainty</h3><p>
                Gaps, inference, and unresolved questions should be labeled rather than hidden.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
