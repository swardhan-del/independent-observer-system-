---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialDetail from "../../components/EditorialDetail.astro";
import { researchItems } from "../../data/content";
import { slugify } from "../../lib/slugs";
import { sitePath } from "../../lib/paths";

export function getStaticPaths() {
  return researchItems.map((item) => ({
    params: { slug: slugify(item.title) },
    props: { item },
  }));
}

const { item } = Astro.props;
const currentPath = `/research/${slugify(item.title)}/`;
---

<BaseLayout title={item.title} description={item.description} currentPath={currentPath}>
  <EditorialDetail
    item={item}
    eyebrow="Research preview"
    backLabel="Back to research"
    backHref={sitePath("/research/")}
    statusNote="This is a public editorial preview. Full articles, citations, dates, and publication links will appear only after verification and review."
  />
</BaseLayout>
