---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { releaseLog } from "../../data/release-log";
import {
  releaseCandidatePresentations,
  sixCandidateReleaseQueue,
} from "../../data/publication-registry";
import { sitePath } from "../../lib/paths";

const volumeOrder = {
  "Volume I": 1,
  "Volume II": 2,
  "Volume III": 3,
  "Volume IV": 4,
} as const;

const orderedReleaseCandidates = [...sixCandidateReleaseQueue].sort(
  (left, right) => volumeOrder[left.volume] - volumeOrder[right.volume],
);
---

<BaseLayout
  title="What’s New"
  description="A dated release log for approved Independent Observer publications."
  currentPath="/whats-new/"
>
  <PageHero
    eyebrow="Release log"
    title="What’s new, when it is real."
    description="This log records owner-approved releases that have passed the publication path. Staged candidates and external preprints stay in their own status lanes."
  />
  <section class="section section-white" aria-labelledby="release-log-title">
    <div class="shell">
      <div class="release-log-empty" data-release-log-empty hidden={releaseLog.length > 0}>
        <p class="eyebrow">Release desk · human approval lane</p>
        <h2 id="release-log-title">The release log is intentionally empty—for now.</h2>
        <span class="sr-only">The release log is intentionally empty.</span>
        <p>
          The six current candidates remain awaiting human release. They are visible below so the
          project has a clear public record of what is being prepared. Their metadata can be
          reviewed in the controlled registry, but no item is represented here as a released
          publication until its source, rights, quality, and human release gates are complete.
        </p>
        <p class="release-candidate-boundary">
          Each entry has a public-safe description and one controlled reading route. A route opens a
          verified public record, a volume brief, or a public companion; it does not expose working
          files or change the release status of the candidate.
        </p>
        <ol class="release-candidate-list">
          {
            orderedReleaseCandidates.map((entry, index) => (
              <li class="release-candidate-card" id={`release-candidate-${entry.id}`}>
                <div class="release-candidate-card-meta">
                  <span class="release-candidate-index">{String(index + 1).padStart(2, "0")}</span>
                  <span>{entry.volume}</span>
                </div>
                <strong>{entry.title}</strong>
                <p class="release-candidate-description">
                  {releaseCandidatePresentations[entry.id].description}
                </p>
                <div class="release-candidate-card-footer">
                  <div class="release-candidate-footer-meta">
                    <small>{entry.topics.join(" · ")}</small>
                    <span class="release-candidate-status">Awaiting human release</span>
                  </div>
                  <a
                    href={sitePath(releaseCandidatePresentations[entry.id].publicRoute)}
                    class="release-candidate-link"
                  >
                    {releaseCandidatePresentations[entry.id].linkLabel}
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
        <a class="button button-secondary" href={sitePath("/library/")}
          >Explore the public library →</a
        >
      </div>
      {
        releaseLog.length > 0 && (
          <ol class="release-log" aria-labelledby="release-log-title">
            {releaseLog.map((entry) => (
              <li>
                <time datetime={entry.date}>{entry.date}</time>
                <h2 id="release-log-title">
                  <a href={sitePath(entry.route)}>{entry.title}</a>
                </h2>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</BaseLayout>
