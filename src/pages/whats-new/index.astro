---
import { siteUpdates } from "../../data/site-updates";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { sitePath } from "../../lib/paths";
---

<BaseLayout
  title="Site Changelog"
  description="Technical and reader-experience changes to the Independent Observer website. Research releases and publication revisions are listed separately on the Latest page."
  currentPath="/whats-new/"
>
  <PageHero
    eyebrow="Site changelog"
    title="Website and reader-tool changes."
    description="This page records interface, reading, listening, and search improvements. For new research and publication updates, use the Latest page."
  />
  <section class="section section-white">
    <div class="shell prose">
      <p><a class="button" href={sitePath("/latest/")}>See latest research →</a></p>
    </div>
  </section>
  <section class="section section-white" aria-labelledby="website-updates-title">
    <div class="shell prose">
      <h2 id="website-updates-title">Website improvements</h2>
      <p>
        This log is limited to website and reader-tool changes. Research releases, corrections, and
        work in development are maintained on the separate Latest page.
      </p>
      {
        siteUpdates.map((update) => (
          <article id={update.id}>
            <>
              <time datetime={update.date}>{update.date}</time>
              <h3>{update.title}</h3>
            </>
            <ul>
              {update.changes.map((change) => (
                <li>
                  <p>
                    <strong>{change.what}</strong> {change.why}{" "}
                    <a href={sitePath(change.route)}>{change.label} →</a>
                  </p>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
      <p>
        <a href={sitePath("/contact/")}>Report a website issue →</a>
      </p>
    </div>
  </section>
</BaseLayout>
