---
export type MechanismStep = { label: string; text: string };
type Props = { steps: MechanismStep[] };
const { steps } = Astro.props as Props;
---

<ol class="mechanism-diagram" aria-label="Mechanism diagram">
  {
    steps.map((step, index) => (
      <li>
        <span class="mechanism-number">{String(index + 1).padStart(2, "0")}</span>
        <strong>{step.label}</strong>
        <p>{step.text}</p>
      </li>
    ))
  }
</ol>
