---
type Props = {
  targetId: string;
  itemCount: number;
};

const { targetId, itemCount } = Astro.props;
const controlId = targetId + "-query";
---

<div class="content-controls" data-content-filter data-target={targetId}>
  <div class="content-filter-search">
    <label for={controlId}>Filter this preview desk</label>
    <input
      id={controlId}
      data-filter-query
      type="search"
      autocomplete="off"
      placeholder="Search titles or subjects"
    />
  </div>
  <div class="filter-statuses" role="group" aria-label="Filter by editorial status">
    <button type="button" data-filter-status="all" aria-pressed="true">All</button>
    <button type="button" data-filter-status="concept preview" aria-pressed="false">
      Concept preview
    </button>
    <button type="button" data-filter-status="in editorial development" aria-pressed="false">
      In development
    </button>
  </div>
  <div class="filter-actions">
    <p class="filter-count" data-filter-count role="status">
      {itemCount}
      {itemCount === 1 ? "preview" : "previews"} shown
    </p>
    <button class="filter-reset" type="button" data-filter-reset hidden>Reset filters</button>
  </div>
  <p class="filter-empty" data-filter-empty hidden>No previews match this filter.</p>
</div>

<script>
  import { normalizeSearchText } from "../lib/search";

  document.querySelectorAll<HTMLElement>("[data-content-filter]").forEach((root) => {
    const target = document.getElementById(root.dataset.target ?? "");
    const queryInput = root.querySelector<HTMLInputElement>("[data-filter-query]");
    const count = root.querySelector<HTMLElement>("[data-filter-count]");
    const empty = root.querySelector<HTMLElement>("[data-filter-empty]");
    const reset = root.querySelector<HTMLButtonElement>("[data-filter-reset]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter-status]")];
    const cards = target ? [...target.querySelectorAll<HTMLElement>("[data-filter-card]")] : [];

    if (!queryInput || !count || !empty || !reset || !cards.length) return;

    let activeStatus = "all";

    const syncUrl = () => {
      const url = new URL(window.location.href);
      const query = queryInput.value.trim();

      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");

      if (activeStatus !== "all") url.searchParams.set("status", activeStatus);
      else url.searchParams.delete("status");

      window.history.replaceState(
        null,
        "",
        url.pathname + (url.search ? url.search : "") + url.hash,
      );
    };

    const setActiveButton = () => {
      for (const candidate of buttons) {
        candidate.setAttribute(
          "aria-pressed",
          String(candidate.dataset.filterStatus === activeStatus),
        );
      }
    };

    const update = (writeUrl = true) => {
      const query = normalizeSearchText(queryInput.value);
      const terms = query.split(" ").filter(Boolean);
      let visible = 0;

      for (const card of cards) {
        const text = card.dataset.searchText ?? "";
        const status = card.dataset.status ?? "";
        const normalizedText = normalizeSearchText(text);
        const matchesQuery =
          !terms.length || terms.every((term) => normalizedText.split(" ").includes(term));
        const matchesStatus = activeStatus === "all" || status === activeStatus;
        const isVisible = matchesQuery && matchesStatus;

        card.hidden = !isVisible;
        if (isVisible) visible += 1;
      }

      count.textContent = visible + (visible === 1 ? " preview shown" : " previews shown");
      empty.hidden = visible !== 0;
      reset.hidden = !query && activeStatus === "all";
      if (writeUrl) syncUrl();
    };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        activeStatus = button.dataset.filterStatus ?? "all";
        setActiveButton();
        update();
      });
    }

    queryInput.addEventListener("input", () => update());

    reset.addEventListener("click", () => {
      queryInput.value = "";
      activeStatus = "all";
      setActiveButton();
      update();
      queryInput.focus();
    });

    const applyUrlState = () => {
      const params = new URLSearchParams(window.location.search);
      const requestedStatus = params.get("status") ?? "all";

      queryInput.value = params.get("q") ?? "";
      activeStatus = buttons.some((button) => button.dataset.filterStatus === requestedStatus)
        ? requestedStatus
        : "all";
      setActiveButton();
      update(false);
    };

    window.addEventListener("popstate", applyUrlState);
    applyUrlState();
  });
</script>
