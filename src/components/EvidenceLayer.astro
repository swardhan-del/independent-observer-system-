---
export type EvidenceCategory =
  | "Documented fact"
  | "Interpretation"
  | "Hypothesis"
  | "Policy proposal"
  | "Limitation"
  | "Counterargument"
  | "Unresolved question";

export type EvidenceBlock = {
  category: EvidenceCategory;
  text: string;
  source?: {
    label: string;
    href: string;
  };
};

type Props = {
  blocks: EvidenceBlock[];
};

const { blocks } = Astro.props as Props;
---

<section class="evidence-layer" data-evidence-layer aria-labelledby="evidence-layer-title">
  <div class="evidence-layer-heading">
    <div>
      <p class="eyebrow">Reader control</p>
      <h2 id="evidence-layer-title">Evidence layer</h2>
    </div>
    <p>Highlighting is a reading aid, not a credibility score. The full text remains visible.</p>
  </div>
  <div class="evidence-controls" role="group" aria-label="Highlight evidence categories">
    <button type="button" data-evidence-filter="all" aria-pressed="true">All layers</button>
    {
      blocks.map((block) => (
        <button type="button" data-evidence-filter={block.category} aria-pressed="false">
          {block.category}
        </button>
      ))
    }
  </div>
  <div class="evidence-blocks">
    {
      blocks.map((block) => (
        <article class="evidence-block" data-evidence-category={block.category}>
          <span class="evidence-label">{block.category}</span>
          <p>{block.text}</p>
          {block.source && (
            <a class="evidence-source" data-evidence-source href={block.source.href}>
              {block.source.label} <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-evidence-layer]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-evidence-filter]")];
    const blocks = [...root.querySelectorAll<HTMLElement>("[data-evidence-category]")];
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.evidenceFilter ?? "all";
        buttons.forEach((candidate) =>
          candidate.setAttribute("aria-pressed", String(candidate === button)),
        );
        blocks.forEach((block) =>
          block.classList.toggle(
            "is-highlighted",
            filter === "all" || block.dataset.evidenceCategory === filter,
          ),
        );
      });
    });
  });
</script>
