---
import type { TopicPathway } from "../../plugins/topic-discovery/catalog";
import { topicPluginFor } from "../../plugins/topic-discovery/catalog";
import { seriesItems } from "../data/series";
import { sitePath } from "../lib/paths";
import { slugify } from "../lib/slugs";

type Props = {
  pathways: TopicPathway[];
};

const { pathways } = Astro.props as Props;
---

<section class="section section-navy topic-pathways" aria-labelledby="topic-pathways-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Start with a question</p>
        <h2 id="topic-pathways-title">Five questions across four volumes.</h2>
      </div>
      <p>
        Choose a question, then follow it into the volumes and topic hubs where the work is
        organized. These are routes through public previews and preprints, not claims that
        unfinished work is a finished Independent Observer publication.
      </p>
    </div>
    <div class="topic-pathway-grid">
      {
        pathways.map((pathway, index) => (
          <article class="topic-pathway-card">
            <div class="card-meta">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span>{pathway.label}</span>
            </div>
            <h3>{pathway.question}</h3>
            <p>{pathway.description}</p>
            <div class="topic-pathway-links" aria-label={`${pathway.label} topics`}>
              {pathway.topicSlugs.map((slug) => {
                const topic = topicPluginFor(slug);
                return <a href={sitePath(`/topics/${slug}/`)}>{topic.name}</a>;
              })}
            </div>
            <div class="topic-pathway-volumes" aria-label={`${pathway.label} relevant volumes`}>
              <span class="topic-pathway-subhead">Relevant volumes</span>
              <div class="topic-pathway-volume-links">
                {pathway.volumeLabels.map((volumeLabel) => {
                  const volume = seriesItems.find((item) => item.volume === volumeLabel);
                  if (!volume) return null;
                  return (
                    <a href={sitePath(`/series/${slugify(volume.title)}/`)}>
                      <span>{volumeLabel}</span>
                      {volume.title}
                    </a>
                  );
                })}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
