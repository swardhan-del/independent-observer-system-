---
import type { EvidenceRecord, EvidenceKind } from "../data/curated-publications";

type Props = {
  evidence: EvidenceRecord[];
  title?: string;
};

const { evidence, title = "Evidence explorer" } = Astro.props as Props;
const labels: Record<EvidenceKind, string> = {
  documented: "Documented fact",
  interpretation: "Author interpretation",
  proposition: "Testable proposition",
  limitation: "Limitation",
};
const kinds: EvidenceKind[] = ["documented", "interpretation", "proposition", "limitation"];
---

<section class="evidence-explorer" data-evidence-explorer aria-labelledby="evidence-explorer-title">
  <div class="evidence-explorer-heading">
    <div>
      <p class="eyebrow">Claim-to-source map</p>
      <h2 id="evidence-explorer-title">{title}</h2>
    </div>
    <p>
      Switch between documented material, interpretation, propositions, and limitations. These
      labels describe the role a statement plays; they do not assign a numerical confidence score.
    </p>
  </div>
  <div class="evidence-explorer-controls" data-evidence-controls hidden>
    <button type="button" data-evidence-filter="all" aria-pressed="true">All</button>
    {
      kinds.map((kind) => (
        <button type="button" data-evidence-filter={kind}>
          {labels[kind]}
        </button>
      ))
    }
  </div>
  <p class="evidence-explorer-status" data-evidence-status role="status" aria-live="polite">
    Showing {evidence.length} evidence notes.
  </p>
  <ol class="evidence-explorer-list">
    {
      evidence.map((item, index) => (
        <li data-evidence-item data-evidence-kind={item.kind}>
          <div class="evidence-explorer-topline">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{labels[item.kind]}</strong>
          </div>
          <h3>{item.label}</h3>
          <p>{item.claim}</p>
          {item.sourceHref && item.sourceLabel && (
            <a href={item.sourceHref} target="_blank" rel="noopener noreferrer">
              Source: {item.sourceLabel} ↗
            </a>
          )}
        </li>
      ))
    }
  </ol>
  <noscript><p>All evidence notes remain visible when JavaScript is disabled.</p></noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-evidence-explorer]").forEach((root) => {
    const controls = root.querySelector<HTMLElement>("[data-evidence-controls]");
    const status = root.querySelector<HTMLElement>("[data-evidence-status]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-evidence-filter]")];
    const items = [...root.querySelectorAll<HTMLElement>("[data-evidence-item]")];
    if (!controls || !status || !buttons.length || !items.length) return;
    controls.hidden = false;
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.evidenceFilter ?? "all";
        let visible = 0;
        items.forEach((item) => {
          const matched = filter === "all" || item.dataset.evidenceKind === filter;
          item.hidden = !matched;
          if (matched) visible++;
        });
        buttons.forEach((candidate) =>
          candidate.setAttribute("aria-pressed", String(candidate === button)),
        );
        status.textContent = `Showing ${visible} evidence ${visible === 1 ? "note" : "notes"}.`;
      });
    });
  });
</script>

<style>
  .evidence-explorer {
    margin-block: 3rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-top: 4px solid var(--gold);
    background: var(--paper);
  }
  .evidence-explorer-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.65fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .evidence-explorer-heading h2 {
    margin: 0;
    color: var(--navy-950);
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }
  .evidence-explorer-heading > p {
    margin: 0;
    color: var(--slate-700);
  }
  .evidence-explorer-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .evidence-explorer-controls[hidden] {
    display: none;
  }
  .evidence-explorer-controls button {
    min-height: 40px;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line-strong);
    background: var(--white);
    color: var(--navy-900);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .evidence-explorer-controls button:hover,
  .evidence-explorer-controls button[aria-pressed="true"] {
    border-color: var(--navy-900);
    background: var(--navy-900);
    color: var(--white);
  }
  .evidence-explorer-status {
    margin: 0.85rem 0 0;
    color: var(--slate-500);
    font-size: 0.78rem;
  }
  .evidence-explorer-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 1.25rem 0 0;
    padding: 1px;
    background: var(--line);
    list-style: none;
  }
  .evidence-explorer-list li {
    min-width: 0;
    padding: 1.25rem;
    background: var(--white);
  }
  .evidence-explorer-list li[hidden] {
    display: none;
  }
  .evidence-explorer-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--gold-ink);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .evidence-explorer-list h3 {
    margin: 1rem 0 0.55rem;
    color: var(--navy-900);
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.1;
  }
  .evidence-explorer-list p {
    margin: 0;
    color: var(--slate-700);
    font-size: 0.9rem;
  }
  .evidence-explorer-list a {
    display: inline-block;
    margin-top: 1rem;
    color: var(--navy-700);
    font-size: 0.76rem;
    font-weight: 800;
  }
  @media (max-width: 720px) {
    .evidence-explorer-heading,
    .evidence-explorer-list {
      grid-template-columns: 1fr;
    }
  }
</style>
