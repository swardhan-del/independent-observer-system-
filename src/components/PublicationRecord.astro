---
import { citationDate } from "../lib/citations";
import { publicSitePath, sitePath } from "../lib/paths";

type Props = {
  title: string;
  author: string;
  status: string;
  publicationDate?: string;
  dateLabel?: string;
  lastReviewedDate?: string;
  version?: string;
  revisionCount?: number;
  revisionHistoryHref?: string;
  reuseNotice?: string;
};

const {
  title,
  author,
  status,
  publicationDate,
  dateLabel = "Published",
  lastReviewedDate,
  version,
  revisionCount = 0,
  revisionHistoryHref,
  reuseNotice,
} = Astro.props as Props;

const citationPublicationDate = citationDate(publicationDate);
const buildBasePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalPathname =
  buildBasePath && Astro.url.pathname.startsWith(`${buildBasePath}/`)
    ? Astro.url.pathname.slice(buildBasePath.length)
    : Astro.url.pathname;
const canonicalPageUrl = new URL(publicSitePath(canonicalPathname), Astro.site ?? Astro.url.origin)
  .href;
const suggestedCitation = citationPublicationDate
  ? `${author}. “${title}.” Independent Observer, ${publicationDate}.${version ? ` ${version}.` : ""} ${canonicalPageUrl}`
  : undefined;
const revisionLabel =
  revisionCount === 1 ? "1 recorded revision" : `${revisionCount} recorded revisions`;
---

<aside class="publication-record" aria-label="Publication record">
  <p class="eyebrow">Publication record</p>
  <dl>
    <div><dt>Status</dt><dd>{status}</dd></div>
    <div><dt>Author</dt><dd>{author}</dd></div>
    {
      publicationDate && (
        <div>
          <>
            <dt>{dateLabel}</dt>
            <dd>{publicationDate}</dd>
          </>
        </div>
      )
    }
    {
      lastReviewedDate && (
        <div>
          <>
            <dt>Last reviewed</dt>
            <dd>{lastReviewedDate}</dd>
          </>
        </div>
      )
    }
    {
      version && (
        <div>
          <>
            <dt>Version</dt>
            <dd>{version}</dd>
          </>
        </div>
      )
    }
  </dl>
  <p>
    <a href={revisionHistoryHref ?? sitePath("/latest/#latest-revisions-title")}>
      Revision history: {revisionLabel} →
    </a>
  </p>
  <p>
    {reuseNotice ?? "Reuse follows the item-specific notice where one is provided."} Read the{" "}
    <a href={sitePath("/governance/#copyright-and-reuse")}>reuse policy</a>.
  </p>
  {
    suggestedCitation ? (
      <details>
        <summary>Cite this page</summary>
        <p>{suggestedCitation}</p>
      </details>
    ) : (
      <p class="publication-record-note">
        A suggested citation is withheld until a complete publication date is recorded.
      </p>
    )
  }
  {
    suggestedCitation && (
      <div
        class="publication-actions"
        data-publication-actions
        data-citation={suggestedCitation}
        data-title={title}
        data-url={canonicalPageUrl}
      >
        <p class="publication-action-label">Keep a source-linked reference</p>
        <button type="button" data-copy-citation hidden>Copy citation</button>
        <button type="button" data-copy-link hidden>Copy article link</button>
        <button type="button" data-native-share hidden>Share article</button>
        <p class="publication-action-feedback" role="status" aria-live="polite" data-publication-feedback></p>
        <p class="publication-action-help">
          Copy controls require a supported secure browser. The citation above remains available without JavaScript.
        </p>
      </div>
    )
  }
</aside>

<script>
  // Buttons are enhancement only. The citation remains selectable with JavaScript disabled.
  document.querySelectorAll<HTMLElement>("[data-publication-actions]").forEach((actions) => {
    const citation = actions.dataset.citation;
    const url = actions.dataset.url;
    const title = actions.dataset.title;
    const feedback = actions.querySelector<HTMLElement>("[data-publication-feedback]");
    const copyCitation = actions.querySelector<HTMLButtonElement>("[data-copy-citation]");
    const copyLink = actions.querySelector<HTMLButtonElement>("[data-copy-link]");
    const share = actions.querySelector<HTMLButtonElement>("[data-native-share]");
    const canCopy = typeof navigator.clipboard?.writeText === "function";

    const copy = async (value: string, confirmation: string) => {
      if (!feedback) return;
      try {
        await navigator.clipboard.writeText(value);
        feedback.textContent = confirmation;
      } catch {
        feedback.textContent = "Copy unavailable. Expand ‘Cite this page’ and select the text manually.";
      }
    };

    if (canCopy && citation && copyCitation) {
      copyCitation.hidden = false;
      copyCitation.addEventListener("click", () => void copy(citation, "Citation copied."));
    }
    if (canCopy && url && copyLink) {
      copyLink.hidden = false;
      copyLink.addEventListener("click", () => void copy(url, "Article link copied."));
    }
    if (typeof navigator.share === "function" && url && title && share) {
      share.hidden = false;
      share.addEventListener("click", async () => {
        try {
          await navigator.share({ title, url });
          if (feedback) feedback.textContent = "Share sheet opened.";
        } catch (error) {
          // Canceling the native share sheet is not a failed share.
          if (feedback && !(error instanceof DOMException && error.name === "AbortError")) {
            feedback.textContent = "Sharing unavailable. Use the citation or article link instead.";
          }
        }
      });
    }
  });
</script>

<style>
  .publication-record {
    margin: 1.5rem 0 2rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line, #d9d3c6);
    border-left: 4px solid var(--gold, #b3862c);
    background: var(--paper-muted, #f4f1e8);
  }
  .publication-record .eyebrow {
    margin: 0 0 0.75rem;
  }
  .publication-record dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: 0.8rem 1.25rem;
    margin: 0;
  }
  .publication-record dt {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .publication-record dd {
    margin: 0.18rem 0 0;
    overflow-wrap: anywhere;
  }
  .publication-record p {
    margin: 0.9rem 0 0;
  }
  .publication-record details {
    margin-top: 0.9rem;
  }
  .publication-record summary {
    cursor: pointer;
    font-weight: 700;
  }
  .publication-record-note {
    font-size: 0.92rem;
  }
  .publication-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .publication-action-label,
  .publication-action-feedback,
  .publication-action-help {
    flex-basis: 100%;
    margin: 0;
  }
  .publication-action-label { font-weight: 700; }
  .publication-action-feedback { font-weight: 700; }
  .publication-action-feedback:empty { display: none; }
  .publication-action-help { font-size: 0.83rem; }
  .publication-actions button:not([hidden]) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--navy-700);
    border-radius: 0.3rem;
    background: var(--white);
    color: var(--navy-950);
    font-weight: 700;
    cursor: pointer;
  }
  .publication-actions button:hover { background: var(--gold-light); }
  .publication-actions button:focus-visible { outline: 3px solid var(--gold-ink); outline-offset: 2px; }
  @media print { .publication-actions { display: none; } }
</style>
