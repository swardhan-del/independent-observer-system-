---
export type TimelineEntry = {
  label: string;
  title: string;
  text: string;
};

type Props = { entries: TimelineEntry[] };
const { entries } = Astro.props as Props;
---

<ol class="explainer-timeline" aria-label="Annotated timeline">
  {
    entries.map((entry) => (
      <li>
        <span>{entry.label}</span>
        <h3>{entry.title}</h3>
        <p>{entry.text}</p>
      </li>
    ))
  }
</ol>
