---
import { sitePath } from "../lib/paths";
---

<div
  class="site-search"
  data-site-search
  data-drawer-url={sitePath("/utilities/search/")}
  data-index-url={sitePath("/search-index.json")}
>
  <button
    class="search-trigger"
    type="button"
    data-search-open
    aria-haspopup="dialog"
    aria-controls="site-search-dialog"
  >
    Search <span class="search-shortcut" aria-hidden="true">⌘K</span>
  </button>
  <noscript><a href={sitePath("/library/")}>Browse the Library</a></noscript>
  <p data-drawer-error role="status" hidden></p>
</div>
<script>
  import { mountDrawer } from "../lib/lazy-drawer";
  mountDrawer("search");
</script>
