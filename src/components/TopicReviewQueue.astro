---
import type { ReviewQueueSignal } from "../../plugins/topic-discovery/catalog";

type Props = {
  signals: ReviewQueueSignal[];
  title?: string;
  intro?: string;
};

const {
  signals,
  title = "In development",
  intro = "These projects are not available as completed articles. Their titles describe the planned work; publication dates have not been announced.",
} = Astro.props as Props;
---

{
  signals.length > 0 && (
    <section class="section section-navy topic-review-queue" aria-labelledby="topic-review-title">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Future work</p>
            <h2 id="topic-review-title">{title}</h2>
          </div>
          <p>{intro}</p>
        </div>
        <div class="topic-review-grid">
          {signals.map((signal, index) => (
            <article class="topic-review-card">
              <div class="topic-review-card-topline">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span class="status-pill">
                  {signal.status === "Awaiting human release" ? "In development" : signal.status}
                </span>
              </div>
              <h3>{signal.title}</h3>
              <p class="topic-review-category">{signal.category}</p>
              <p class="topic-review-note">Project outline · not a published article</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
