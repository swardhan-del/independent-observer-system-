---
import type { ReviewQueueSignal } from "../../plugins/topic-discovery/catalog";

type Props = {
  signals: ReviewQueueSignal[];
  title?: string;
};

const { signals, title = "Held for human release" } = Astro.props as Props;
---

{
  signals.length > 0 && (
    <section class="section section-navy topic-review-queue" aria-labelledby="topic-review-title">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Review boundary</p>
            <h2 id="topic-review-title">{title}</h2>
          </div>
          <p>
            These safe metadata signals come from the dated Dropbox review package. The underlying
            drafts remain unlinked and unpublished until the owner closes the human release gate.
          </p>
        </div>
        <div class="topic-review-grid">
          {signals.map((signal, index) => (
            <article class="topic-review-card">
              <div class="topic-review-card-topline">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span class="status-pill">{signal.status}</span>
              </div>
              <h3>{signal.title}</h3>
              <p class="topic-review-category">{signal.category}</p>
              <p>{signal.description}</p>
              <p class="topic-review-note">Metadata only · not a published article</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
