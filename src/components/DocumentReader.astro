---
import type { PublicDocument } from "../data/documents";
import PageHero from "./PageHero.astro";
import { sitePath } from "../lib/paths";

type Props = {
  entry: PublicDocument;
};

const { entry } = Astro.props as Props;
---

<PageHero eyebrow="Public document reader" title={entry.title} description={entry.description} />

<div class="reading-progress" data-reading-progress aria-hidden="true"><span></span></div>

<section class="section section-white">
  <div class="shell reader-layout">
    <aside class="reader-sidebar">
      <p class="eyebrow">Document details</p>
      <dl class="reader-meta">
        <div>
          <dt>Desk</dt>
          <dd>{entry.category}</dd>
        </div>
        <div>
          <dt>Source</dt>
          <dd>{entry.sourceLabel}</dd>
        </div>
        {
          entry.sourceModified && (
            <div>
              <dt>Reviewed</dt>
              <dd>{entry.sourceModified}</dd>
            </div>
          )
        }
      </dl>

      <nav aria-label="Document sections" data-reader-nav>
        <p class="reader-nav-label">On this page</p>
        <ol class="reader-toc">
          {
            entry.sections.map((section, index) => (
              <li>
                <a href={`#${section.id}`} aria-current="false">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {section.heading}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <article class="document-reader">
      <div class="reader-notice">
        This is a reviewed public reading copy. It is not a mirror of the private Dropbox archive.
      </div>
      {
        entry.sections.map((section) => (
          <section class="reader-section" id={section.id}>
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.items && (
              <ul>
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
      <div class="detail-actions">
        <a class="button" href={sitePath("/library/")}>Back to public library →</a>
        <a class="button button-secondary" href={sitePath("/documentaries/")}
          >Explore documentaries</a
        >
      </div>
    </article>
  </div>
</section>

<script>
  const article = document.querySelector<HTMLElement>(".document-reader");
  const progressBar = document.querySelector<HTMLElement>("[data-reading-progress] span");
  const tocLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-reader-nav] .reader-toc a"),
  ];
  const sections = [...document.querySelectorAll<HTMLElement>(".reader-section")];

  if (article && progressBar) {
    const updateProgress = () => {
      const total = article.offsetHeight - window.innerHeight;
      const read = window.scrollY - article.offsetTop + window.innerHeight * 0.4;
      const ratio = total > 0 ? Math.min(1, Math.max(0, read / total)) : 0;
      progressBar.style.width = ratio * 100 + "%";
    };

    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);
    updateProgress();
  }

  if (tocLinks.length && sections.length && typeof IntersectionObserver !== "undefined") {
    const setActive = (id: string) => {
      for (const link of tocLinks) {
        link.setAttribute("aria-current", String(link.getAttribute("href") === `#${id}`));
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: "-15% 0px -70% 0px", threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
