---
import { libraryVolumeGuides } from "../../plugins/library-content/catalog";
import { topicPluginFor, volumeTopicConnections } from "../../plugins/topic-discovery/catalog";
import { seriesItems } from "../data/series";
import { sitePath } from "../lib/paths";
import { slugify } from "../lib/slugs";

const volumeRoles: Record<string, string> = {
  "Volume I": "Observe and document",
  "Volume II": "Locate power and sovereignty",
  "Volume III": "Examine work, taxation, and social citizenship",
  "Volume IV": "Test technological change against human capability",
};
---

<section
  class="section section-white about-volume-atlas"
  id="about-volume-atlas"
  data-about-volume-atlas
  aria-labelledby="about-volume-atlas-title"
>
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The project in four movements</p>
        <h2 id="about-volume-atlas-title">
          Observe. Locate power. Follow the cost. Govern the future.
        </h2>
      </div>
      <p>
        Each volume carries the same independent-observation method into a different layer of public
        life. Select a volume to see what it studies, which research threads belong to it, and where
        the public reading trail continues.
      </p>
    </div>

    <div class="about-volume-atlas-shell">
      <div
        class="about-volume-tabs"
        data-about-volume-tablist
        aria-label="Explore the four volumes"
      >
        {
          seriesItems.map((item, index) => {
            const key = slugify(item.volume);
            const guide = libraryVolumeGuides.find((entry) => entry.volume === item.volume);
            return (
              <a
                class="about-volume-tab"
                id={`about-volume-tab-${key}`}
                href={`#about-volume-panel-${key}`}
                data-about-volume-tab={key}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item.title}</strong>
                <small>{guide?.focus ?? item.category}</small>
              </a>
            );
          })
        }
      </div>

      <div class="about-volume-panels">
        {
          seriesItems.map((item, index) => {
            const key = slugify(item.volume);
            const guide = libraryVolumeGuides.find((entry) => entry.volume === item.volume);
            const connection = volumeTopicConnections[item.volume];
            return (
              <article
                class="about-volume-panel"
                id={`about-volume-panel-${key}`}
                aria-labelledby={`about-volume-title-${key}`}
                data-about-volume-panel={key}
              >
                <div class="about-volume-panel-heading">
                  <div>
                    <p class="eyebrow">
                      {item.volume} · Step {index + 1} of 4
                    </p>
                    <h3 id={`about-volume-title-${key}`}>
                      <a href={sitePath(`/series/${slugify(item.title)}/`)}>{item.title}</a>
                    </h3>
                  </div>
                  <span class="status-pill">{item.status}</span>
                </div>

                <div class="about-volume-panel-intro">
                  <p class="about-volume-throughline">{volumeRoles[item.volume]}.</p>
                  <dl class="about-volume-facts">
                    <div>
                      <dt>Research focus</dt>
                      <dd>{guide?.focus ?? item.category}</dd>
                    </div>
                    <div>
                      <dt>Why it matters</dt>
                      <dd>{guide?.importance}</dd>
                    </div>
                    <div>
                      <dt>Connected lens</dt>
                      <dd>{connection.lens}</dd>
                    </div>
                  </dl>
                  <p>{guide?.summary ?? item.description}</p>
                </div>

                <div class="about-volume-panel-grid">
                  <div>
                    <p class="about-volume-label">Core research ideas</p>
                    <ul class="about-volume-ideas">
                      {guide?.coreIdeas.slice(0, 3).map((idea) => (
                        <li>{idea}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="about-volume-label">Representative research directions</p>
                    <ol class="about-volume-papers">
                      {guide?.researchPapers.slice(0, 3).map((paper, paperIndex) => (
                        <li>
                          <span>
                            Research direction {String(paperIndex + 1).padStart(2, "0")} ·{" "}
                            {paper.lens}
                          </span>
                          <h4>{paper.title}</h4>
                          <p>{paper.description}</p>
                          <p class="about-volume-paper-relevance">
                            <strong>Why it belongs:</strong> {paper.relevance}
                          </p>
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>

                <div class="about-volume-panel-footer">
                  <div>
                    <p class="about-volume-label">Public entry points</p>
                    <div class="about-volume-links">
                      <a href={sitePath(`/series/${slugify(item.title)}/`)}>
                        <span>Series roadmap</span>
                        Open the {item.volume} catalogue file →
                      </a>
                      {connection.contentLinks.map((content) => (
                        <a href={sitePath(content.path)}>
                          <span>{content.kind}</span>
                          {content.label} →
                        </a>
                      ))}
                    </div>
                  </div>
                  <div class="about-volume-topic-links" aria-label={`${item.volume} topic fields`}>
                    {connection.topicSlugs.map((slug) => {
                      const topic = topicPluginFor(slug);
                      return <a href={sitePath(`/topics/${slug}/`)}>{topic.name}</a>;
                    })}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>

    <p class="about-volume-atlas-boundary">
      Representative titles and summaries above identify research directions in development. A
      linked public reading copy, preprint, roadmap, research preview, documentary preview, or video
      preview is labeled by type. Nothing here announces publication approval, peer review, or a
      finished manuscript.
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-about-volume-atlas]").forEach((root) => {
    const tablist = root.querySelector<HTMLElement>("[data-about-volume-tablist]");
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>("[data-about-volume-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-about-volume-panel]")];
    if (!tablist || !tabs.length || tabs.length !== panels.length) return;

    const hashPrefix = "#about-volume-panel-";
    const keyFromHash = () =>
      window.location.hash.startsWith(hashPrefix)
        ? window.location.hash.slice(hashPrefix.length)
        : "";
    const layoutQuery = window.matchMedia("(min-width: 901px)");
    const syncOrientation = () => {
      tablist.setAttribute("aria-orientation", layoutQuery.matches ? "vertical" : "horizontal");
    };

    const activate = (
      key: string,
      options: { updateHash?: boolean; historyMode?: "push" | "replace" } = {},
    ) => {
      const { updateHash = true, historyMode = "replace" } = options;
      tabs.forEach((tab) => {
        const active = tab.dataset.aboutVolumeTab === key;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        tab.classList.toggle("is-selected", active);
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.aboutVolumePanel !== key;
      });
      if (updateHash) {
        const url = new URL(window.location.href);
        url.hash = `about-volume-panel-${key}`;
        if (window.location.hash !== url.hash) {
          const method = historyMode === "push" ? "pushState" : "replaceState";
          history[method](null, "", url);
        }
      }
    };

    tablist.setAttribute("role", "tablist");
    syncOrientation();
    layoutQuery.addEventListener("change", syncOrientation);
    tabs.forEach((tab, index) => {
      const panel = panels[index];
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", panel.id);
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tab.id);
    });
    root.dataset.aboutVolumeEnhanced = "true";
    const requestedKey = keyFromHash();
    const initialKey = tabs.some((tab) => tab.dataset.aboutVolumeTab === requestedKey)
      ? requestedKey
      : (tabs[0].dataset.aboutVolumeTab ?? "volume-i");
    activate(initialKey, { updateHash: false });

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }
        event.preventDefault();
        activate(tab.dataset.aboutVolumeTab ?? "volume-i", { historyMode: "push" });
      });
      tab.addEventListener("keydown", (event) => {
        const key = event.key;
        if (key === " ") {
          event.preventDefault();
          activate(tab.dataset.aboutVolumeTab ?? "volume-i", { historyMode: "push" });
          return;
        }
        if (!["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp", "Home", "End"].includes(key)) {
          return;
        }
        event.preventDefault();
        const nextIndex =
          key === "Home"
            ? 0
            : key === "End"
              ? tabs.length - 1
              : key === "ArrowRight" || key === "ArrowDown"
                ? (index + 1) % tabs.length
                : (index - 1 + tabs.length) % tabs.length;
        const next = tabs[nextIndex];
        next.focus();
        activate(next.dataset.aboutVolumeTab ?? "volume-i");
      });
    });

    const activateFromLocation = () => {
      const key = keyFromHash();
      if (tabs.some((tab) => tab.dataset.aboutVolumeTab === key)) {
        activate(key, { updateHash: false });
      } else {
        activate(tabs[0].dataset.aboutVolumeTab ?? "volume-i", { updateHash: false });
      }
    };
    window.addEventListener("hashchange", activateFromLocation);
    window.addEventListener("popstate", activateFromLocation);
  });
</script>
