---
import { sitePath } from "../lib/paths";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-kicker">The Independent Observer</p>
      <p class="footer-statement">
        A developing independent publication for evidence-led analysis across institutions, history,
        political economy, science, and technology.
      </p>
    </div>
    <div>
      <h2>Explore</h2>
      <a href={sitePath("/series/")}>Series Roadmap</a>
      <a href={sitePath("/research/")}>Research & Essays</a>
      <a href={sitePath("/documentaries/")}>Documentary Projects</a>
      <a href={sitePath("/videos/")}>Videos</a>
    </div>
    <div>
      <h2>Publication</h2>
      <a href={sitePath("/about/")}>About</a>
      <a href={sitePath("/contact/")}>Contact</a>
      <span>Editorial preview · No subscriptions active</span>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} The Independent Observer</span>
    <span>Independent analysis. Transparent status labels. No invented claims.</span>
  </div>
</footer>
