---
import { sitePath } from "../lib/paths";
import { socialLinks } from "../data/social";
import { authorIdentity } from "../data/identity";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-kicker">Independent Observer</p>
      <p class="footer-statement">
        A single-author, four-volume inquiry into evidence, institutions, political economy,
        science, and technology.
      </p>
      <div class="footer-social" aria-label="Social platforms">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              aria-label={link.label}
              rel="me noopener noreferrer"
              target="_blank"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
    <div>
      <h2>Explore</h2>
      <a href={sitePath("/start/")}>Start here</a>
      <a href={sitePath("/latest/")}>Latest research</a>
      <a href={sitePath("/library/")}>Read the library</a>
      <a href={sitePath("/topics/")}>Topics</a>
      <a href={sitePath("/series/")}>Volumes · Publication Catalogue</a>
      <a href={sitePath("/podcast/")}>Watch &amp; listen</a>
      <a href={sitePath("/documentaries/")}>Documentary projects</a>
      <a href={sitePath("/videos/")}>Videos</a>
    </div>
    <div>
      <h2>Publication</h2>
      <a href={sitePath("/join/")}>Join Independent Observer</a>
      <a href={sitePath("/about/")}>About</a>
      <a href={authorIdentity.orcidUrl} target="_blank" rel="me noopener noreferrer">
        Author ORCID · {authorIdentity.orcid}
      </a>
      <a href={sitePath("/contact/")}>Contact</a>
      <a href={sitePath("/governance/")}>Editorial standards &amp; privacy</a>
      <a href={sitePath("/how-to-use-this-site/")}>How to use this site</a>
      <a href={sitePath("/whats-new/")}>Site changelog</a>
      <span>The site is the home base; social channels help people find the work.</span>
      <div class="footer-social" aria-label="Distribution channels">
        {
          socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="me noopener noreferrer">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Independent Observer</span>
    <span>Independent analysis. Transparent status labels. No invented claims.</span>
  </div>
</footer>
