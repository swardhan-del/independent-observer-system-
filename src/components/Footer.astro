---
import { sitePath } from "../lib/paths";
import { socialLinks } from "../data/social";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-kicker">Independent Observer</p>
      <p class="footer-statement">
        The Independent Observer is a connected four-volume inquiry into how public life is made,
        measured, and changed. Volume I establishes the method: how to distinguish evidence,
        institutions, memory, and democratic capacity. Volume II follows that method into
        sovereignty, enforcement, and the unequal distribution of power. Volume III asks who carries
        the cost of work, taxation, and social citizenship. Volume IV tests whether science,
        infrastructure, and artificial intelligence become shared human capability—or deepen
        dependence. Together, the volumes move from observing the frame, to tracing power, to
        measuring its distribution, to asking what futures people can actually govern.
      </p>
      <div class="footer-social" aria-label="Social platforms">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              aria-label={link.label}
              rel="me noopener noreferrer"
              target="_blank"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
    <div>
      <h2>Explore</h2>
      <a href={sitePath("/series/")}>Publication Catalogue</a>
      <a href={sitePath("/library/")}>Public Library</a>
      <a href={sitePath("/whats-new/")}>What’s New</a>
      <a href={sitePath("/research/")}>Research & Essays</a>
      <a href={sitePath("/documentaries/")}>Documentary Projects</a>
      <a href={sitePath("/videos/")}>Videos</a>
      <a href={sitePath("/questions/")}>Questions &amp; Answers</a>
    </div>
    <div>
      <h2>Publication</h2>
      <a href={sitePath("/about/")}>About</a>
      <a href={sitePath("/contact/")}>Contact</a>
      <a href={sitePath("/publication-operating-system/")}>Publication operating system</a>
      <span>The site is the home base; social channels help people find the work.</span>
      <div class="footer-social" aria-label="Distribution channels">
        {
          socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="me noopener noreferrer">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Independent Observer</span>
    <span>Independent analysis. Transparent status labels. No invented claims.</span>
  </div>
</footer>
