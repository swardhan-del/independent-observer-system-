---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceLab from "./EvidenceLab.astro";
import PageHero from "./PageHero.astro";

const title = "Regrowing Humanity — Evidence Lab";
---

<BaseLayout
  title={title}
  description="A bounded, source-led Evidence Lab preview for Regrowing Humanity, in editorial development."
  currentPath="/review/regrowing-humanity/"
  noindex
>
  <PageHero
    eyebrow="Staged research adaptation"
    title={title}
    description="A public evidence map for a research concept in editorial development. It provides sources and limitations without reproducing a complete manuscript or private materials."
    className="document-reader-hero"
  />
  <EvidenceLab />
</BaseLayout>
