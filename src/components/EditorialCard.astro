---
import type { EditorialItem } from "../data/content";

const { item, index = 1 } = Astro.props as { item: EditorialItem; index?: number };
const searchText = [item.title, item.category, item.description, item.status]
  .join(" ")
  .toLocaleLowerCase();
---

<article
  class="editorial-card"
  data-filter-card
  data-search-text={searchText}
  data-status={item.status.toLocaleLowerCase()}
>
  <div class="card-meta">
    <span>{String(index).padStart(2, "0")}</span>
    <span>{item.category}</span>
  </div>
  <h3>{item.title}</h3>
  <p>{item.description}</p>
  <div class="card-footer">
    <span class="status-pill">{item.status}</span>
    {
      item.assetPath && (
        <a class="card-link" href={item.assetPath} target="_blank" rel="noreferrer">
          Open approved file
        </a>
      )
    }
    {item.readingTime && <span>{item.readingTime}</span>}
  </div>
</article>
