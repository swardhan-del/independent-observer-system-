---
import type { EditorialItem } from "../data/content";

type Props = {
  item: EditorialItem;
  index?: number;
  href?: string;
  sectionHref?: string;
};

const { item, index = 1, href, sectionHref } = Astro.props as Props;
const searchText = [item.title, item.category, item.description, item.status]
  .join(" ")
  .toLocaleLowerCase();
const readingId = href ? `route:${href}` : undefined;
---

<article
  class="editorial-card"
  data-filter-card
  data-search-text={searchText}
  data-status={item.status.toLocaleLowerCase()}
>
  {
    Astro.slots.has("image") && (
      <div class="card-image">
        <slot name="image" />
      </div>
    )
  }
  <div class="card-meta">
    <span>{String(index).padStart(2, "0")}</span>
    <span>{item.category}</span>
  </div>
  <h3>
    {
      href ? (
        <a class="card-title-link" href={href}>
          {item.title}
        </a>
      ) : (
        item.title
      )
    }
  </h3>
  <p>{item.description}</p>
  <div class="card-footer">
    <span
      class={`status-pill${item.status === "In editorial development" ? " status-pill--active" : ""}`}
    >
      {item.status}
    </span>
    {item.readingTime && <span>{item.readingTime}</span>}
    {
      href ? (
        <>
          <button
            class="card-save"
            type="button"
            data-reading-toggle
            data-reading-id={readingId}
            data-reading-title={item.title}
            data-reading-href={href}
            aria-pressed="false"
          >
            Save
          </button>
          <a class="card-open-link" href={href}>
            Open preview →
          </a>
        </>
      ) : (
        sectionHref && (
          <a
            class="card-explore-link"
            href={sectionHref}
            aria-label={`View all ${item.category} concepts`}
          >
            View concept →
          </a>
        )
      )
    }
  </div>
</article>
