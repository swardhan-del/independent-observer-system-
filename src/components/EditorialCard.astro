---
import type { EditorialItem } from "../data/content";

const {
  item,
  index = 1,
  sectionHref = "/research/",
} = Astro.props as { item: EditorialItem; index?: number; sectionHref?: string };
const searchText = [item.title, item.category, item.description, item.status]
  .join(" ")
  .toLocaleLowerCase();
---

<article
  class="editorial-card"
  data-filter-card
  data-search-text={searchText}
  data-status={item.status.toLocaleLowerCase()}
>
  {
    Astro.slots.has("image") && (
      <div class="card-image">
        <slot name="image" />
      </div>
    )
  }
  <div class="card-meta">
    <span>{String(index).padStart(2, "0")}</span>
    <span>{item.category}</span>
  </div>
  <h3>{item.title}</h3>
  <p>{item.description}</p>
  <div class="card-footer">
    <span class={`status-pill${item.status === "In editorial development" ? " status-pill--active" : ""}`}
      >{item.status}</span
    >
    {item.readingTime && <span>{item.readingTime}</span>}
    <a class="card-explore-link" href={sectionHref} aria-label={`Explore ${item.category}`}
      >View concept →</a
    >
  </div>
</article>
