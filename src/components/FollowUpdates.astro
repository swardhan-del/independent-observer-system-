---
import { socialLinks } from "../data/social";
import { sitePath } from "../lib/paths";
const { id } = Astro.props;
const updates = socialLinks.find((link) => link.label === "Substack")!;
---

<aside id={id} class="follow-updates" aria-label="Join Independent Observer">
  <p class="eyebrow">The Observer Brief</p>
  <h2>One serious idea. The evidence behind it.</h2>
  <p>
    Join the free Independent Observer reader list for research notes, new-paper alerts, and
    publishing updates. Core public research remains free to read.
  </p>
  <a class="button" href={sitePath("/join/")}>Join free →</a>
  <a href={updates.href} target="_blank" rel="noopener noreferrer">Follow on Substack</a>
  <a href={sitePath("/podcast/feed.xml")}>Get the podcast feed →</a>
  <a href={sitePath("/latest/")}>See the latest research →</a>
</aside>
<style>
  .follow-updates {
    margin-block: 32px;
    padding: 24px;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .follow-updates h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
  }
  .follow-updates a {
    display: inline-block;
    margin: 8px 20px 8px 0;
  }
  .follow-updates a:not(.button) {
    text-decoration: underline;
  }
</style>
