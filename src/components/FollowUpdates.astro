---
import { substackSubscribeUrl } from "../data/social";
import { sitePath } from "../lib/paths";
const { id, compact = false } = Astro.props;
---

<aside id={id} class="follow-updates" aria-label="Join Independent Observer">
  <p class="eyebrow">The Observer Brief</p>
  {
    compact ? (
      <>
        <h2>Get new research by email</h2>
        <p>
          New original investigations, evidence and source notes, important corrections and updates,
          and selected related reading. Free through The Observer Brief.
        </p>
        <a
          class="button"
          href={substackSubscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-email-signup-start={id}
        >
          Subscribe free on Substack ↗
        </a>
      </>
    ) : (
      <>
        <h2>One serious idea. The evidence behind it.</h2>
        <p>
          The free Observer Brief brings you new original investigations, evidence and source notes,
          important corrections and updates, and selected related reading. Core public research
          remains free to read.
        </p>
        <a class="button" href={sitePath("/join/")}>
          Join free →
        </a>
        <a
          href={substackSubscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-email-signup-start={id}
        >
          Subscribe free on Substack ↗
        </a>
        <a href={sitePath("/podcast/feed.xml")}>Get the podcast feed →</a>
        <a href={sitePath("/latest/")}>See the latest research →</a>
      </>
    )
  }
</aside>
<style>
  .follow-updates {
    margin-block: 32px;
    padding: 24px;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .follow-updates h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
  }
  .follow-updates a {
    display: inline-block;
    margin: 8px 20px 8px 0;
  }
  .follow-updates a:not(.button) {
    text-decoration: underline;
  }
</style>
