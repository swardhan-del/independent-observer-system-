---
import { previewGreenPublications, readingTimeMinutes } from "../data/green-publications";
import { sitePath } from "../lib/paths";
const { volume, topic, title = "Articles and research previews" } = Astro.props;
const records = previewGreenPublications.filter(
  (item) => (!volume || item.volume === volume) && (!topic || item.topics.includes(topic)),
);
const recordCount = records.length;
const releasedCount = records.filter((item) => item.productionReleased).length;
const previewCount = recordCount - releasedCount;
const recordDescription = `${releasedCount} released ${releasedCount === 1 ? "article" : "articles"} and ${previewCount} research ${previewCount === 1 ? "preview" : "previews"} available${volume ? ` for ${volume}` : ""}. Previews are drafts; each page identifies its sources and limitations.`;
---

{
  records.length > 0 && (
    <section class="section section-white" aria-labelledby="green-publications-title">
      <div class="shell">
        <div class="section-heading green-publication-shelf-heading">
          <div>
            <p class="eyebrow">Read now · articles and previews</p>
            <h2 id="green-publications-title">{title}</h2>
          </div>
          <p>{recordDescription}</p>
        </div>
        <div class:list={["card-grid", recordCount === 1 && "green-publication-grid-single"]}>
          {records.map((item) => (
            <article class="editorial-card">
              <div class="card-meta">
                <span>{item.volume}</span>
                <span>{item.topics.slice(0, 2).join(" · ")}</span>
              </div>
              <h3>
                <a class="card-title-link" href={sitePath(`/research/${item.slug}/`)}>
                  {item.title}
                </a>
              </h3>
              <p>{item.standfirst}</p>
              <div class="card-footer">
                <span class="status-pill">
                  {item.productionReleased ? "Released article" : "Preview-only article"}
                </span>
                <span>{readingTimeMinutes(item)} min read</span>
                <a class="card-open-link" href={sitePath(`/research/${item.slug}/`)}>
                  {item.productionReleased ? "Read article →" : "Read preview →"}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
