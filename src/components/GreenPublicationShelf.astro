---
import { previewGreenPublications, readingTimeMinutes } from "../data/green-publications";
import ReaderCardContent from "./ReaderCardContent.astro";
import { articleQuestions } from "../data/reader-catalogue";
const { volume, topic, title = "Articles and research previews", mode = "all" } = Astro.props;
const records = previewGreenPublications.filter(
  (item) =>
    (!volume || item.volume === volume) &&
    (!topic || item.topics.includes(topic)) &&
    (mode !== "previews" || !item.productionReleased),
);
const recordCount = records.length;
const releasedCount = records.filter((item) => item.productionReleased).length;
const previewCount = recordCount - releasedCount;
const recordDescription =
  mode === "previews"
    ? `${previewCount} research previews. These are drafts, not released articles; each page identifies its sources and limitations.`
    : `${releasedCount} released ${releasedCount === 1 ? "article" : "articles"} and ${previewCount} article ${previewCount === 1 ? "preview" : "previews"} on this shelf${volume ? ` for ${volume}` : ""}. Article previews are drafts; each page identifies its sources and limitations.`;
---

{
  records.length > 0 && (
    <section class="section section-white" aria-labelledby="green-publications-title">
      <div class="shell">
        <div class="section-heading green-publication-shelf-heading">
          <div>
            <p class="eyebrow">
              {mode === "previews" ? "In development · drafts" : "Read now · articles and previews"}
            </p>
            <h2 id="green-publications-title">{title}</h2>
          </div>
          <p>{recordDescription}</p>
        </div>
        <div class:list={["card-grid", recordCount === 1 && "green-publication-grid-single"]}>
          {records.map((item) => (
            <article class="editorial-card reader-card">
              <ReaderCardContent
                title={item.shortTitle}
                question={articleQuestions[item.slug]}
                description={item.standfirst}
                href={`/research/${item.slug}/`}
                volume={item.volume}
                status={item.productionReleased ? "Released article" : "Preview-only article"}
                minutes={readingTimeMinutes(item)}
                date={item.productionReleased ? item.publicationDate : undefined}
                action={item.productionReleased ? "Read article" : "Read preview"}
              />
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
