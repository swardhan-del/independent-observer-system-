---
import { seriesItems } from "../data/series";
import { sitePath } from "../lib/paths";
import { slugify } from "../lib/slugs";

const bookNotes: Record<string, string> = {
  "Volume I":
    "The foundation of the series: a book about observation, evidence, public memory, and how a conclusion becomes accountable.",
  "Volume II":
    "A study of the power beneath formal democracy—sovereignty, institutions, migration, enforcement, and the arrangements that shape public choice.",
  "Volume III":
    "An inquiry into work, time, taxation, welfare, and social citizenship, asking who carries the cost of economic change.",
  "Volume IV":
    "A capability inquiry into AI, science, infrastructure, intimacy, and the human systems required to make technology usable.",
};

const bookVisuals = {
  "Volume I": {
    src: "/volume-illustrations/volume-i-observation.jpg",
    alt: "Editorial collage of an observation lens, layered records, and linked public nodes.",
  },
  "Volume II": {
    src: "/volume-illustrations/volume-ii-sovereignty.jpg",
    alt: "Editorial collage of civic buildings, map layers, legal pathways, and connected institutions.",
  },
  "Volume III": {
    src: "/volume-illustrations/volume-iii-distribution.jpg",
    alt: "Editorial collage of industrial and service work, a time grid, public infrastructure, and balanced pathways.",
  },
  "Volume IV": {
    src: "/volume-illustrations/volume-iv-capability.jpg",
    alt: "Editorial collage of a human figure connected to laboratory instruments, energy, compute, and care systems.",
  },
} as const;
---

<section class="section section-navy book-roadmap" aria-labelledby="book-roadmap-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Forthcoming book projects</p>
        <h2 id="book-roadmap-title">Four books, one connected inquiry.</h2>
      </div>
      <p>
        These are the planned book titles behind the four-volume project. Each is still in
        development and may change during author and editorial review.
      </p>
    </div>
    <div class="placeholder-notice book-roadmap-boundary">
      Titles are shown for orientation only. There are no Amazon listings, sales links, release
      dates, or publication approvals represented on this page.
    </div>
    <ol class="book-roadmap-grid" aria-label="Four forthcoming Independent Observer books">
      {
        seriesItems.map((item, index) => {
          const visual = bookVisuals[item.volume as keyof typeof bookVisuals];
          return (
            <li class="book-roadmap-card">
              <a class="book-roadmap-image" href={sitePath(`/series/${slugify(item.title)}/`)}>
                <img
                  src={sitePath(visual.src)}
                  alt={visual.alt}
                  width="1100"
                  height="1100"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="book-roadmap-card-copy">
                <div class="book-roadmap-topline">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span>Planned book · not released</span>
                </div>
                <p class="book-roadmap-volume">{item.volume}</p>
                <h3>
                  <a href={sitePath(`/series/${slugify(item.title)}/`)}>{item.title}</a>
                </h3>
                <p>{bookNotes[item.volume]}</p>
                <a class="book-roadmap-link" href={sitePath(`/series/${slugify(item.title)}/`)}>
                  Read the public volume brief →
                </a>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
