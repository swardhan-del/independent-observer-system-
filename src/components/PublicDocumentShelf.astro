---
import type { PublicDocument } from "../data/documents";
import { sitePath } from "../lib/paths";

interface Props {
  entries: PublicDocument[];
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  entries,
  eyebrow = "Public documents",
  title = "Read the reviewed material.",
  description = "These reading copies make approved public-safe material easy to find without opening the private working archive to the web.",
} = Astro.props;
---

<section class="section section-white" aria-labelledby="public-documents-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="public-documents-title">{title}</h2>
      </div>
      <p>{description}</p>
    </div>
    <div class="public-document-shelf" data-public-document-shelf>
      <p
        class="public-document-shelf-status"
        data-public-document-status
        role="status"
        aria-live="polite"
      >
        Showing the first 6 of {entries.length} public records
      </p>
      <div class="card-grid">
        {
          entries.map((entry, index) => (
            <article class="editorial-card" data-public-document-card hidden={index >= 6}>
              <div class="card-meta">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span>{entry.category}</span>
              </div>
              <h3>
                <a class="card-title-link" href={sitePath(`/library/documents/${entry.id}/`)}>
                  {entry.title}
                </a>
              </h3>
              <p>{entry.description}</p>
              <div class="card-footer">
                <span class="status-pill">{entry.status ?? "Reviewed public copy"}</span>
                {entry.metrics && (
                  <span>
                    Archived snapshot: {entry.metrics.downloads ?? "—"} downloads ·{" "}
                    {entry.metrics.abstractViews ?? "—"} views · checked {entry.metrics.checkedAt}
                  </span>
                )}
                <a class="card-open-link" href={sitePath(`/library/documents/${entry.id}/`)}>
                  Read {entry.title} →
                </a>
              </div>
            </article>
          ))
        }
      </div>
      {
        entries.length > 6 && (
          <button type="button" data-public-document-more>
            Show more public records
          </button>
        )
      }
    </div>
  </div>
</section>

<script>
  const shelf = document.querySelector<HTMLElement>("[data-public-document-shelf]");
  if (shelf) {
    const cards = [...shelf.querySelectorAll<HTMLElement>("[data-public-document-card]")];
    const more = shelf.querySelector<HTMLButtonElement>("[data-public-document-more]");
    const status = shelf.querySelector<HTMLElement>("[data-public-document-status]");
    let limit = 6;

    more?.addEventListener("click", () => {
      limit += 6;
      cards.forEach((card, index) => {
        card.hidden = index >= limit;
      });
      const visible = Math.min(limit, cards.length);
      if (status) status.textContent = `Showing ${visible} of ${cards.length} public records`;
      if (more) more.hidden = visible >= cards.length;
    });
  }
</script>

<style>
  .public-document-shelf-status {
    margin: -8px 0 20px;
    color: var(--slate-700);
  }

  [data-public-document-more] {
    display: block;
    margin: 28px auto 0;
  }
</style>
