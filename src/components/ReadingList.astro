---
import { sitePath } from "../lib/paths";
---

<div
  class="reading-list-tools"
  data-reading-list
  data-drawer-url={sitePath(
    `/utilities/reading/${Astro.props.context === "catalogue" ? "catalogue" : "default"}/`,
  )}
>
  <button
    class="reading-list-trigger"
    type="button"
    data-reading-open
    aria-haspopup="dialog"
    aria-controls="reading-list-dialog"
  >
    Reading list <span data-reading-count aria-label="saved items">0</span>
  </button>
  <noscript><a href={sitePath("/library/")}>Browse the Library</a></noscript>
  <p data-drawer-error role="status" hidden></p>
</div>
<script>
  import { mountDrawer } from "../lib/lazy-drawer";
  mountDrawer("reading");
</script>
