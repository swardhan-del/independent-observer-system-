---
import type { PublicDocument } from "../data/documents";
import { authorIdentity } from "../data/identity";
import { scholarlyIdentityFor } from "../data/scholarly-identifiers";

type Props = { entry: PublicDocument };
const { entry } = Astro.props as Props;
const scholarly = scholarlyIdentityFor(entry.id);
const hasRecord = Boolean(scholarly || entry.researchGateUrl || entry.author === authorIdentity.name);
---

{
  hasRecord && (
    <section class="section section-white" aria-labelledby={`scholarly-record-${entry.id}`}>
      <div class="shell prose">
        <p class="eyebrow">Research identity</p>
        <h2 id={`scholarly-record-${entry.id}`}>Underlying scholarly record</h2>
        <p>
          This web page is a reader-facing Independent Observer record. Where a separately distributed
          working paper has a verified scholarly identifier, that identity is shown below so the web
          explanation and the underlying research object are not conflated.
        </p>
        <dl>
          {scholarly?.scholarlyTitle && (
            <>
              <dt>Scholarly title</dt>
              <dd>{scholarly.scholarlyTitle}</dd>
            </>
          )}
          {entry.author && (
            <>
              <dt>Author</dt>
              <dd>{entry.author}</dd>
            </>
          )}
          {entry.author === authorIdentity.name && (
            <>
              <dt>ORCID</dt>
              <dd>
                <a href={authorIdentity.orcidUrl} rel="me">{authorIdentity.orcid}</a>
              </dd>
            </>
          )}
          {scholarly?.doi && (
            <>
              <dt>DOI</dt>
              <dd>
                <a href={`https://doi.org/${scholarly.doi}`}>{scholarly.doi}</a>
              </dd>
            </>
          )}
          {scholarly?.ssrnUrl && (
            <>
              <dt>SSRN</dt>
              <dd>
                <a href={scholarly.ssrnUrl} target="_blank" rel="noopener noreferrer">
                  Abstract {scholarly.ssrnAbstractId} ↗
                </a>
              </dd>
            </>
          )}
          {entry.researchGateUrl && (
            <>
              <dt>ResearchGate</dt>
              <dd>
                <a href={entry.researchGateUrl} target="_blank" rel="noopener noreferrer">
                  Verified paper record ↗
                </a>
              </dd>
            </>
          )}
        </dl>
      </div>
    </section>
  )
}
