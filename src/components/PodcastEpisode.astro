---
import type { HistoryPodcastEpisode } from "../data/podcast";
import { formatPlaybackTime } from "../lib/listening-progress";
import podcastCues from "../data/podcast-cues.json";
import { sitePath } from "../lib/paths";

type Props = {
  episode: HistoryPodcastEpisode;
};

const { episode } = Astro.props as Props;
const transcriptParagraphs = episode.script.split(/\n\s*\n/).filter(Boolean);
const episodeId = `episode-${String(episode.number).padStart(2, "0")}`;
const cues = (podcastCues as Record<string, { starts: number[] }>)[
  episode.audioUrl
    .split("/")
    .pop()!
    .replace(/\.wav$/, "")
];
---

<article
  class="podcast-episode"
  id={episodeId}
  aria-labelledby={`${episodeId}-title`}
  data-podcast-episode={episodeId}
>
  <div class="podcast-episode-topline">
    <span>Episode {String(episode.number).padStart(2, "0")} · {episode.volume}</span>
    <span>{episode.duration}</span>
  </div>
  <h2 id={`${episodeId}-title`}>{episode.title}</h2>
  <p class="podcast-episode-summary">{episode.summary}</p>

  <div class="podcast-player">
    <audio
      controls
      preload="none"
      aria-label={`Listen to episode ${episode.number}: ${episode.title}`}
    >
      <source src={sitePath(episode.audioUrl.replace(/\.wav$/, ".m4a"))} type="audio/mp4" />
      <source src={sitePath(episode.audioUrl)} type="audio/wav" />
      Your browser does not support the embedded audio player. Use the download link below.
    </audio>
    <a
      class="podcast-download"
      href={sitePath(episode.audioUrl.replace(/\.wav$/, ".m4a"))}
      download
    >
      Download audio <span aria-hidden="true">↓</span>
    </a>
  </div>

  <div class="podcast-tools" data-podcast-tools hidden>
    <button type="button" data-podcast-resume hidden>Continue listening</button>
    <button type="button" data-podcast-reset hidden>Forget progress</button>
    <label
      >Playback speed <select
        data-podcast-speed
        aria-label={`Playback speed for episode ${episode.number}`}
      >
        <option value="0.75">0.75×</option><option value="1" selected>1×</option><option
          value="1.25">1.25×</option
        ><option value="1.5">1.5×</option><option value="2">2×</option>
      </select></label
    >
    <span data-podcast-status role="status">Listening progress stays on this device.</span>
  </div>
  <details class="podcast-transcript">
    <summary>Read the full transcript</summary>
    <div class="podcast-transcript-copy">
      <label class="podcast-transcript-search" data-transcript-tools hidden
        >Find in this transcript
        <input
          type="search"
          data-transcript-query
          aria-label={`Find in episode ${episode.number} transcript`}
        />
      </label>
      <p data-transcript-status role="status"></p>
      <p class="podcast-timing-note">Time links jump near the paragraph. Times are approximate.</p>
      {
        transcriptParagraphs.map((paragraph, index) => (
          <div data-transcript-paragraph id={`${episodeId}-paragraph-${index + 1}`}>
            <button
              type="button"
              data-transcript-seek={cues?.starts[index] ?? 0}
              hidden
              aria-label={`Jump near paragraph ${index + 1} at ${formatPlaybackTime(cues?.starts[index] ?? 0)}`}
            >
              ~{formatPlaybackTime(cues?.starts[index] ?? 0)}
            </button>
            <p>{paragraph}</p>
          </div>
        ))
      }
    </div>
  </details>

  <div class="podcast-source-grid">
    <div>
      <p class="podcast-label">Papers in this episode</p>
      <ul class="podcast-source-list">
        {
          episode.sources.map((source) => (
            <li>
              <a href={source.href.startsWith("/") ? sitePath(source.href) : source.href}>
                <strong>{source.title}</strong>
                <span>{source.label} →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <aside class="podcast-boundary">
      <p class="podcast-label">Boundary</p>
      <p>{episode.boundary}</p>
    </aside>
  </div>
</article>

<style>
  .podcast-episode {
    padding: clamp(24px, 4vw, 46px);
    border: 1px solid var(--line);
    background: var(--white);
    box-shadow: 0 18px 42px rgb(4 17 31 / 7%);
  }

  .podcast-episode + .podcast-episode {
    margin-top: 24px;
  }

  .podcast-episode-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    color: var(--gold-ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .podcast-episode h2 {
    max-width: 18ch;
    margin: 14px 0 8px;
    color: var(--navy-950);
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.35rem);
    line-height: 1.03;
  }

  .podcast-episode-summary {
    max-width: 68ch;
    margin: 0;
    color: var(--slate-700);
    font-size: 1.05rem;
  }

  .podcast-player {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 28px;
    padding: 16px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .podcast-player audio {
    width: min(100%, 620px);
    min-width: 0;
  }

  .podcast-download {
    flex-shrink: 0;
    color: var(--gold-ink);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .podcast-download:hover,
  .podcast-download:focus-visible {
    color: var(--navy-900);
    text-decoration: underline;
  }

  .podcast-transcript {
    margin-top: 24px;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .podcast-transcript summary {
    padding: 15px 18px;
    color: var(--navy-900);
    cursor: pointer;
    font-weight: 800;
  }

  .podcast-transcript-copy {
    padding: 0 18px 18px;
    color: var(--slate-700);
  }

  .podcast-transcript-copy p {
    max-width: 76ch;
    margin: 0 0 14px;
  }

  .podcast-transcript-copy p:last-child {
    margin-bottom: 0;
  }

  .podcast-source-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.65fr);
    gap: 28px;
    margin-top: 28px;
  }

  .podcast-label {
    margin: 0 0 10px;
    color: var(--gold-ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .podcast-source-list {
    display: grid;
    gap: 9px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .podcast-source-list a {
    display: grid;
    gap: 3px;
    padding: 12px 14px;
    border-left: 3px solid var(--gold);
    background: var(--paper-warm);
    color: var(--navy-900);
    text-decoration: none;
  }

  .podcast-source-list a:hover,
  .podcast-source-list a:focus-visible {
    background: var(--gold-light);
  }

  .podcast-source-list span {
    color: var(--slate-700);
    font-size: 0.8rem;
  }

  .podcast-boundary {
    padding: 18px;
    border: 1px solid var(--line);
    background: var(--navy-950);
    color: var(--slate-300);
  }

  .podcast-boundary .podcast-label {
    color: var(--gold-light);
  }

  .podcast-boundary p:last-child {
    margin: 0;
  }

  @media (max-width: 720px) {
    .podcast-player,
    .podcast-source-grid {
      grid-template-columns: 1fr;
    }

    .podcast-player {
      display: grid;
    }

    .podcast-player audio {
      width: 100%;
    }

    .podcast-episode-topline {
      display: grid;
      gap: 5px;
    }
  }
</style>

<script>
  import {
    listeningStorageKey,
    readListeningProgress,
    resumablePosition,
    formatPlaybackTime,
  } from "../lib/listening-progress";
  document.querySelectorAll<HTMLElement>("[data-podcast-episode]").forEach((root) => {
    const id = root.dataset.podcastEpisode!;
    const audio = root.querySelector<HTMLAudioElement>("audio")!;
    const resume = root.querySelector<HTMLButtonElement>("[data-podcast-resume]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-podcast-reset]")!;
    const status = root.querySelector<HTMLElement>("[data-podcast-status]")!;
    let saved = 0;
    let started = false;
    let lastSaved = 0;
    const refresh = () => {
      try {
        saved = readListeningProgress(localStorage.getItem(listeningStorageKey))[id]?.position ?? 0;
      } catch {
        status.textContent = "Progress cannot be saved in this browser. Playback still works.";
      }
      resume.hidden = saved < 5;
      reset.hidden = saved < 5;
      resume.textContent = `Continue listening from ${formatPlaybackTime(saved)}`;
    };
    const persist = (forget = false) => {
      if (!started && !forget) return;
      try {
        const all = readListeningProgress(localStorage.getItem(listeningStorageKey));
        const position = resumablePosition(audio.currentTime, audio.duration);
        if (forget || !position) delete all[id];
        else all[id] = { position, updated: Date.now() };
        localStorage.setItem(listeningStorageKey, JSON.stringify(all));
        refresh();
      } catch {
        status.textContent = "Progress could not be saved. Playback still works.";
      }
    };
    const seek = (seconds: number, play: boolean) => {
      const apply = () => {
        audio.currentTime = Math.max(0, Math.min(seconds, Math.max(0, audio.duration - 1)));
        if (play)
          audio.play().catch(() => {
            status.textContent = "Press Play to continue.";
          });
      };
      if (audio.readyState >= 1) apply();
      else {
        audio.addEventListener("loadedmetadata", apply, { once: true });
        audio.load();
      }
    };
    root.querySelector<HTMLElement>("[data-podcast-tools]")!.hidden = false;
    root.querySelector<HTMLElement>("[data-transcript-tools]")!.hidden = false;
    refresh();
    resume.addEventListener("click", () => seek(saved, true));
    reset.addEventListener("click", () => {
      audio.pause();
      seek(0, false);
      persist(true);
      started = false;
      status.textContent = "Saved progress forgotten.";
    });
    audio.addEventListener("play", () => {
      started = true;
      document
        .querySelectorAll<HTMLAudioElement>("[data-podcast-episode] audio")
        .forEach((other) => {
          if (other !== audio) other.pause();
        });
    });
    audio.addEventListener("pause", () => persist());
    audio.addEventListener("ended", () => persist(true));
    audio.addEventListener("timeupdate", () => {
      if (Date.now() - lastSaved > 5000) {
        persist();
        lastSaved = Date.now();
      }
    });
    window.addEventListener("pagehide", () => persist());
    window.addEventListener("storage", (event) => {
      if (event.key === listeningStorageKey) refresh();
    });
    audio.addEventListener("error", () => {
      status.textContent = "Audio could not load. Try the download link or read the transcript.";
    });
    root
      .querySelector<HTMLSelectElement>("[data-podcast-speed]")!
      .addEventListener("change", (event) => {
        const speed = Number((event.target as HTMLSelectElement).value);
        // Loading media for the first seek restores playbackRate from this default.
        audio.defaultPlaybackRate = speed;
        audio.playbackRate = speed;
      });
    root.querySelectorAll<HTMLButtonElement>("[data-transcript-seek]").forEach((button) => {
      button.hidden = false;
      button.addEventListener("click", () => seek(Number(button.dataset.transcriptSeek), true));
    });
    const paragraphs = [...root.querySelectorAll<HTMLElement>("[data-transcript-paragraph]")];
    root
      .querySelector<HTMLInputElement>("[data-transcript-query]")!
      .addEventListener("input", (event) => {
        const query = (event.target as HTMLInputElement).value.trim().toLocaleLowerCase();
        let count = 0;
        for (const paragraph of paragraphs) {
          const matched =
            !query || paragraph.querySelector("p")!.textContent.toLocaleLowerCase().includes(query);
          paragraph.hidden = !matched;
          if (matched) count++;
        }
        root.querySelector<HTMLElement>("[data-transcript-status]")!.textContent = query
          ? `${count} matching paragraphs.`
          : "";
      });
  });
</script>
<style>
  .podcast-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-block: 16px;
  }
  .podcast-tools[hidden] {
    display: none;
  }
  .podcast-tools button,
  .podcast-tools select,
  [data-transcript-seek] {
    min-height: 44px;
    padding: 8px 12px;
    color: var(--navy-950);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .podcast-transcript-search {
    display: grid;
    gap: 8px;
    padding-block: 14px;
  }
  .podcast-transcript-search[hidden] {
    display: none;
  }
  .podcast-transcript-search input {
    width: 100%;
    padding: 12px;
  }
  [data-transcript-paragraph] {
    margin-top: 18px;
  }
  .podcast-timing-note {
    font-size: 0.9rem;
  }
</style>
