---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceExplorer from "./EvidenceExplorer.astro";
import {
  greenPublicationById,
  greenPublicationByFamilyId,
  greenPublicationBySlug,
} from "../data/green-publications";
import type { GreenPublication } from "../data/green-publications";
import type { CuratedPublication } from "../data/curated-publications";
import { publicSitePath, sitePath } from "../lib/paths";

const { publication } = Astro.props as { publication: GreenPublication | CuratedPublication };
const currentPath = `/research/${publication.slug}/`;
const wordCount = publication.paragraphs.join(" ").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const related = publication.relatedPublicationIds
  .map((id) => greenPublicationByFamilyId.get(id) ?? greenPublicationById.get(id))
  .filter((item): item is GreenPublication => Boolean(item))
  .filter((item) => greenPublicationBySlug.has(item.slug));
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: publication.title,
  author: { "@type": "Person", name: publication.author },
  datePublished: publication.publicationDate,
  dateModified: publication.lastReviewedDate,
  version: publication.version,
  isAccessibleForFree: true,
  license: publication.license,
  url: new URL(publicSitePath(currentPath), Astro.site ?? Astro.url.origin).href,
}).replace(/</g, "\\u003c");
const evidence = "evidence" in publication ? publication.evidence : [];
const adaptationNote = "adaptationNote" in publication ? publication.adaptationNote : undefined;
---

<BaseLayout
  title={publication.shortTitle}
  description={publication.standfirst}
  currentPath={currentPath}
  noindex={!publication.productionReleased}
>
  <script type="application/ld+json" set:html={schema} is:inline />
  <article
    class="section section-white research-article"
    data-candidate-id={publication.candidateId}
  >
    <div class="shell article-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={sitePath("/research/")}>Research &amp; Essays</a><span aria-hidden="true">/</span
        ><span>{publication.shortTitle}</span>
      </nav>
      <div class="article-status" role="status">
        {
          publication.productionReleased
            ? "Published article"
            : "Source-audited preview · formal release pending"
        }
      </div>
      <header class="article-header">
        <p class="eyebrow">{publication.volume} · {publication.publicationType}</p>
        <h1>{publication.title}</h1>
        <p class="article-standfirst">{publication.standfirst}</p>
        <p class="article-byline">By {publication.author} · {readingMinutes} min read</p>
        <details class="article-version">
          <summary>About this version</summary>
          <p>
            {publication.status} · {
              publication.productionReleased ? "Public reference version" : "Publication pending"
            }
          </p>
          <p>
            Version {publication.version} · Factual cutoff {publication.factualCutoffDate} · reviewed
            {publication.lastReviewedDate}
          </p>
          <p>{publication.topics.join(" · ")}</p>
          {adaptationNote && <p>{adaptationNote}</p>}
        </details>
      </header>
      <div class="article-body prose">
        {publication.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {evidence.length > 0 && <EvidenceExplorer evidence={evidence} />}
        <section aria-labelledby="article-sources">
          <h2 id="article-sources">Sources and notes</h2>
          <ul>
            {
              publication.sourceNotes.map((source) => (
                <li>
                  <a href={source.href} target="_blank" rel="noopener noreferrer">
                    {source.label} ↗
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
        <section aria-labelledby="article-limitations">
          <h2 id="article-limitations">Limitations</h2>
          <p>{publication.limitations}</p>
        </section>
        <section aria-labelledby="article-disclosures">
          <h2 id="article-disclosures">Disclosure</h2>
          <p>
            This preview does not provide a funding statement, a conflict-of-interest declaration or
            an account of AI use. Absence of these disclosures is not a declaration that there was
            no funding, conflict or AI involvement. Corrections can be sent through the <a
              href={sitePath("/contact/")}>contact page</a
            >.
          </p>
        </section>
      </div>
      {
        related.length > 0 && (
          <aside class="article-related" aria-labelledby="article-related-title">
            <>
              <h2 id="article-related-title">Continue reading</h2>
              <ul>
                {related.map((item) => (
                  <li>
                    <a href={sitePath(`/research/${item.slug}/`)}>{item.title}</a>
                    <span>{item.volume}</span>
                  </li>
                ))}
              </ul>
            </>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  // Preserve provenance in print, then restore the reader's disclosure state.
  const versionDetails = document.querySelector<HTMLDetailsElement>(".article-version");
  let wasOpen = false;
  window.addEventListener("beforeprint", () => {
    if (!versionDetails) return;
    wasOpen = versionDetails.open;
    versionDetails.open = true;
  });
  window.addEventListener("afterprint", () => {
    if (versionDetails) versionDetails.open = wasOpen;
  });
</script>