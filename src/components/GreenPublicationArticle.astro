---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  greenPublicationById,
  greenPublicationByFamilyId,
  greenPublicationBySlug,
  readingTimeMinutes,
} from "../data/green-publications";
import type { GreenPublication } from "../data/green-publications";
import { publicSitePath, sitePath } from "../lib/paths";
import PublicationRecord from "./PublicationRecord.astro";
import FollowUpdates from "./FollowUpdates.astro";
import { aiReadingCollection } from "../data/reading-collections";

const { publication } = Astro.props as { publication: GreenPublication };
const currentPath = `/research/${publication.slug}/`;
const collectionMember = aiReadingCollection.slugs.includes(publication.slug);
const headings = publication.sectionHeadings ?? [];
const revisions = publication.revisionNotes ?? [];
const related = publication.relatedPublicationIds
  .map((id) => greenPublicationByFamilyId.get(id) ?? greenPublicationById.get(id))
  .filter((item): item is GreenPublication => Boolean(item))
  .filter((item) => greenPublicationBySlug.has(item.slug));
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: publication.title,
  description: publication.standfirst,
  articleSection: publication.editorialType ?? "Analysis",
  author: {
    "@type": "Person",
    name: publication.author,
    url: new URL(publicSitePath("/about/"), Astro.site ?? Astro.url.origin).href,
  },
  publisher: { "@type": "Organization", name: "Independent Observer" },
  citation: publication.sourceNotes.map((source) => source.href),
  inLanguage: "en",
  ...(publication.productionReleased ? { datePublished: publication.publicationDate } : {}),
  dateModified: publication.lastReviewedDate,
  version: publication.version,
  isAccessibleForFree: true,
  license: publication.license,
  url: new URL(publicSitePath(currentPath), Astro.site ?? Astro.url.origin).href,
}).replace(/</g, "\\u003c");
---

<BaseLayout
  title={publication.shortTitle}
  description={publication.standfirst}
  currentPath={currentPath}
  noindex={!publication.productionReleased}
  ogType="article"
>
  <script type="application/ld+json" set:html={schema} is:inline />
  <article
    class="section section-white research-article"
    data-candidate-id={publication.candidateId}
  >
    <div class="shell article-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={sitePath("/research/")}>Research &amp; Essays</a><span aria-hidden="true">/</span
        ><span>{publication.shortTitle}</span>
      </nav>
      <div class="article-status" role="status">
        {
          publication.productionReleased
            ? "Published article"
            : "Concept preview · publication pending"
        }
      </div>
      <header class="article-header">
        <p class="eyebrow">{publication.volume} · {publication.editorialType ?? "Analysis"}</p>
        <h1>{publication.title}</h1>
        <p class="article-standfirst">{publication.standfirst}</p>
        <p class="article-byline">
          By <a href={sitePath("/about/")}>{publication.author}</a> · {
            readingTimeMinutes(publication)
          } min read
        </p>
        {
          publication.productionReleased && (
            <p class="article-dates">
              Published{" "}
              <time datetime={publication.publicationDate}>{publication.publicationDate}</time> ·
              Last reviewed{" "}
              <time datetime={publication.lastReviewedDate}>{publication.lastReviewedDate}</time>
            </p>
          )
        }
        <details class="article-version">
          <summary>About this version</summary>
          <p>
            {publication.status} · {
              publication.productionReleased ? "Public reference version" : "Publication pending"
            }
          </p>
          <p>
            Version {publication.version} · Factual cutoff {publication.factualCutoffDate} · reviewed
            {publication.lastReviewedDate}
          </p>
          <p>{publication.topics.join(" · ")}</p>
        </details>
      </header>
      <PublicationRecord
        title={publication.title}
        author={publication.author}
        status={publication.status}
        publicationDate={publication.productionReleased ? publication.publicationDate : undefined}
        lastReviewedDate={publication.lastReviewedDate}
        version={publication.version}
        revisionCount={revisions.length}
        revisionHistoryHref={revisions.length ? "#revision-history" : undefined}
        reuseNotice={publication.license}
      />
      {
        headings.length > 0 && (
          <nav class="article-contents" aria-label="On this page">
            <>
              <h2>On this page</h2>
              <ul>
                {headings.map((heading) => (
                  <li>
                    <a href={`#${heading.id}`}>{heading.title}</a>
                  </li>
                ))}
                <li>
                  <a href="#article-sources">Sources and notes</a>
                </li>
              </ul>
            </>
          </nav>
        )
      }
      <div class="article-body prose">
        {
          publication.paragraphs.map((paragraph, index) => (
            <>
              {headings
                .filter((heading) => heading.beforeParagraph === index)
                .map((heading) => (
                  <h2 id={heading.id}>{heading.title}</h2>
                ))}
              <p id={`paragraph-${index + 1}`}>
                {paragraph}
                {(
                  publication.citations?.find((citation) => citation.paragraph === index)
                    ?.sources ?? []
                ).map((sourceIndex) => (
                  <>
                    {" "}
                    <a
                      class="article-citation"
                      href={`#source-${sourceIndex + 1}`}
                      aria-label={`Source ${sourceIndex + 1} for paragraph ${index + 1}`}
                    >
                      [{sourceIndex + 1}]
                    </a>
                  </>
                ))}
              </p>
            </>
          ))
        }
        <section aria-labelledby="article-sources">
          <h2 id="article-sources">Sources and notes</h2>
          <ol>
            {
              publication.sourceNotes.map((source, sourceIndex) => (
                <li id={`source-${sourceIndex + 1}`}>
                  <a href={source.href} target="_blank" rel="noopener noreferrer">
                    {source.label} ↗
                  </a>
                  {(publication.citations ?? [])
                    .filter((citation) => citation.sources.includes(sourceIndex))
                    .map((citation) => (
                      <>
                        {" "}
                        <a class="source-return" href={`#paragraph-${citation.paragraph + 1}`}>
                          Back to paragraph {citation.paragraph + 1} ↑
                        </a>
                      </>
                    ))}
                </li>
              ))
            }
          </ol>
        </section>
        <section aria-labelledby="article-limitations">
          <h2 id="article-limitations">Limitations</h2>
          <p>{publication.limitations}</p>
        </section>
        <section aria-labelledby="article-disclosures">
          <h2 id="article-disclosures">Disclosure</h2>
          <p>
            {
              publication.adaptationDisclosure ?? (
                <>
                  This article does not provide a funding statement, a conflict-of-interest
                  declaration or an account of AI use. Absence of these disclosures is not a
                  declaration that there was no funding, conflict or AI involvement.
                </>
              )
            } Corrections can be sent through the <a href={sitePath("/contact/")}>contact page</a>.
          </p>
        </section>
        {
          revisions.length > 0 && (
            <section aria-labelledby="revision-history">
              <>
                <h2 id="revision-history">Edition history</h2>
                <ol>
                  {revisions.map((revision) => (
                    <li>
                      <time datetime={revision.date}>{revision.date}</time>
                      <p>{revision.change}</p>
                    </li>
                  ))}
                </ol>
              </>
            </section>
          )
        }
      </div>
      {
        related.length > 0 && (
          <aside class="article-related" aria-labelledby="article-related-title">
            <>
              <h2 id="article-related-title">Continue reading</h2>
              <ul>
                {related.map((item) => (
                  <li>
                    <a href={sitePath(`/research/${item.slug}/`)}>{item.title}</a>
                    <span>
                      {item.productionReleased ? "Published article" : "Research preview"} ·{" "}
                      {item.volume}
                    </span>
                  </li>
                ))}
              </ul>
            </>
          </aside>
        )
      }
      {
        collectionMember && (
          <p class="article-collection">
            <a href={sitePath(aiReadingCollection.route)}>
              Explore the AI, work and infrastructure collection →
            </a>
          </p>
        )
      }
      <FollowUpdates id="article-follow-updates" />
    </div>
  </article>
</BaseLayout>

<script>
  // Preserve provenance in print, then restore the reader's disclosure state.
  const versionDetails = document.querySelector<HTMLDetailsElement>(".article-version");
  let wasOpen = false;
  window.addEventListener("beforeprint", () => {
    if (!versionDetails) return;
    wasOpen = versionDetails.open;
    versionDetails.open = true;
  });
  window.addEventListener("afterprint", () => {
    if (versionDetails) versionDetails.open = wasOpen;
  });
</script>

<style>
  .article-shell {
    max-width: 780px;
  }
  .article-header h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.12;
    overflow-wrap: anywhere;
  }
  .article-standfirst {
    font-size: 1.2rem;
    line-height: 1.65;
  }
  .article-body {
    font-size: 1.08rem;
    line-height: 1.8;
  }
  .article-body p,
  .article-body li {
    overflow-wrap: anywhere;
  }
  .article-body h2 {
    margin-top: 2.2rem;
    line-height: 1.3;
  }
  .article-status {
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .article-dates,
  .article-byline {
    line-height: 1.7;
  }
  .article-contents {
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    margin-block: 1.5rem;
  }
  .article-contents h2 {
    font-size: 1.1rem;
    margin-top: 0;
  }
  .article-contents ul {
    padding-left: 1.25rem;
  }
  .article-contents li {
    margin-block: 0.6rem;
  }
  .article-citation {
    white-space: nowrap;
    font-weight: 700;
  }
  .source-return {
    display: inline-block;
    font-size: 0.9rem;
  }
  .article-related li {
    margin-block: 1rem;
  }
  .article-related span {
    display: block;
    font-size: 0.9rem;
  }
  .article-body :target {
    outline: 2px solid var(--gold);
    outline-offset: 6px;
  }
  @media print {
    .article-contents,
    .article-collection,
    :global(.follow-updates) {
      display: none;
    }
  }
</style>
