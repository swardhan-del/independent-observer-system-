<script>
  document.querySelector<HTMLAnchorElement>(".skip-link")?.addEventListener("click", () => {
    document.getElementById("main-content")?.focus();
  });
  const masthead = document.querySelector<HTMLElement>(".site-header");
  if (masthead) {
    const measure = () =>
      document.documentElement.style.setProperty(
        "--site-header-offset",
        `${Math.ceil(masthead.getBoundingClientRect().height) + 20}px`,
      );
    measure();
    if ("ResizeObserver" in window) new ResizeObserver(measure).observe(masthead);
    const revealTarget = () => {
      let id = "";
      try {
        id = decodeURIComponent(window.location.hash.slice(1));
      } catch {
        return;
      }
      const target = document.getElementById(id);
      // Reading-copy sections need a deterministic anchor landing on mobile,
      // including the sources appendix at the end of long articles.
      const readingCopyTarget = Boolean(target?.closest(".reading-copy"));
      if (
        target &&
        (readingCopyTarget ||
          target.matches(
            "#reading-journeys, #justice-to-capacity, .journey, .podcast-episode, [data-transcript-paragraph], [data-reader-section], .reader-references li[id]",
          ))
      ) {
        requestAnimationFrame(() => target.scrollIntoView({ block: "start", behavior: "instant" }));
      }
    };
    revealTarget();
    window.addEventListener("hashchange", revealTarget);
  }
</script>
<style is:global>
  #reading-journeys,
  #justice-to-capacity,
  .journey,
  .podcast-episode,
  [data-transcript-paragraph] {
    scroll-margin-top: var(--site-header-offset, 240px);
  }
  .site-header.sticky-header.scrolled {
    background-color: var(--navy-950);
  }
</style>
