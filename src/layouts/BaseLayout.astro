---
import AnchorOffset from "../components/AnchorOffset.astro";
import AmbientSoundControl from "../components/AmbientSoundControl.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReadingList from "../components/ReadingList.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "../styles/global.css";
import { publicSitePath, sitePath } from "../lib/paths";
import { seriesItems } from "../data/series";
import { slugify } from "../lib/slugs";
import { citationDate } from "../lib/citations";
import { socialLinks } from "../data/social";

type Props = {
  title: string;
  description: string;
  currentPath?: string;
  noindex?: boolean;
  canonicalPath?: string;
  articleMetadata?: {
    title?: string;
    author: string;
    publicationDate?: string;
    status?: string;
    sameAs?: string;
    fingerprintSha256?: string;
    rightsNotice?: string;
    dateModified?: string;
    keywords?: string[];
  };
};

const {
  title,
  description,
  currentPath = "/",
  noindex = false,
  canonicalPath = currentPath,
  articleMetadata,
} = Astro.props;
const fallbackBuild = import.meta.env.PUBLIC_FALLBACK_BUILD === "true";
const previewBuild = process.env.VERCEL_ENV === "preview";
const shouldNoindex = noindex || fallbackBuild || previewBuild;
const fullTitle =
  currentPath === "/library/documents/who-deported-more/"
    ? title
    : title === "Home"
      ? "Independent Observer"
      : `${title} | Independent Observer`;
const publicOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(publicSitePath(canonicalPath), publicOrigin).href;
const websiteUrl = new URL(publicSitePath("/"), publicOrigin).href;
const socialImageUrl = new URL(publicSitePath("/og-cover.jpg"), publicOrigin).href;
const sitemapUrl = new URL(publicSitePath("/sitemap.xml"), publicOrigin).href;
const breadcrumbItems =
  currentPath === "/"
    ? []
    : [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: websiteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: title,
          item: canonicalUrl,
        },
      ];
const publicationDateIso = citationDate(articleMetadata?.publicationDate);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Person", "@id": `${websiteUrl}#author`, name: "Siddhartha Harsh Wardhan" },
    {
      "@type": "CreativeWorkSeries",
      "@id": `${websiteUrl}#volumes`,
      name: "Independent Observer: four-volume series",
      hasPart: seriesItems.map((item) => ({
        "@type": "CreativeWork",
        name: `${item.volume}: ${item.title}`,
        url: new URL(publicSitePath(`/series/${slugify(item.title)}/`), publicOrigin).href,
        author: { "@id": `${websiteUrl}#author` },
        creativeWorkStatus: item.status,
      })),
      url: new URL(publicSitePath("/series/"), publicOrigin).href,
      author: { "@id": `${websiteUrl}#author` },
      publisher: { "@id": `${websiteUrl}#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${websiteUrl}#organization`,
      name: "Independent Observer",
      url: websiteUrl,
      logo: {
        "@type": "ImageObject",
        url: new URL(publicSitePath("/favicon.svg"), publicOrigin).href,
      },
      creator: { "@id": `${websiteUrl}#author` },
      sameAs: socialLinks.map((socialLink) => socialLink.href),
    },
    {
      "@type": "WebSite",
      "@id": `${websiteUrl}#website`,
      url: websiteUrl,
      name: "Independent Observer",
      description:
        "An independent media and research project examining power, institutions, history, political economy, science, and technology.",
      inLanguage: "en",
      creator: { "@id": `${websiteUrl}#author` },
      publisher: { "@id": `${websiteUrl}#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: fullTitle,
      description,
      isPartOf: { "@id": `${websiteUrl}#website` },
      inLanguage: "en",
    },
    ...(breadcrumbItems.length > 0
      ? [
          {
            "@type": "BreadcrumbList",
            "@id": `${canonicalUrl}#breadcrumb`,
            itemListElement: breadcrumbItems,
          },
        ]
      : []),
    ...(articleMetadata
      ? [
          {
            "@type": "ScholarlyArticle",
            "@id": `${canonicalUrl}#article`,
            url: canonicalUrl,
            headline: articleMetadata.title ?? title,
            description,
            author:
              articleMetadata.author === "Siddhartha Harsh Wardhan"
                ? { "@id": `${websiteUrl}#author` }
                : { "@type": "Person", name: articleMetadata.author },
            mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
            ...(articleMetadata.dateModified ? { dateModified: articleMetadata.dateModified } : {}),
            ...(articleMetadata.keywords ? { keywords: articleMetadata.keywords } : {}),
            publisher: { "@id": `${websiteUrl}#organization` },
            inLanguage: "en",
            isAccessibleForFree: true,
            ...(publicationDateIso ? { datePublished: publicationDateIso } : {}),
            ...(articleMetadata.status ? { creativeWorkStatus: articleMetadata.status } : {}),
            ...(articleMetadata.sameAs ? { sameAs: articleMetadata.sameAs } : {}),
            ...(articleMetadata.fingerprintSha256
              ? { identifier: `urn:sha256:${articleMetadata.fingerprintSha256}` }
              : {}),
            ...(articleMetadata.rightsNotice
              ? { copyrightNotice: articleMetadata.rightsNotice }
              : {}),
          },
        ]
      : []),
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    {
      currentPath === "/" && (
        <meta
          name="google-site-verification"
          content="h9n2JK0QDIRl9KrBpQMYsy-OECkmR3D5fkCBKdGLLW8"
        />
      )
    }
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="independent media, political economy, institutional power, documentary research, long-form journalism, history, science, technology, law, accountability, public reason"
    />
    <meta name="author" content="Independent Observer" />
    {articleMetadata && <meta name="citation_title" content={articleMetadata.title ?? title} />}
    {articleMetadata && <meta name="citation_author" content={articleMetadata.author} />}
    {publicationDateIso && <meta name="citation_publication_date" content={publicationDateIso} />}
    <meta name="theme-color" content="#07182d" />
    {shouldNoindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Independent Observer feed"
      href={new URL(publicSitePath("/feed.xml"), publicOrigin).href}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Independent Observer release feed"
      href={new URL(publicSitePath("/feed.atom.xml"), publicOrigin).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:site_name" content="Independent Observer" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Independent Observer social preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@IndpObserver" />
    <meta name="twitter:creator" content="@IndpObserver" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Independent Observer social preview" />
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <script type="application/ld+json" set:html={structuredData} is:inline />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header currentPath={currentPath} />
    {
      currentPath !== "/" && (
        <div class="shell reader-toolbar">
          <AmbientSoundControl />
          {currentPath === "/series/" ? <ReadingList context="catalogue" /> : <ReadingList />}
        </div>
      )
    }
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {
      currentPath === "/" && (
        <div class="shell reader-toolbar" aria-label="Optional reading tools">
          <AmbientSoundControl />
          <ReadingList />
        </div>
      )
    }
    <Footer />
    <AnchorOffset />
    <script is:inline>
      (function () {
        var header = document.querySelector(".site-header");
        if (!header) return;
        function onScroll() {
          if (window.scrollY > 10) {
            header.classList.add("scrolled");
          } else {
            header.classList.remove("scrolled");
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>
