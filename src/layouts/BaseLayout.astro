---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { sitePath } from "../lib/paths";

type Props = {
  title: string;
  description: string;
  currentPath?: string;
  noindex?: boolean;
};

const { title, description, currentPath = "/", noindex = false } = Astro.props;
const fullTitle =
  title === "Home" ? "The Independent Observer" : `${title} | The Independent Observer`;
const publicOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(sitePath(currentPath), publicOrigin).href;
const websiteUrl = new URL(sitePath("/"), publicOrigin).href;
const socialImageUrl = new URL(sitePath("/og-cover.jpg"), publicOrigin).href;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${websiteUrl}#website`,
      url: websiteUrl,
      name: "The Independent Observer",
      description:
        "An independent media and research project examining power, institutions, history, political economy, science, and technology.",
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: fullTitle,
      description,
      isPartOf: { "@id": `${websiteUrl}#website` },
      inLanguage: "en",
    },
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07182d" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="The Independent Observer" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Independent Observer social preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="The Independent Observer social preview" />
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <script type="application/ld+json" set:html={structuredData} is:inline />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
