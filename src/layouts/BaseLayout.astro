---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReadingList from "../components/ReadingList.astro";
import "../styles/global.css";
import { sitePath } from "../lib/paths";
import { socialLinks } from "../data/social";

type Props = {
  title: string;
  description: string;
  currentPath?: string;
  noindex?: boolean;
  canonicalPath?: string;
};

const {
  title,
  description,
  currentPath = "/",
  noindex = false,
  canonicalPath = currentPath,
} = Astro.props;
const fallbackBuild = import.meta.env.PUBLIC_FALLBACK_BUILD === "true";
const previewBuild = process.env.VERCEL_ENV === "preview";
const shouldNoindex = noindex || fallbackBuild || previewBuild;
const fullTitle = title === "Home" ? "Independent Observer" : `${title} | Independent Observer`;
const publicOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(sitePath(canonicalPath), publicOrigin).href;
const websiteUrl = new URL(sitePath("/"), publicOrigin).href;
const socialImageUrl = new URL(sitePath("/og-cover.jpg"), publicOrigin).href;
const sitemapUrl = new URL(sitePath("/sitemap.xml"), publicOrigin).href;
const breadcrumbItems =
  currentPath === "/"
    ? []
    : [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: websiteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: title,
          item: canonicalUrl,
        },
      ];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${websiteUrl}#organization`,
      name: "Independent Observer",
      url: websiteUrl,
      logo: {
        "@type": "ImageObject",
        url: new URL(sitePath("/favicon.svg"), publicOrigin).href,
      },
      sameAs: socialLinks.map((socialLink) => socialLink.href),
    },
    {
      "@type": "WebSite",
      "@id": `${websiteUrl}#website`,
      url: websiteUrl,
      name: "Independent Observer",
      description:
        "An independent media and research project examining power, institutions, history, political economy, science, and technology.",
      inLanguage: "en",
      publisher: { "@id": `${websiteUrl}#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: fullTitle,
      description,
      isPartOf: { "@id": `${websiteUrl}#website` },
      inLanguage: "en",
    },
    ...(breadcrumbItems.length > 0
      ? [
          {
            "@type": "BreadcrumbList",
            "@id": `${canonicalUrl}#breadcrumb`,
            itemListElement: breadcrumbItems,
          },
        ]
      : []),
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="independent media, political economy, institutional power, documentary research, long-form journalism, history, science, technology, law, accountability, public reason"
    />
    <meta name="author" content="Independent Observer" />
    <meta name="theme-color" content="#07182d" />
    {shouldNoindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Independent Observer feed"
      href={new URL(sitePath("/feed.xml"), publicOrigin).href}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Independent Observer release feed"
      href={new URL(sitePath("/feed.atom.xml"), publicOrigin).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:site_name" content="Independent Observer" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Independent Observer social preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@IndpObserver" />
    <meta name="twitter:creator" content="@IndpObserver" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Independent Observer social preview" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <script type="application/ld+json" set:html={structuredData} is:inline />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header currentPath={currentPath} />
    <ReadingList />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var header = document.querySelector(".site-header");
        if (!header) return;
        function onScroll() {
          if (window.scrollY > 10) {
            header.classList.add("scrolled");
          } else {
            header.classList.remove("scrolled");
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>
