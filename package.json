{
  "name": "independent-observer-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:pages": "SITE_URL=https://swardhan-del.github.io BASE_PATH=/independent-observer-system- astro check && SITE_URL=https://swardhan-del.github.io BASE_PATH=/independent-observer-system- astro build",
    "preview": "astro preview",
    "lint": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "astro check && astro build && vitest run",
    "test:built": "vitest run",
    "seo:audit": "node plugins/seo/seo-audit.mjs",
    "domain:preflight": "node plugins/hosting/custom-domain-preflight.mjs",
    "security:provenance": "node scripts/security/check-production-provenance.mjs",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:dependency-review": "node scripts/security/check-dependency-lock.mjs && npm audit --audit-level=high",
    "security:static-analysis": "node scripts/security/static-analysis.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.0.0",
    "astro": "^7.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
